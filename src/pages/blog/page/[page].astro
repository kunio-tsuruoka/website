---
import BlogListing from '../../../components/blog/blog-listing.astro';
import { Header } from '../../../components/header';
import JsonLd from '../../../components/seo/json-ld.astro';
import { PageHero } from '../../../components/ui/page-hero';
import Layout from '../../../layouts/layout.astro';
import {
  BLOGS_PER_PAGE,
  type Blog,
  type MicroCMSEnv,
  type PaginatedBlogs,
  getBlogsPage,
} from '../../../lib/microcms';

export const prerender = false;

const runtime = (Astro.locals as { runtime?: { env?: MicroCMSEnv } }).runtime;
const env = runtime?.env;
const pageParam = Astro.params.page || '';
const currentPage = Number(pageParam);

if (!Number.isInteger(currentPage) || currentPage < 1) {
  return Astro.redirect('/404');
}

if (currentPage === 1) {
  return Astro.redirect('/blog', 301);
}

let blogs: Blog[] = [];
let pagination: PaginatedBlogs = {
  contents: [],
  totalCount: 0,
  currentPage,
  totalPages: 1,
  limit: BLOGS_PER_PAGE,
  offset: (currentPage - 1) * BLOGS_PER_PAGE,
  hasPrevPage: currentPage > 1,
  hasNextPage: false,
};
let apiError = false;

try {
  pagination = await getBlogsPage(currentPage, BLOGS_PER_PAGE, env);
  blogs = pagination.contents;
} catch (error) {
  console.error(`Failed to load blog page ${currentPage}:`, error);
  apiError = true;
}

if (!apiError && currentPage > pagination.totalPages) {
  return Astro.redirect('/404');
}

function stripContent(value?: string): string {
  if (!value) return '';
  return value
    .replace(/<[^>]*>/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[#*_`>]+/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

function getBlogBody(blog: Blog): string {
  return blog.content || blog.body || '';
}

function getExcerpt(blog: Blog): string {
  const text = blog.description || stripContent(getBlogBody(blog));
  return text.length > 120 ? `${text.slice(0, 120)}...` : text;
}

const pageDescription =
  '株式会社Beekleのブログ。開発、AI、自社プロダクト、経営、日々の試行錯誤について、コラムとは別に雑記として発信します。';
const pageUrl = `https://beekle.jp/blog/page/${currentPage}`;
const prevUrl =
  currentPage === 2 ? 'https://beekle.jp/blog' : `https://beekle.jp/blog/page/${currentPage - 1}`;
const nextUrl = `https://beekle.jp/blog/page/${currentPage + 1}`;
---

<Layout
  title={`ブログ ${currentPage}ページ目 | Beekle`}
  description={pageDescription}
  canonical={pageUrl}
>
  <Fragment slot="head">
    <link rel="prev" href={prevUrl} />
    {pagination.hasNextPage && <link rel="next" href={nextUrl} />}
  </Fragment>
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: 'ブログ', url: '/blog' },
        { name: `${currentPage}ページ目`, url: `/blog/page/${currentPage}` },
      ],
    }}
  />
  <JsonLd
    slot="head"
    type="webPage"
    data={{
      pageType: 'CollectionPage',
      name: `ブログ ${currentPage}ページ目 | Beekle`,
      description: pageDescription,
      url: pageUrl,
    }}
  />
  {blogs.length > 0 && (
    <JsonLd
      slot="head"
      type="itemList"
      data={{
        name: `Beekle ブログ一覧 ${currentPage}ページ目`,
        url: pageUrl,
        itemType: 'BlogPosting',
        items: blogs.map((blog) => ({
          name: blog.title,
          description: getExcerpt(blog),
          url: `https://beekle.jp/blog/${blog.id}`,
        })),
      }}
    />
  )}
  <Header client:idle />
  <main class="pt-20">
    <PageHero
      title="ブログ"
      subtitle="開発、AI、自社プロダクト、経営、日々の試行錯誤を、コラムとは別の雑記として書いていきます。"
      badge="Blog"
    />

    <section class="bg-white py-16 md:py-24">
      <BlogListing
        blogs={blogs}
        apiError={apiError}
        currentPage={pagination.currentPage}
        totalPages={pagination.totalPages}
        totalCount={pagination.totalCount}
        pageSize={pagination.limit}
      />
    </section>
  </main>
</Layout>
