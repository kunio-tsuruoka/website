---
export const prerender = false;

import CareersContactForm from '../../components/careers-contact-form';
import { Header } from '../../components/header';
import JsonLd from '../../components/seo/json-ld.astro';
import { PageHero } from '../../components/ui/page-hero';
import Layout from '../../layouts/layout.astro';

const runtime = (Astro.locals as { runtime?: { env?: { TURNSTILE_SITE_KEY?: string } } }).runtime;
const sitekey = runtime?.env?.TURNSTILE_SITE_KEY ?? '0x4AAAAAADHmRrTyQk-jx5-X';
---

<Layout
  title="採用のお問い合わせ | Beekle"
  description="Beekleの採用・カジュアル面談のお問い合わせ。会社名は不要です。新卒・中途・カジュアル面談のご連絡はこちらから。"
>
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: '採用情報', url: '/careers' },
        { name: '採用のお問い合わせ', url: '/careers/contact' },
      ],
    }}
  />
  <JsonLd
    slot="head"
    type="webPage"
    data={{
      pageType: 'ContactPage',
      name: '採用のお問い合わせ | Beekle',
      description: 'Beekleの採用・カジュアル面談のお問い合わせ。会社名は不要です。新卒・中途・カジュアル面談のご連絡はこちらから。',
      url: 'https://beekle.jp/careers/contact',
    }}
  />
  <Header />
  <main class="bg-neutral-100 pt-20">
    <PageHero
      title="採用のお問い合わせ"
      subtitle="カジュアル面談・応募のご連絡はこちら。会社名は不要です。通常1〜2営業日以内に採用担当から返信します。"
    />

    <section class="py-20 md:py-28">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <div class="mb-8 rounded-lg bg-primary-50 border border-primary-100 p-5">
            <p class="text-sm text-foreground/85 leading-relaxed">
              業務のご相談は
              <a href="/contact" class="text-primary-600 font-medium underline hover:no-underline">お問い合わせ</a>
              へ。採用ページに戻る場合は
              <a href="/careers" class="text-primary-600 font-medium underline hover:no-underline">採用情報</a>
              からどうぞ。
            </p>
          </div>

          <CareersContactForm client:load sitekey={sitekey} />
        </div>
      </div>
    </section>
  </main>

  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer></script>
</Layout>
