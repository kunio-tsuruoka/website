---
import { Header } from '@/components/header';
import PmOnRailsSection from '@/components/pm-on-rails-section.astro';
import JsonLd from '@/components/seo/json-ld.astro';
import { consultationHub, getConsultationSituation } from '@/data/consultation-situations';
import Layout from '@/layouts/layout.astro';

export const prerender = false;

const { slug } = Astro.params;
const situation = getConsultationSituation(slug);

if (!situation) {
  return new Response(null, { status: 404 });
}

const siteUrl = 'https://beekle.jp';
const pageUrl = `${siteUrl}${situation.href}`;
---

<Layout
  title={`${situation.navLabel} | 相談が始まる場面 | Beekle株式会社`}
  description={situation.description}
  canonical={pageUrl}
>
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: consultationHub.title, url: consultationHub.href },
        { name: situation.navLabel, url: situation.href },
      ],
    }}
  />
  <Header />
  <main class="bg-neutral-100 pt-20">
    <section class="border-b border-neutral-300 bg-neutral-100 py-14 md:py-20">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <div>
            <p class="border-l-8 border-primary-500 pl-5 text-sm font-bold text-primary-700">
              相談が始まる場面
            </p>
            <h1 class="mt-6 text-4xl font-bold leading-tight text-accent-950 md:text-5xl">
              {situation.title}
            </h1>
            <p class="mt-6 text-lg leading-relaxed text-neutral-700">{situation.lead}</p>
            <p class="mt-4 text-sm font-bold leading-relaxed text-primary-700">
              主な相談者: {situation.audience}
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a
                href={`/contact?source=situation-${situation.slug}`}
                data-cta-source={`situation-${situation.slug}`}
                data-cta-id="contact"
                class="inline-flex min-h-[52px] items-center justify-center rounded-md bg-primary-500 px-8 py-4 text-base font-semibold text-white transition-colors hover:bg-primary-600"
              >
                実現可否を相談する
              </a>
              <a
                href="/situations"
                class="inline-flex min-h-[52px] items-center justify-center border border-accent-950 px-8 py-4 text-base font-semibold text-accent-950 transition-colors hover:bg-accent-950 hover:text-white"
              >
                一覧へ戻る
              </a>
            </div>
          </div>

          <div class="border-y border-neutral-300 bg-white">
            <div class="grid gap-2 border-b border-neutral-300 border-l-8 border-primary-500 px-5 py-4 md:grid-cols-[0.52fr_1fr]">
              <p class="text-sm font-bold text-primary-700">相談メモ</p>
              <p class="text-sm font-bold text-accent-950">
                初回で、判断材料と見送り条件を同じ紙面に置きます。
              </p>
            </div>
            <div class="divide-y divide-neutral-300">
              {situation.judgmentRows.map((row, index) => (
                <div class="grid gap-3 px-5 py-5 md:grid-cols-[104px_1fr]">
                  <p class="font-Poppins text-sm font-bold text-primary-600">
                    {String(index + 1).padStart(2, '0')}
                  </p>
                  <div>
                    <h2 class="text-xl font-bold leading-snug text-navy-950">{row.label}</h2>
                    <p class="mt-2 text-sm leading-relaxed text-neutral-700">{row.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-14 md:py-16">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
          <div>
            <p class="section-label">01 SYMPTOMS</p>
            <h2 class="mt-3 text-3xl font-bold leading-tight text-navy-950 md:text-4xl">
              こういう状態なら、ここから入る
            </h2>
          </div>
          <div class="grid gap-4">
            {situation.symptoms.map((symptom, index) => (
              <div class="grid gap-3 border-b border-neutral-300 bg-neutral-50 px-2 py-5 md:grid-cols-[72px_1fr]">
                <p class="font-Poppins text-sm font-bold text-primary-600">
                  {String(index + 1).padStart(2, '0')}
                </p>
                <p class="text-lg font-bold leading-relaxed text-accent-950">{symptom}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-neutral-300 bg-neutral-50 py-14 md:py-16">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="mb-8 border-b border-neutral-300 pb-6">
          <p class="section-label">02 MATERIALS</p>
          <h2 class="mt-3 text-3xl font-bold leading-tight text-navy-950 md:text-4xl">
            初回相談で返すもの
          </h2>
          <p class="mt-4 max-w-3xl text-base leading-relaxed text-neutral-700">
            提案資料だけで終わらせず、社内説明や見積もり比較に使える形へ戻します。
          </p>
        </div>
        <div class="grid gap-5 lg:grid-cols-3">
          {situation.returnMaterials.map((material, index) => (
            <article class="card-base h-full p-6">
              <p class="font-Poppins text-sm font-bold text-primary-600">
                {String(index + 1).padStart(2, '0')}
              </p>
              <h3 class="mt-3 text-xl font-bold leading-snug text-navy-950">{material.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-neutral-700">{material.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {situation.slug === 'legacy-system-modernization' && <PmOnRailsSection />}

    <section class="py-14 md:py-16">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
          <div>
            <p class="section-label">03 根拠</p>
            <h2 class="mt-3 text-3xl font-bold leading-tight text-navy-950 md:text-4xl">
              本当に任せてよいかを見る材料
            </h2>
            <p class="mt-4 text-base leading-relaxed text-neutral-700">
              抽象的な強みではなく、この相談場面で見るべき証拠を置きます。
            </p>
          </div>

          <div class="space-y-6">
            <div class="border-y border-neutral-300 bg-white">
              {situation.rtbItems.map((item) => (
                <div class="grid gap-3 border-b border-neutral-300 px-5 py-5 last:border-b-0 md:grid-cols-[148px_1fr]">
                  <p class="text-sm font-bold text-primary-700">{item.label}</p>
                  <div>
                    <h3 class="text-xl font-bold leading-snug text-accent-950">{item.value}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-neutral-700">{item.description}</p>
                  </div>
                </div>
              ))}
            </div>

            <article class="border-l-8 border-primary-500 bg-white p-6">
              <p class="text-sm font-bold text-primary-700">{situation.proof.label}</p>
              <h3 class="mt-3 text-2xl font-bold leading-snug text-navy-950">
                {situation.proof.title}
              </h3>
              <p class="mt-4 leading-relaxed text-neutral-700">{situation.proof.description}</p>
              <ul class="mt-5 space-y-3">
                {situation.proof.points.map((point) => (
                  <li class="border-t border-neutral-200 pt-3 text-sm font-bold leading-relaxed text-accent-950">
                    {point}
                  </li>
                ))}
              </ul>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-neutral-300 bg-neutral-50 py-14 md:py-16">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
          <div>
            <p class="section-label">04 CONDITIONS</p>
            <h2 class="mt-3 text-3xl font-bold leading-tight text-navy-950 md:text-4xl">
              見送り条件も先に置く
            </h2>
            <p class="mt-4 text-base leading-relaxed text-neutral-700">
              相談者側が社内で判断しやすいように、今すぐ着手しない条件も言語化します。
            </p>
          </div>
          <div class="grid gap-4">
            {situation.deferCriteria.map((criterion, index) => (
              <div class="grid gap-3 border-b border-neutral-300 py-5 md:grid-cols-[72px_1fr]">
                <p class="font-Poppins text-sm font-bold text-primary-600">
                  {String(index + 1).padStart(2, '0')}
                </p>
                <p class="text-lg font-bold leading-relaxed text-accent-950">{criterion}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-14 md:py-16">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="mb-8 border-b border-neutral-300 pb-6">
          <p class="section-label">05 SERVICES</p>
          <h2 class="mt-3 text-3xl font-bold leading-tight text-navy-950 md:text-4xl">
            関連する進め方・サービス
          </h2>
        </div>
        <div class="grid gap-5 lg:grid-cols-2">
          {situation.relatedServices.map((service) => (
            <a href={service.href} class="group block">
              <article class="card-base card-hover h-full p-6">
                <h3 class="text-2xl font-bold leading-snug text-navy-950 group-hover:text-primary-600">
                  {service.label}
                </h3>
                <p class="mt-3 leading-relaxed text-neutral-700">{service.description}</p>
                <p class="mt-5 text-sm font-bold text-primary-500 group-hover:text-primary-600">
                  サービスを見る
                </p>
              </article>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-accent-950 py-16 md:py-20">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="mx-auto max-w-4xl text-center">
          <p class="text-sm font-bold text-white/70">CONTACT</p>
          <h2 class="mt-4 text-3xl font-bold leading-tight text-white md:text-5xl">
            この場面に近いなら、資料が途中でも相談できます。
          </h2>
          <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-white/80">
            現状のメモ、既存資料、会議で出た論点だけでも構いません。
            初回で、判断材料と次に確認することへ整理します。
          </p>
          <a
            href={`/contact?source=situation-${situation.slug}-final`}
            data-cta-source={`situation-${situation.slug}-final`}
            data-cta-id="contact"
            class="mt-8 inline-flex min-h-[52px] items-center justify-center rounded-md bg-white px-8 py-4 text-base font-semibold text-accent-950 transition-colors hover:bg-neutral-100"
          >
            実現可否を相談する
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
