---
import { Header } from '../components/header';
import JsonLd from '../components/seo/json-ld.astro';
import { ButtonLink } from '../components/ui/button';
import Layout from '../layouts/layout.astro';

const faqs = [
  {
    question: '協業の契約形態はどうなりますか。',
    answer:
      'ご要望に応じて、成果物ベースの請負と、月単位でチームが参画する準委任のどちらでも対応します。難航案件の火消しやスコープが動きやすいフェーズでは準委任、仕様が固まった実装フェーズでは請負、といった使い分けもできます。',
  },
  {
    question: '秘密保持や再委託先への情報開示は問題ありませんか。',
    answer:
      'NDAを締結したうえで進めます。元請けの先にいるエンドクライアントの情報も、開示範囲を事前に取り決めて扱います。実績を対外的に紹介する際も、社名・製品名を出さない匿名化を前提にします。',
  },
  {
    question: 'どこまでの技術領域を任せられますか。',
    answer:
      'フロントエンド、バックエンド、インフラまで一貫して対応できます。生成AI、RAG、GraphRAGの実装、仕様駆動開発、引き継ぎ後の立て直しまで相談できます。',
  },
  {
    question: '短期での立ち上げや、停滞した案件の引き継ぎもできますか。',
    answer:
      '対応実績があります。先行ベンダーが数ヶ月かけて完成に至らなかった案件を引き継ぎ、フロント、バックエンド、インフラまで一貫で再構築して短期間で完成させたケースがあります。',
  },
  {
    question: '最初の相談では何を伝えればよいですか。',
    answer:
      '案件の概要、逼迫している領域、想定スケジュール、求める契約形態をお送りください。要件が固まっていない段階でも、参画可否と確認すべき論点を返します。',
  },
];

const decisionRows = [
  ['相談者', '開発会社 / SIer / コンサル / 事業会社の開発部門'],
  ['補完する範囲', 'フロント、バックエンド、インフラ、AI/RAG実装'],
  ['守秘', 'NDA締結可。匿名前提の協業・再委託に対応'],
  ['判断', '参画できる範囲、契約形態、先に確認するリスク'],
];

const fitRows = [
  '生成AI・RAG案件を受注したが、実装リソースが足りない',
  '先行ベンダーが停滞し、フロントからインフラまで立て直したい',
  '領域ごとに別会社へ分けず、実装窓口を1本化したい',
  'PoCで止めず、本番化まで見据えた技術パートナーがほしい',
];

const capabilityRows = [
  ['一貫実装', 'フロント、バックエンド、インフラを分断せず対応します。'],
  ['AI / RAG', '生成AI、RAG、GraphRAG、評価設計、権限・ログまで扱います。'],
  ['立て直し', '既存コード、要件、インフラを読み直し、再開できる単位へ整理します。'],
  ['仕様管理', '要求、受入条件、実装タスク、確認結果をつないで影響を追います。'],
];

const caseRows = [
  [
    '難航案件の引き継ぎ',
    '3ヶ月停滞 → 3週間',
    'フロント、バックエンド、インフラまで読み直して再構築',
  ],
  ['新規事業の立ち上げ', '約1週間で基盤構築', '画面、API、インフラを分断せず検証できる状態へ'],
  ['AIナレッジ検索', 'GraphRAG PoC', '検索、根拠確認、評価観点を一体で検証'],
];
---

<Layout
  title="AI受託開発・RAGの開発パートナー｜開発会社・SIer向け | Beekle"
  description="開発会社・SIer・コンサル向けの協業窓口。フロント、バックエンド、インフラ、生成AI・RAG・GraphRAG実装、難航案件の立て直しに対応します。"
>
  <JsonLd
    slot="head"
    type="service"
    data={{
      serviceName: '開発パートナー・協業（開発会社・SIer向け）',
      serviceDescription:
        'フロントエンド、バックエンド、インフラまで一貫した開発支援。生成AI・RAG・GraphRAGの実装、難航案件の引き継ぎ、短期立ち上げに対応します。',
      url: 'https://beekle.jp/partner',
      serviceType: 'システム開発・生成AI開発の協業・再委託',
    }}
  />
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: '開発パートナー（開発会社・SIer向け）', url: '/partner' },
      ],
    }}
  />
  <JsonLd slot="head" type="faq" data={{ faqs }} />
  <Header />

  <main class="bg-neutral-100 pt-20">
    <section class="border-b border-neutral-300 bg-neutral-100 py-14 md:py-20">
      <div class="container mx-auto grid gap-10 px-8 lg:grid-cols-[0.9fr_0.85fr] lg:items-end lg:px-12">
        <div>
          <p class="border-l-8 border-primary-500 pl-5 text-sm font-bold text-primary-700">
            開発会社・SIer・コンサルの皆さまへ
          </p>
          <h1 class="mt-6 max-w-4xl text-4xl font-bold leading-[1.08] text-accent-950 [word-break:keep-all] sm:text-5xl md:text-6xl">
            実装まで一貫で任せられる
            <br />
            開発パートナー。
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-neutral-700 md:text-xl">
            フロント、バックエンド、インフラ、生成AI・RAG実装まで補完します。元請けの先にいるエンドクライアントまで見据え、匿名前提で協業できます。
          </p>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
            <ButtonLink
              href="/contact?source=partner-hero&intent=partner"
              data-cta-source="partner-hero"
              data-cta-id="contact-partner"
              variant="primary"
              size="lg"
            >
              協業可否を相談する
            </ButtonLink>
            <a href="#works" class="inline-flex min-h-[48px] items-center border-b border-accent-950 text-sm font-semibold text-accent-950 hover:border-primary-500 hover:text-primary-500">
              実案件ログを見る
            </a>
          </div>
          <p class="mt-5 text-sm leading-relaxed text-neutral-600">
            NDA可。再委託・準委任・請負いずれも、範囲と守秘条件を先に整理します。
          </p>
        </div>

        <aside class="border-y border-neutral-300 bg-white">
          <div class="border-b border-neutral-300 border-l-8 border-primary-500 px-5 py-4">
            <p class="text-sm font-bold text-primary-700">協業判断メモ</p>
            <p class="mt-1 text-2xl font-bold leading-tight text-accent-950">
              参画可否を先に確認
            </p>
          </div>
          <dl class="divide-y divide-neutral-300">
            {decisionRows.map(([label, value]) => (
              <div class="grid gap-3 px-5 py-4 md:grid-cols-[112px_1fr]">
                <dt class="text-sm font-bold text-primary-700">{label}</dt>
                <dd class="text-base font-bold leading-relaxed text-accent-950">{value}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </section>

    <section class="bg-neutral-50 py-14 md:py-16">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
          <div>
            <p class="text-sm font-bold text-primary-500">相談される場面</p>
            <h2 class="mt-3 text-3xl font-bold leading-tight text-accent-950 md:text-4xl">
              実装フェーズで止まりそうな案件に向いています。
            </h2>
          </div>
          <div class="border-t border-neutral-300">
            {fitRows.map((item) => (
              <div class="border-b border-neutral-300 py-5">
                <p class="text-lg font-bold leading-snug text-accent-950">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-neutral-100 py-14 md:py-16">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
          <div>
            <p class="text-sm font-bold text-primary-500">対応範囲</p>
            <h2 class="mt-3 text-3xl font-bold leading-tight text-accent-950 md:text-4xl">
              領域の間で責任が落ちる状態を減らします。
            </h2>
          </div>
          <div class="decision-sheet-table border-y border-neutral-300 bg-white">
            {capabilityRows.map(([title, text], index) => (
              <div class="grid gap-3 border-b border-neutral-300 px-5 py-5 last:border-b-0 md:grid-cols-[112px_1fr]">
                <p class="font-Poppins text-sm font-bold text-primary-600">
                  {String(index + 1).padStart(2, '0')}
                </p>
                <div>
                  <h3 class="text-xl font-bold leading-snug text-accent-950">{title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-neutral-700">{text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="works" class="bg-neutral-50 py-14 md:py-16 scroll-mt-24">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
          <div>
            <p class="text-sm font-bold text-primary-500">実案件ログ</p>
            <h2 class="mt-3 text-3xl font-bold leading-tight text-accent-950 md:text-4xl">
              守秘に触れない範囲で、変化だけ示します。
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-neutral-700">
              社名・製品名は伏せ、期間・対応範囲など確認可能な事実だけを出します。
            </p>
          </div>
          <div class="case-log-table border-t border-neutral-300">
            {caseRows.map(([label, value, text]) => (
              <div class="grid gap-3 border-b border-neutral-300 py-5 md:grid-cols-[0.7fr_0.7fr_1fr]">
                <p class="text-sm font-bold text-primary-700">{label}</p>
                <p class="font-Poppins text-2xl font-bold leading-tight text-primary-500">
                  {value}
                </p>
                <p class="text-sm leading-relaxed text-neutral-700">{text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-neutral-100 py-14 md:py-16">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
          <div>
            <p class="text-sm font-bold text-primary-500">FAQ</p>
            <h2 class="mt-3 text-3xl font-bold leading-tight text-accent-950 md:text-4xl">
              協業前に確認されること
            </h2>
          </div>
          <div class="border-t border-neutral-300">
            {faqs.map((item) => (
              <details class="border-b border-neutral-300 py-5">
                <summary class="cursor-pointer list-none text-lg font-bold text-accent-950 [&::-webkit-details-marker]:hidden">
                  {item.question}
                </summary>
                <p class="mt-3 text-sm leading-relaxed text-neutral-700">{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-accent-950 py-16 md:py-20">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="max-w-3xl">
          <h2 class="text-3xl font-bold leading-tight text-white md:text-5xl">
            参画できる範囲と守秘条件から確認します。
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-white/85">
            案件概要、逼迫している領域、希望スケジュールをお送りください。1〜2営業日以内に確認します。
          </p>
          <div class="mt-8">
            <ButtonLink
              href="/contact?source=partner-final&intent=partner"
              data-cta-source="partner-final"
              data-cta-id="contact-partner"
              variant="white"
              size="lg"
            >
              協業可否を相談する
            </ButtonLink>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
