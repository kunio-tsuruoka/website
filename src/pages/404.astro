---
import { Header } from '../components/header';
import Layout from '../layouts/layout.astro';
---

<Layout title="ページが見つかりません | Beekle">
  <Header />
  <main class="bg-neutral-100 pt-20">
    <section class="relative flex min-h-screen items-center justify-center overflow-hidden bg-neutral-100">
      <div class="container mx-auto px-6 md:px-8 relative">
        <div class="text-center max-w-3xl mx-auto">
          {/* 404 Number */}
          <div class="mb-8">
            <h1 class="text-8xl md:text-[180px] font-bold text-primary-500/20 leading-none mb-4">
              404
            </h1>
            <div class="w-24 h-1 bg-primary-500 mx-auto rounded-full"></div>
          </div>

          {/* Main Message */}
          <h2 class="text-3xl md:text-5xl font-bold text-accent-950 mb-6 leading-tight">
            お探しのページが<br class="md:hidden" />見つかりませんでした
          </h2>

          <p class="text-lg md:text-xl text-neutral-700 mb-12 leading-relaxed">
            申し訳ございません。<br class="hidden md:block" />
            URLが間違っているか、ページが移動または削除された可能性があります。
          </p>

          {/* Action Buttons */}
          <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
            <a
              href="/"
              class="inline-flex items-center justify-center rounded-md bg-primary-500 px-8 py-4 text-base font-semibold text-white transition-colors hover:bg-primary-600"
            >
              <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              トップページへ戻る
            </a>
            <a
              href="/column"
              class="inline-flex items-center justify-center rounded-md border border-primary-500 bg-white px-8 py-4 text-base font-semibold text-primary-500 transition-colors hover:bg-primary-50"
            >
              <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
              コラムを見る
            </a>
          </div>

          {/* Quick Links */}
          <div class="rounded-lg border border-neutral-200 bg-white p-8">
            <h3 class="text-xl font-bold text-accent-950 mb-6">よく見られているページ</h3>
            <div class="grid md:grid-cols-3 gap-4">
              <a
                href="/prooffirst"
                class="group block rounded-lg border border-neutral-200 bg-neutral-50 p-4 transition-colors hover:border-primary-300"
              >
                <div class="text-accent-950 font-semibold mb-2 group-hover:text-primary-500 transition-colors">
                  ゼロスタート
                </div>
                <div class="text-neutral-600 text-sm">
                  初期費用0円で始める
                </div>
              </a>
              <a
                href="/column"
                class="group block rounded-lg border border-neutral-200 bg-neutral-50 p-4 transition-colors hover:border-primary-300"
              >
                <div class="text-accent-950 font-semibold mb-2 group-hover:text-primary-500 transition-colors">
                  開発ナレッジ
                </div>
                <div class="text-neutral-600 text-sm">
                  失敗しない開発のコツ
                </div>
              </a>
              <a
                href="/contact?source=404-card"
                data-cta-source="404-card"
                data-cta-id="contact"
                class="group block rounded-lg border border-neutral-200 bg-neutral-50 p-4 transition-colors hover:border-primary-300"
              >
                <div class="text-accent-950 font-semibold mb-2 group-hover:text-primary-500 transition-colors">
                  無料相談
                </div>
                <div class="text-neutral-600 text-sm">
                  お気軽にご相談ください
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
