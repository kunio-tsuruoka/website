---
import { DataHousekeeping } from '../../components/data-housekeeping';
import { Header } from '../../components/header';
import JsonLd from '../../components/seo/json-ld.astro';
import ToolPath from '../../components/tool-path.astro';
import { ToolWizard } from '../../components/tool-wizard';
import FloatingCTA from '../../components/ui/floating-cta.astro';
import { PageHero } from '../../components/ui/page-hero';
import Layout from '../../layouts/layout.astro';
---

<Layout
  title="発注準備キット｜業務の見える化から要件のたたき台まで | Beekle"
  description="システム発注の前に、見る→書く→切る→出すの順で、業務の見える化・やりたいことの言語化・作る／作らないの判定・RFPの下書きまで一気通貫にサポート。ブラウザ完結で会員登録不要。"
>
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: '発注準備キット', url: '/tools' },
      ],
    }}
  />
  <JsonLd
    slot="head"
    type="itemList"
    data={{
      name: 'システム発注準備キット',
      url: 'https://beekle.jp/tools',
      itemType: 'SoftwareApplication',
      items: [
        {
          name: '業務フロー可視化ツール',
          description: '現状(As-Is)と改善後(To-Be)の業務フローを書き出し、ボトルネックを自動分析。',
          url: 'https://beekle.jp/tools/flow-mapper',
        },
        {
          name: 'ユーザーストーリー作成ツール',
          description: '現状と目指す姿を分け、ユーザーストーリー・シナリオ・RFPの下書きまで整理。',
          url: 'https://beekle.jp/tools/story-builder',
        },
        {
          name: 'スコープ管理ツール',
          description: '要件を「作る／後回し／作らない」に振り分け、予算オーバーを防ぐ。',
          url: 'https://beekle.jp/tools/scope-manager',
        },
        {
          name: 'RFPドラフト自動生成',
          description: '予算・時期・連絡先を足して、開発会社に渡す提案依頼書の一枚にする。',
          url: 'https://beekle.jp/tools/rfp-builder',
        },
      ],
    }}
  />
  <Header />
  <main class="bg-neutral-100 pt-20">
    <PageHero
      title="発注準備キット"
      subtitle="システムを発注する前に、現場と一緒に「何を作るか」を決める。見る → 書く → 切る → 出す、の順で進められます。"
      badge="Tools"
    />

    <section class="border-b border-neutral-300 bg-neutral-100 py-12 md:py-16">
      <div class="container mx-auto px-6 md:px-8 max-w-6xl">
        <div class="mb-12">
          <ToolPath />
        </div>

        <div class="mb-12">
          <ToolWizard client:load />
        </div>

        {/* ツール紹介カード */}
        <div class="space-y-6 mb-12">
          {/* Step 1 */}
          <a
            href="/tools/flow-mapper"
            class="group block rounded-lg border border-neutral-200 bg-white p-6 transition-colors hover:border-primary-300 md:p-8"
          >
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-md bg-primary-100 text-lg font-bold text-primary-600">
                01
              </div>
              <div class="flex-1 min-w-0">
                <p class="mb-1 font-Poppins text-[11px] font-semibold tracking-[0.16em] text-primary-500">
                  見る
                </p>
                <div class="flex items-baseline justify-between flex-wrap gap-2 mb-2">
                  <h3 class="text-lg md:text-xl font-bold text-gray-900 group-hover:text-primary-600 transition-colors">
                    業務フロー可視化ツール
                  </h3>
                </div>
                <p class="text-sm text-gray-700 leading-relaxed mb-3">
                  現状の業務（誰が・何を・どのツールで・どれくらい時間をかけて）を図にして、改善後（To-Be）の姿まで関係者と合意できるツール。AI／DX 導入の「どこをDXすべきか」の判断にも使えます。
                </p>
                <ul class="text-xs text-gray-600 space-y-1">
                  <li>・ 横軸＝工程 × 縦軸＝担当 でステップを並べる</li>
                  <li>・ 時給を入れると人件費とリードタイムを自動算出</li>
                  <li>・ 自動化候補・AI 適用候補・並行化候補をタグ付け</li>
                  <li>・ PNG / SVG / Markdown / PDF で出力可能</li>
                </ul>
              </div>
              <div class="hidden md:block flex-shrink-0 text-primary-500 self-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </div>
            </div>
          </a>

          {/* Step 2 */}
          <a
            href="/tools/story-builder"
            class="group block rounded-lg border border-neutral-200 bg-white p-6 transition-colors hover:border-primary-300 md:p-8"
          >
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-md bg-primary-100 text-lg font-bold text-primary-600">
                02
              </div>
              <div class="flex-1 min-w-0">
                <p class="mb-1 font-Poppins text-[11px] font-semibold tracking-[0.16em] text-primary-500">
                  書く
                </p>
                <div class="flex items-baseline justify-between flex-wrap gap-2 mb-2">
                  <h3 class="text-lg md:text-xl font-bold text-gray-900 group-hover:text-primary-600 transition-colors">
                    ユーザーストーリー作成ツール
                  </h3>
                </div>
                <p class="text-sm text-gray-700 leading-relaxed mb-3">
                  いまのやり方と、こうしたいを書くと、現状と目指す姿、誰が／何を／なぜ、前提／操作／結果、RFPの下書きまで同じ流れで出ます。
                </p>
                <ul class="text-xs text-gray-600 space-y-1">
                  <li>・ 要望の羅列ではなく、現状と目指す姿を先に分ける</li>
                  <li>・ 「誰が／何を／なぜ」のストーリーにシナリオを付ける</li>
                  <li>・ うまくいかない場合も、先に言語化する</li>
                  <li>・ 同じ内容をRFPの章立てで書き出せる</li>
                </ul>
              </div>
              <div class="hidden md:block flex-shrink-0 text-primary-500 self-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </div>
            </div>
          </a>

          {/* Step 3 */}
          <a
            href="/tools/scope-manager"
            class="group block rounded-lg border border-neutral-200 bg-white p-6 transition-colors hover:border-primary-300 md:p-8"
          >
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-md bg-primary-100 text-lg font-bold text-primary-600">
                03
              </div>
              <div class="flex-1 min-w-0">
                <p class="mb-1 font-Poppins text-[11px] font-semibold tracking-[0.16em] text-primary-500">
                  切る
                </p>
                <div class="flex items-baseline justify-between flex-wrap gap-2 mb-2">
                  <h3 class="text-lg md:text-xl font-bold text-gray-900 group-hover:text-primary-600 transition-colors">
                    スコープ管理ツール
                  </h3>
                </div>
                <p class="text-sm text-gray-700 leading-relaxed mb-3">
                  Step2 で出した要件を「作る／後回し／作らない」に振り分けるツール。ビジネス価値・現場で使えるか・技術コストの3軸で評価して、開発会社や社内の合意形成を加速します。書籍『システムを作らせる技術』のFM手法に準拠。
                </p>
                <ul class="text-xs text-gray-600 space-y-1">
                  <li>・ 要件定義書（Markdown）を貼り付けるだけで一覧化</li>
                  <li>・ 3軸評価で「作る／後回し／作らない」を自動推定</li>
                  <li>・ 「作らない」も明示してスコープクリープを防止</li>
                  <li>・ CSV / Markdown で出力、社内承認や開発会社への提示用に</li>
                </ul>
              </div>
              <div class="hidden md:block flex-shrink-0 text-primary-500 self-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </div>
            </div>
          </a>

          {/* Step 4 (最終アウトプット) */}
          <a
            href="/tools/rfp-builder"
            class="group block rounded-lg border border-primary-300 bg-white p-6 transition-colors hover:border-primary-500 md:p-8"
          >
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-md bg-primary-500 text-lg font-bold text-white">
                04
              </div>
              <div class="flex-1 min-w-0">
                <p class="mb-1 font-Poppins text-[11px] font-semibold tracking-[0.16em] text-primary-500">
                  出す
                </p>
                <div class="flex items-baseline justify-between flex-wrap gap-2 mb-2">
                  <h3 class="text-lg md:text-xl font-bold text-gray-900 group-hover:text-primary-600 transition-colors">
                    RFPドラフト自動生成 <span class="text-xs font-medium text-primary-500 align-middle ml-1">最終アウトプット</span>
                  </h3>
                </div>
                <p class="text-sm text-gray-700 leading-relaxed mb-3">
                  02と03で作った中身に、プロジェクト名、予算、希望時期、連絡先を足して、開発会社に渡す一枚にします。先に中身がないと、空の章立てになります。
                </p>
                <ul class="text-xs text-gray-600 space-y-1">
                  <li>・ 章立て: 概要／背景／現状／改善後／要件と優先度／提案依頼／連絡先</li>
                  <li>・ 各ツールがブラウザに保存しているデータを読み込んで自動で章を埋める</li>
                  <li>・ Markdown でダウンロード、クリップボードにコピー</li>
                  <li>・ 中身は 02 で書き、優先度は 03 で切ってから開く</li>
                </ul>
              </div>
              <div class="hidden md:block flex-shrink-0 text-primary-500 self-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </div>
            </div>
          </a>
        </div>

        {/* 保存データ管理 */}
        <div class="mb-12">
          <DataHousekeeping client:visible />
        </div>

        {/* 使い方の補足 */}
        <div class="mb-12 rounded-lg border border-neutral-200 bg-white p-6">
          <h2 class="text-base font-bold text-accent-950 mb-2">途中から入ってよい</h2>
          <p class="text-sm leading-relaxed text-neutral-700">
            業務の図が先なら 01 から。やりたいことが先なら 02 から。要件が溜まっているなら 03 から。ただし、誰が何をしたいかがないまま 04 だけ開くと、空の章立てになる。データは端末にだけ残る。会員登録は不要。
          </p>
        </div>

        {/* よくある質問 */}
        <div class="rounded-lg border border-neutral-200 bg-white p-6 md:p-8">
          <h2 class="text-lg font-bold text-gray-900 mb-4">よくある質問</h2>
          <dl class="space-y-4 text-sm">
            <div>
              <dt class="font-semibold text-gray-900 mb-1">Q. 本当に無料ですか？</dt>
              <dd class="text-gray-700 leading-relaxed">
                A. 無料です。会員登録もメールアドレス入力も不要です。Beekleの活動の一環として、発注前の検討で迷っている方に役立てばと思って公開しています。
              </dd>
            </div>
            <div>
              <dt class="font-semibold text-gray-900 mb-1">Q. 入力したデータはどこに保存されますか？</dt>
              <dd class="text-gray-700 leading-relaxed">
                A. お使いのブラウザ（端末）にのみ保存されます。Beekleのサーバーには送信されません。同じ端末・同じブラウザで開けば続きから編集できます。
              </dd>
            </div>
            <div>
              <dt class="font-semibold text-gray-900 mb-1">Q. 出力した結果を商用利用していいですか？</dt>
              <dd class="text-gray-700 leading-relaxed">
                A. はい。お客様の業務資料・社内文書・発注先への提示資料として自由にご利用いただけます。
              </dd>
            </div>
            <div>
              <dt class="font-semibold text-gray-900 mb-1">Q. 使い方が分からない／自社のケースだとどう使うか相談したい</dt>
              <dd class="text-gray-700 leading-relaxed">
                A. 各ツールページの「迷ったら15分で壁打ち相談」または<a href="/contact" class="text-primary-500 hover:underline inline-block py-2">お問い合わせ</a>からお気軽にご連絡ください。
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="py-16 bg-accent-950 text-white">
      <div class="container mx-auto px-6 md:px-8 max-w-4xl text-center">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">発注準備の伴走、お任せください</h2>
        <p class="text-white/80 leading-relaxed mb-8">
          現場ヒアリング・要件整理・スコープ調整、そして開発会社との合意形成まで。<br />
          発注前の悩みを Beekle がファシリテートします。
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact?source=tools-index&intent=consult"
            data-cta-source="tools-index"
            data-cta-id="contact-consult"
            class="tool-escape-cta inline-flex items-center justify-center rounded-md bg-white px-8 py-3 text-base font-semibold text-accent-950 transition-colors hover:bg-neutral-100"
          >
            業務課題を相談する
          </a>
          <a
            href="/column"
            class="inline-flex items-center justify-center rounded-md border border-white bg-transparent px-8 py-3 text-base font-semibold text-white transition-colors hover:bg-white hover:text-accent-950"
          >
            コラムで学ぶ
          </a>
        </div>
      </div>
    </section>

    <script>
      import { trackCtaClick } from '../../lib/analytics';
      const ctas = document.querySelectorAll<HTMLAnchorElement>('.tool-escape-cta');
      for (const el of ctas) {
        el.addEventListener('click', () => {
          const source = el.dataset.ctaSource ?? 'unknown';
          const cta = el.dataset.ctaId ?? 'unknown';
          trackCtaClick({ source, cta });
        });
      }
    </script>
  </main>
  <FloatingCTA
    href="/contact?source=tools-index&intent=floating"
    label="発注前の悩み、15分で壁打ち"
    source="tools-index"
    ctaId="floating-consult"
  />
</Layout>
