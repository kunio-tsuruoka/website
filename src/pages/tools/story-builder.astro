---
import { Header } from '../../components/header';
import JsonLd from '../../components/seo/json-ld.astro';
import { StoryBuilder } from '../../components/story-builder';
import FloatingCTA from '../../components/ui/floating-cta.astro';
import { PageHero } from '../../components/ui/page-hero';
import Layout from '../../layouts/layout.astro';
---

<Layout
  title="ユーザーストーリー作成ツール｜現状と目指す姿からシナリオとRFPまで | Beekle"
  description="やりたいことを書くと、現状（As-Is）と目指す姿（To-Be）、ユーザーストーリー、前提・操作・結果のシナリオ、RFPの下書きまで一気に整理します。開発会社との打ち合わせ前に使えます。"
>
  <JsonLd
    slot="head"
    type="softwareApplication"
    data={{
      appName: 'ユーザーストーリー作成ツール（Story Builder）',
      appDescription:
        '現状と目指す姿を分け、ユーザーストーリーとシナリオ、RFPの下書きまで整理する発注準備ツール。会員登録不要・ブラウザ完結。',
      url: 'https://beekle.jp/tools/story-builder',
    }}
  />
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: '発注準備キット', url: '/tools' },
        { name: 'ユーザーストーリー作成ツール', url: '/tools/story-builder' },
      ],
    }}
  />
  <Header />
  <main class="bg-neutral-100 pt-20">
    <PageHero
      title="ユーザーストーリー作成ツール"
      subtitle="いまのやり方と、こうしたいを書く。現状と目指す姿、誰が何をしたいか、うまくいく／いかない場合、RFPの下書きまでを同じ流れで整理します。"
      badge="Tools"
    />

    <div class="bg-amber-50 border-y border-amber-200">
      <div class="container mx-auto px-6 md:px-8 py-3 text-sm text-amber-900 flex flex-wrap items-center justify-center gap-2">
        <span>業務が複雑で、自分では切り出せない場合は</span>
        <a
          href="/contact?source=tool-story-builder&intent=tool-stuck&phase=start"
          data-cta-source="tool-story-builder"
          data-cta-id="contact-stuck-start"
          class="tool-escape-cta inline-block py-2 font-semibold underline decoration-amber-400 hover:decoration-amber-700"
        >
          要件のヒアリング相談へ
        </a>
      </div>
    </div>

    <section class="border-b border-neutral-300 bg-neutral-100 py-12 md:py-16">
      <div class="container mx-auto px-6 md:px-8 max-w-7xl">
        <div class="mb-10 grid md:grid-cols-3 gap-4">
          <div class="rounded-lg border border-neutral-200 bg-white p-5">
            <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-md bg-primary-100 font-bold text-primary-600">1</div>
            <h3 class="font-bold text-gray-900 mb-1">現状と目指す姿</h3>
            <p class="text-sm text-gray-700 leading-relaxed">
              いま誰が何をどの道具でやっているかと、こうなっていてほしいを分けて書きます。要望の羅列で始めません。
            </p>
          </div>
          <div class="rounded-lg border border-neutral-200 bg-white p-5">
            <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-md bg-primary-100 font-bold text-primary-600">2</div>
            <h3 class="font-bold text-gray-900 mb-1">ストーリーとシナリオ</h3>
            <p class="text-sm text-gray-700 leading-relaxed">
              「誰が／何を／なぜ」のストーリーに、前提・操作・結果のシナリオを付けます。うまくいかない場合も先に出します。
            </p>
          </div>
          <div class="rounded-lg border border-neutral-200 bg-white p-5">
            <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-md bg-primary-100 font-bold text-primary-600">3</div>
            <h3 class="font-bold text-gray-900 mb-1">RFPの下書き</h3>
            <p class="text-sm text-gray-700 leading-relaxed">
              同じ内容を、開発会社に渡せる提案依頼書の章立てへ落とします。Markdownで保存・共有できます。
            </p>
          </div>
        </div>

        <StoryBuilder client:load />

        <div class="mt-10 rounded-lg border border-neutral-200 bg-white p-6">
          <h2 class="text-lg font-bold text-gray-900 mb-3">前後の工程</h2>
          <ul class="space-y-2 text-sm text-gray-700">
            <li>
              <a href="/tools/flow-mapper" class="text-primary-500 hover:underline inline-block py-2">業務フロー可視化ツール</a>
              ：担当と手順で現状を図にする
            </li>
            <li>
              <a href="/tools/scope-manager" class="text-primary-500 hover:underline inline-block py-2">スコープ管理ツール</a>
              ：シナリオを「作る／後回し／作らない」に振り分ける
            </li>
            <li>
              <a href="/tools/rfp-builder" class="text-primary-500 hover:underline inline-block py-2">RFPドラフト自動生成</a>
              ：予算・時期・連絡先を足して発注用の一枚にする
            </li>
            <li>
              <a href="/tools" class="text-primary-500 hover:underline font-semibold inline-block py-2">発注準備キット</a>
              ：4つのツールの位置づけ
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="py-16 bg-accent-950 text-white">
      <div class="container mx-auto px-6 md:px-8 max-w-4xl text-center">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">この整理を、現場ヒアリングまで進める</h2>
        <p class="text-white/80 leading-relaxed mb-8">
          下書きのあと、関係者への確認、優先度、開発会社との合意まで Beekle が引き受けます。
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact?source=tool-story-builder&intent=review-request&phase=complete"
            data-cta-source="tool-story-builder"
            data-cta-id="contact-review-complete"
            class="tool-escape-cta inline-flex items-center justify-center rounded-md bg-white px-8 py-3 text-base font-semibold text-accent-950 transition-colors hover:bg-neutral-100"
          >
            この整理をレビューしてもらう
          </a>
          <a
            href="/tools/scope-manager"
            class="inline-flex items-center justify-center rounded-md border border-white bg-transparent px-8 py-3 text-base font-semibold text-white transition-colors hover:bg-white hover:text-accent-950"
          >
            スコープ管理ツールを試す
          </a>
        </div>
      </div>
    </section>

    <script>
      import { trackCtaClick } from '../../lib/analytics';
      const ctas = document.querySelectorAll<HTMLAnchorElement>('.tool-escape-cta');
      for (const el of ctas) {
        el.addEventListener('click', () => {
          const source = el.dataset.ctaSource ?? 'unknown';
          const cta = el.dataset.ctaId ?? 'unknown';
          trackCtaClick({ source, cta });
        });
      }
    </script>
  </main>
  <FloatingCTA
    href="/contact?source=tool-story-builder&intent=floating-stuck&phase=mid"
    label="要件のヒアリング相談へ"
    source="tool-story-builder"
    ctaId="floating-stuck"
  />
</Layout>
