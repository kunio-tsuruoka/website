---
import { Header } from '../../components/header';
import JsonLd from '../../components/seo/json-ld.astro';
import { StoryBuilder } from '../../components/story-builder';
import FloatingCTA from '../../components/ui/floating-cta.astro';
import { PageHero } from '../../components/ui/page-hero';
import Layout from '../../layouts/layout.astro';
---

<Layout
  title="ユーザーストーリー作成ツール｜現状と目指す姿からシナリオとRFPまで | Beekle"
  description="やりたいことを書くと、現状（As-Is）と目指す姿（To-Be）、ユーザーストーリー、Gherkinシナリオ、RFPの下書きまで一気に整理します。開発会社との打ち合わせ前に使えます。"
>
  <JsonLd
    slot="head"
    type="softwareApplication"
    data={{
      appName: 'ユーザーストーリー作成ツール（Story Builder）',
      appDescription:
        '現状と目指す姿を分け、ユーザーストーリーとGherkinシナリオ、RFPの下書きまで整理する発注準備ツール。会員登録不要・ブラウザ完結。',
      url: 'https://beekle.jp/tools/story-builder',
    }}
  />
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: '発注準備キット', url: '/tools' },
        { name: 'ユーザーストーリー作成ツール', url: '/tools/story-builder' },
      ],
    }}
  />
  <Header />
  <main class="bg-neutral-100 pt-20">
    <PageHero
      title="ユーザーストーリー作成ツール"
      subtitle="いまのやり方と、こうしたいを書く。現状と目指す姿、誰が何をしたいか、うまくいく／いかない場合、RFPの下書きまでを同じ流れで整理します。"
      badge="Tools"
    />

    <div class="border-y border-neutral-200 bg-white">
      <div class="container mx-auto px-6 md:px-8 py-3 text-sm text-neutral-700 flex flex-wrap items-center justify-center gap-2">
        <span class="border-l-4 border-primary-500 pl-3">業務が複雑で、自分では切り出せない場合は</span>
        <a
          href="/contact?source=tool-story-builder&intent=tool-stuck&phase=start"
          data-cta-source="tool-story-builder"
          data-cta-id="contact-stuck-start"
          class="tool-escape-cta inline-block py-2 font-semibold text-primary-600 hover:underline"
        >
          要件のヒアリング相談へ
        </a>
      </div>
    </div>

    <section class="border-b border-neutral-300 bg-neutral-100 py-12 md:py-16">
      <div class="container mx-auto px-6 md:px-8 max-w-7xl">
        <ol class="mb-10 grid overflow-hidden rounded-lg border border-neutral-200 bg-white md:grid-cols-3">
          <li class="border-b border-neutral-200 p-6 md:border-b-0 md:border-r">
            <p class="mb-3 font-Poppins text-3xl font-bold text-primary-500">01</p>
            <h3 class="mb-2 font-bold text-accent-950">現状と目指す姿</h3>
            <p class="text-sm leading-relaxed text-neutral-700">
              いま誰が何をどの道具でやっているかと、こうなっていてほしいを分けて書きます。要望の羅列で始めません。
            </p>
          </li>
          <li class="border-b border-neutral-200 p-6 md:border-b-0 md:border-r">
            <p class="mb-3 font-Poppins text-3xl font-bold text-primary-500">02</p>
            <h3 class="mb-2 font-bold text-accent-950">ストーリーとシナリオ</h3>
            <p class="text-sm leading-relaxed text-neutral-700">
              「誰が／何を／なぜ」のストーリーに、Given / When / Then のGherkinシナリオを付けます。うまくいかない場合も先に出します。
            </p>
          </li>
          <li class="p-6">
            <p class="mb-3 font-Poppins text-3xl font-bold text-primary-500">03</p>
            <h3 class="mb-2 font-bold text-accent-950">RFPの下書き</h3>
            <p class="text-sm leading-relaxed text-neutral-700">
              同じ内容を、開発会社に渡せる提案依頼書の章立てへ落とします。Markdownで保存・共有できます。
            </p>
          </li>
        </ol>

        <StoryBuilder client:load />

        <div class="mt-10 border border-neutral-200 bg-white">
          <div class="border-b border-neutral-200 px-6 py-4">
            <p class="font-Poppins text-[11px] font-semibold tracking-[0.16em] text-primary-500">NEXT</p>
            <h2 class="mt-1 text-lg font-bold text-accent-950">前後の工程</h2>
          </div>
          <ul class="divide-y divide-neutral-200 text-sm text-neutral-700">
            <li class="flex flex-col gap-1 px-6 py-3 md:flex-row md:items-baseline md:gap-3">
              <a href="/tools/flow-mapper" class="inline-block min-h-[44px] py-2 font-semibold text-primary-600 hover:underline">業務フロー可視化ツール</a>
              <span>担当と手順で現状を図にする</span>
            </li>
            <li class="flex flex-col gap-1 px-6 py-3 md:flex-row md:items-baseline md:gap-3">
              <a href="/tools/scope-manager" class="inline-block min-h-[44px] py-2 font-semibold text-primary-600 hover:underline">スコープ管理ツール</a>
              <span>シナリオを「作る／後回し／作らない」に振り分ける</span>
            </li>
            <li class="flex flex-col gap-1 px-6 py-3 md:flex-row md:items-baseline md:gap-3">
              <a href="/tools/rfp-builder" class="inline-block min-h-[44px] py-2 font-semibold text-primary-600 hover:underline">RFPドラフト自動生成</a>
              <span>予算・時期・連絡先を足して発注用の一枚にする</span>
            </li>
            <li class="flex flex-col gap-1 px-6 py-3 md:flex-row md:items-baseline md:gap-3">
              <a href="/tools" class="inline-block min-h-[44px] py-2 font-semibold text-primary-600 hover:underline">発注準備キット</a>
              <span>4つのツールの位置づけ</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="py-16 bg-accent-950 text-white">
      <div class="container mx-auto px-6 md:px-8 max-w-4xl text-center">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">この整理を、現場ヒアリングまで進める</h2>
        <p class="text-white/80 leading-relaxed mb-8">
          下書きのあと、関係者への確認、優先度、開発会社との合意まで Beekle が引き受けます。
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact?source=tool-story-builder&intent=review-request&phase=complete"
            data-cta-source="tool-story-builder"
            data-cta-id="contact-review-complete"
            class="tool-escape-cta inline-flex items-center justify-center rounded-md bg-white px-8 py-3 text-base font-semibold text-accent-950 transition-colors hover:bg-neutral-100"
          >
            この整理をレビューしてもらう
          </a>
          <a
            href="/tools/scope-manager"
            class="inline-flex items-center justify-center rounded-md border border-white bg-transparent px-8 py-3 text-base font-semibold text-white transition-colors hover:bg-white hover:text-accent-950"
          >
            スコープ管理ツールを試す
          </a>
        </div>
      </div>
    </section>

    <script>
      import { trackCtaClick } from '../../lib/analytics';
      const ctas = document.querySelectorAll<HTMLAnchorElement>('.tool-escape-cta');
      for (const el of ctas) {
        el.addEventListener('click', () => {
          const source = el.dataset.ctaSource ?? 'unknown';
          const cta = el.dataset.ctaId ?? 'unknown';
          trackCtaClick({ source, cta });
        });
      }
    </script>
  </main>
  <FloatingCTA
    href="/contact?source=tool-story-builder&intent=floating-stuck&phase=mid"
    label="要件のヒアリング相談へ"
    source="tool-story-builder"
    ctaId="floating-stuck"
  />
</Layout>
