---
import { CTASection } from '@/components/process-cta-section';
import { ProcessFAQ } from '@/components/process-faq-section';
// src/pages/process.astro
import { ProcessSteps } from '@/components/process-steps';
import { Header } from '../components/header';
import JsonLd from '../components/seo/json-ld.astro';
import { PageHero } from '../components/ui/page-hero';
import Layout from '../layouts/layout.astro';
---

<Layout
  title="導入の流れ | Beekle"
  description="Beekleの開発導入プロセスをご紹介。各段階で「Beekleがすること」「お客様にお願いすること」「その段階で決まること」を明示し、本開発前に主要な不確実性を確認しながら進めます。初期費用0円の検証用プロトタイプから始められます。"
>
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: '導入の流れ', url: '/process' },
      ],
    }}
  />
  <JsonLd
    slot="head"
    type="webPage"
    data={{
      pageType: 'WebPage',
      name: '導入の流れ | Beekle',
      description: 'Beekleの開発導入プロセスをご紹介。各段階で「Beekleがすること」「お客様にお願いすること」「その段階で決まること」を明示し、本開発前に主要な不確実性を確認しながら進めます。初期費用0円の検証用プロトタイプから始められます。',
      url: 'https://beekle.jp/process',
    }}
  />
  <Header />
  <main class="bg-neutral-100 pt-20">
    <PageHero
      title="導入の流れ"
      subtitle="お問い合わせから運用開始まで、段階的に進めていきます"
    />
    <ProcessSteps client:visible />
    <ProcessFAQ client:visible />
    <CTASection client:visible source="process-final" />
  </main>
</Layout>