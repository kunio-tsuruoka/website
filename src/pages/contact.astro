---
export const prerender = false;

import ContactForm from '../components/contact-form';
import { Header } from '../components/header';
import JsonLd from '../components/seo/json-ld.astro';
import { PageHero } from '../components/ui/page-hero';
import Layout from '../layouts/layout.astro';

const source = Astro.url.searchParams.get('source');
if (source === 'careers') {
  const next = new URL('/careers/contact', Astro.url);
  next.search = Astro.url.search;
  return Astro.redirect(next.pathname + next.search);
}

const runtime = (Astro.locals as { runtime?: { env?: { TURNSTILE_SITE_KEY?: string } } }).runtime;
const sitekey = runtime?.env?.TURNSTILE_SITE_KEY ?? '0x4AAAAAADHmRrTyQk-jx5-X';

const trustPoints = [
  {
    title: 'NDA締結可',
    body: '社内資料や既存システムの情報を扱う場合は、NDA締結後に詳細を伺えます。',
  },
  {
    title: '要件未確定でも可',
    body: 'RFP、業務フロー、議事録があれば、ユースケースと受入条件へ整理します。',
  },
  {
    title: '進めない判断も可',
    body: '作るべきでない場合は、見送り理由と次に確認すべきことをお伝えします。',
  },
];
---

<Layout
  title="お問い合わせ | Beekle"
  description="Beekleへのお問い合わせページ。要件定義からAI駆動開発まで、業務課題の整理段階からご相談いただけます。初期費用0円のゼロスタート（検証用プロトタイプ）のご相談・お見積もりもこちらから。"
>
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: 'お問い合わせ', url: '/contact' },
      ],
    }}
  />
  <JsonLd
    slot="head"
    type="webPage"
    data={{
      pageType: 'ContactPage',
      name: 'お問い合わせ | Beekle',
      description: 'Beekleへのお問い合わせページ。要件定義からAI駆動開発まで、業務課題の整理段階からご相談いただけます。初期費用0円のゼロスタート（検証用プロトタイプ）のご相談・お見積もりもこちらから。',
      url: 'https://beekle.jp/contact',
    }}
  />
  <Header />
  <main class="bg-neutral-100 pt-20">
    <PageHero
      title="業務課題を相談する"
      subtitle="NDA可。要件未確定でも構いません。通常1〜2営業日以内に、想定構成・概算レンジ・進め方の候補を返信します。"
    />

    <section class="border-b border-neutral-300 bg-neutral-100 py-20 md:py-28">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <div class="grid sm:grid-cols-3 gap-4 mb-10">
            {trustPoints.map((p) => (
              <div class="rounded-lg border border-neutral-200 bg-white p-5">
                <p class="text-sm font-bold text-primary-700 mb-1">{p.title}</p>
                <p class="text-xs text-foreground/70 leading-relaxed">{p.body}</p>
              </div>
            ))}
          </div>

          <div class="mb-8 rounded-lg border border-primary-100 bg-white p-5">
            <p class="text-sm font-semibold text-primary-700 mb-2">相談すると返ってくるもの</p>
            <ul class="space-y-2 text-sm text-foreground/85 leading-relaxed">
              <li>・RFPやAs-Isから起こすべきユースケースの候補</li>
              <li>・AI/RAG/業務システム化に必要なデータ・権限・受入条件の確認点</li>
              <li>・要求、受入条件、確認結果をつなげて仕様変更を追う進め方と概算費用レンジ</li>
              <li>・判断に必要な不足情報と次に確認すること</li>
            </ul>
            <p class="mt-4 text-sm text-foreground/75 leading-relaxed">
              事前に資料で全体像を把握したい場合は
              <a href="/downloads/beekle-zero-start-sales-deck.pdf" download="beekle-zero-start-sales-deck.pdf" class="text-primary-600 font-medium underline hover:no-underline">ゼロスタート開発サービス資料(無料)</a>
              もご利用ください。実例や対象企業がまとまっています。
            </p>
          </div>

          <p class="mb-6 text-sm text-foreground/75 leading-relaxed">
            採用・カジュアル面談のご連絡は
            <a href="/careers/contact" class="text-primary-600 font-medium underline hover:no-underline">採用のお問い合わせ</a>
            からお願いします。
          </p>

          <ContactForm client:load sitekey={sitekey} />

          <details class="mt-8 rounded-lg border border-amber-200 bg-amber-50 p-5 md:p-6">
            <summary class="cursor-pointer font-semibold text-gray-800 list-none flex items-center justify-between">
              <span>営業・売り込み目的のご連絡について</span>
              <span class="text-gray-500 text-sm">クリックで詳細</span>
            </summary>
            <div class="space-y-3 text-sm text-gray-700 mt-4">
              <div>
                <p class="font-semibold text-primary-500 mb-1">歓迎するご提案</p>
                <ul class="list-disc list-inside space-y-1 ml-2">
                  <li>開発パートナーとしての協業</li>
                  <li>当社サービスに関連する技術・ツールのご紹介</li>
                  <li>共同プロジェクトや事業提携のご相談</li>
                </ul>
              </div>
              <div>
                <p class="font-semibold text-red-600 mb-1">お断りしているご連絡</p>
                <ul class="list-disc list-inside space-y-1 ml-2">
                  <li>一方的な営業・セールスメール</li>
                  <li>当社の事業内容と無関係なサービスの売り込み</li>
                  <li>テンプレートを使用した大量送信型の営業メッセージ</li>
                </ul>
                <p class="mt-2 text-gray-500">
                  上記に該当するご連絡には返信いたしかねますので、ご了承ください。
                </p>
              </div>
            </div>
          </details>
        </div>
      </div>
    </section>
  </main>

  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer></script>
</Layout>
