---
// src/pages/company.astro

import { companyInfo, companyPositioning } from '@/data/company';
import Layout from '@/layouts/layout.astro';
import { Header } from '../components/header';
import JsonLd from '../components/seo/json-ld.astro';
import { PageHero } from '../components/ui/page-hero';

const pageDescription = `株式会社Beekleの会社概要。${companyPositioning.short}${companyPositioning.long}自社開発のPM基盤「PM on Rails」を実際の開発プロセスに組み込んでいます。`;
---

<Layout title="会社概要 | Beekle" description={pageDescription}>
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: '会社概要', url: '/company' },
      ],
    }}
  />
  <JsonLd
    slot="head"
    type="webPage"
    data={{
      pageType: 'AboutPage',
      name: '会社概要 | Beekle',
      description: pageDescription,
      url: 'https://beekle.jp/company',
      // このページを会社エンティティの正典ページとして宣言する
      mainEntity: 'organization',
    }}
  />
  <Header />
  <main class="bg-neutral-100 pt-20">
    <!-- Hero Section -->
    <PageHero
      title="会社概要"
      subtitle="Beekleは、業務と課題を整理し、要件を実装可能な仕様へ変換し、その仕様をAIエージェントにつなぐ開発会社です。いきなり大きく作らず、まず動くプロトタイプで確かめ、フィードバックを要件へ戻しながら本開発へ進みます。"
    />

    <!-- About Section -->
    <section class="border-b border-neutral-300 bg-neutral-100 py-24 md:py-28">
      <div class="container mx-auto px-8">
        <div class="max-w-4xl mx-auto prose prose-lg">
          <h2 class="text-2xl font-bold text-gray-800 mb-6">どう開発する会社か</h2>
          <p class="text-gray-600 leading-relaxed mb-8">
            Beekleが提供しているのは「作る作業」ではなく、開発の進め方そのものです。業務と課題を理解して作るべきものを絞り、要求をユーザーストーリー・受入条件・開発タスクへ構造化し、その仕様をAIエージェントにつないで実装します。要件定義から実装・運用までを一つの体制で引き受けるため、工程の間で認識がずれません。
          </p>
          <p class="text-gray-600 leading-relaxed mb-8">
            この構造化と反復を支えているのが、自社開発のPM基盤「<a href="https://pmonrails.com" rel="noopener" class="text-primary-500 font-semibold hover:text-primary-600">PM on Rails</a>」です。要求から実装タスクまでのつながりを記録し、AIが迷わず実装できる状態を作ってからコードを書かせます。
          </p>
          <p class="text-gray-600 leading-relaxed">
            最初に巨大な仕様を固定することはしません。<a href="/prooffirst" class="text-primary-500 font-semibold hover:text-primary-600">ゼロスタート</a>で検証用プロトタイプを作成し、実物を確認してからPoC・MVP・本開発へ進みます。要件が固まっていない段階からのご相談を歓迎します。
          </p>
        </div>
      </div>
    </section>

    <!-- Culture Section -->
    <section class="border-b border-neutral-300 bg-neutral-50 py-24 md:py-28">
      <div class="container mx-auto px-8">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold text-center mb-16">会社のカルチャー</h2>
          <div class="rounded-lg border border-neutral-200 bg-white p-8 md:p-12">
            <p class="text-xl text-gray-700 leading-relaxed text-center italic">
              "言葉で正解を探し続けるより、動くものを見て確かめる。<br />その場に求められる最適解を、物作りの場で出す"
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CEO Profile Section -->
    <section class="border-b border-neutral-300 bg-neutral-100 py-24 md:py-28">
      <div class="container mx-auto px-8">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold text-center mb-16">代表プロフィール</h2>
          <div class="rounded-lg border border-neutral-200 bg-white p-8 md:p-12">
            <h3 class="text-2xl font-bold text-gray-800 mb-6">代表 {companyInfo.representative}</h3>
            <div class="space-y-6 text-gray-600">
              <p>
                株式会社Beekle 代表取締役。フリーランスエンジニアとしてさまざまなシステム開発を経験した後、株式会社Beekleを設立。
              </p>
              <p>
                バックエンド、フロントエンド、インフラまで幅広く開発に携わってきたほか、顧客ヒアリング、要件定義、プロダクトマネジメント、営業・提案、事業設計まで一貫して担当してきた。
              </p>
              <p>
                新規事業では、まだサービスの形が決まっていない段階から、リサーチ、課題整理、要件定義、デザイン、システム開発までを進める0→1のプロジェクトを多数経験。立ち上げ後の改善や運用、内製化支援など、1→100のフェーズにも携わっている。
              </p>
              <p>
                現在は生成AI・RAG・業務システムを中心に、企業のDX・AI活用支援を行う一方、自社でもAIを積極的に実務へ導入している。
              </p>
              <p>
                Cursor cloud agents、Claude CodeやCodexを使ったAI開発だけでなく、AIによるコードレビュー、Gherkinを活用した仕様・テスト管理、営業案件の分析、マーケティングデータ分析、経営・財務分析など、開発から会社経営まで幅広い領域でAIを実際に活用している。
              </p>
              <p>
                また、自社プロダクト「PM on Rails」の開発をはじめ、AI推薦システム、GraphRAGを利用したゲーム、音声・言語系アプリケーションなど、さまざまなAIプロダクトの企画・検証にも取り組んでいる。
              </p>
              <p>
                技術ありきではなく、「顧客が本当に解決したい問題は何か」を整理し、必要であれば既存サービスの活用も含めて、最も現実的な方法を設計することを大切にしている。
              </p>
              <p>
                現在は、AIを活用することで少人数でも高い生産性と品質を実現できる開発・経営の仕組みづくりと、日本発のプロダクトを世界へ展開することを目指している。
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Company Info Section -->
    <section class="border-b border-neutral-300 bg-neutral-50 py-24 md:py-28">
      <div class="container mx-auto px-8">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold text-center mb-16">会社概要</h2>
          <div class="overflow-hidden rounded-lg border border-neutral-200 bg-white">
            <div class="divide-y divide-gray-200">
              {
                Object.entries({
                  会社名: companyInfo.name,
                  法人番号: companyInfo.corporateNumber,
                  設立: companyInfo.established,
                  資本金: companyInfo.capital,
                  代表取締役: companyInfo.representative,
                  所在地: companyInfo.address,
                  メールアドレス: companyInfo.email,
                  休日: companyInfo.holidays,
                }).map(([key, value]) => (
                  <div class="flex py-4 px-6">
                    <dt class="w-40 font-bold text-gray-700">{key}</dt>
                    <dd class="flex-1 text-gray-600">{value}</dd>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Business Description -->
          <div class="mt-12 rounded-lg border border-neutral-200 bg-white p-8">
            <h3 class="text-xl font-bold text-gray-800 mb-6">事業内容</h3>
            <ol class="list-decimal list-inside space-y-4 text-gray-600">
              {
                companyInfo.businessActivities.map((item) => (
                  <li class="leading-relaxed">{item}</li>
                ))
              }
            </ol>
          </div>

          <!-- Advisors -->
          <div class="mt-12 rounded-lg border border-neutral-200 bg-white p-8">
            <h3 class="text-xl font-bold text-gray-800 mb-6">顧問</h3>
            <div class="grid md:grid-cols-2 gap-6">
              {
                Object.entries(companyInfo.advisors).map(([type, name]) => (
                  <div class="flex items-center">
                    <dt class="w-40 font-bold text-gray-700">
                      {type === "tax"
                        ? "税理士"
                        : type === "legal"
                          ? "弁護士"
                          : type === "technical"
                            ? "技術顧問"
                            : "労務顧問"}
                    </dt>
                    <dd class="flex-1 text-gray-600">{name}</dd>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="relative py-20 md:py-24 overflow-hidden bg-navy-950">
      <div class="container mx-auto px-8 text-center relative">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
          まずは、業務課題からお聞かせください。
        </h2>
        <p class="text-lg text-white/90 mb-8">
          要件が固まっていない段階でも大丈夫です。初回相談・簡易デモは無料で、PoCは別途範囲を定義します。
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact?source=company-final"
            data-cta-source="company-final"
            data-cta-id="contact"
            class="page-cta inline-flex min-h-[52px] items-center justify-center rounded-md bg-white px-8 py-4 text-lg font-semibold text-accent-950 transition-colors hover:bg-neutral-100"
          >
            業務課題を相談する
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="/prooffirst"
            class="inline-flex min-h-[52px] items-center justify-center rounded-md border border-white bg-transparent px-8 py-4 text-lg font-semibold text-white transition-colors hover:bg-white hover:text-accent-950"
          >
            ゼロスタートを見る
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
