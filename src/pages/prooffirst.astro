---
import { Header } from '../components/header';
import JsonLd from '../components/seo/json-ld.astro';
import { ButtonLink } from '../components/ui/button';
import Layout from '../layouts/layout.astro';

const proofRows = [
  ['確認すること', '業務適合 / データ / 利用者反応 / 投資判断'],
  ['作るもの', 'コア機能に絞った検証用プロトタイプ'],
  ['返すもの', '触った結果、受入条件、概算レンジ、見送り条件'],
  ['含まないもの', '本番品質の作り込み、全データ投入、保守運用'],
];

const processRows = [
  {
    no: '01',
    title: '相談・NDA確認',
    customer: '課題、既存資料、使える範囲のデータを共有',
    beekle: '検証すべき問いと対象業務を整理',
    decision: '何を確かめれば社内判断できるか',
  },
  {
    no: '02',
    title: '検証用プロトタイプ',
    customer: '代表ケースで触り、違和感や不足を共有',
    beekle: 'コア機能に絞って動くものを作る',
    decision: '実物でズレ、データ不足、運用負荷を見る',
  },
  {
    no: '03',
    title: '投資条件の整理',
    customer: '社内で投資判断を行う',
    beekle: '見積もり範囲、残るリスク、見送り理由を返す',
    decision: 'PoC・MVP・本開発のどこから始めるか、見送り条件は何か',
  },
];

const fitItems = [
  '要件が固まりきらず、見積もり比較に進めない',
  'AIや業務システムが自社に合うか実物で見たい',
  '上長・情シス・現場へ、資料だけでは説明しきれない',
  '本開発前に、作らない判断も含めて確認したい',
];

const faqItems = [
  {
    question: '無料相談とPoCの範囲はどこで分かれますか？',
    answer:
      '初回相談・簡易デモは費用をいただきません。実データ連携、個別業務フロー、精度検証、セキュリティ要件を含むPoCは、目的・範囲・判断基準を整理したうえで別途ご提案します。',
  },
  {
    question: '作ったものはそのまま本番化できますか？',
    answer:
      '検証用プロトタイプは判断材料です。そのまま本番運用する前提では作りません。本番化する場合は、権限、ログ、データ移行、セキュリティ、運用設計を別途確認します。',
  },
  {
    question: '相談前にNDAは締結できますか？',
    answer:
      '可能です。初回は公開できる範囲で相談し、機密資料や顧客情報が必要になった段階でNDA締結後に確認します。',
  },
  {
    question: '見送り条件が出た場合はどうなりますか？',
    answer:
      '開発を無理に勧めません。データ不足、利用者不在、投資根拠不足など、見送り理由と次に確認すべき条件を残します。',
  },
];
---

<Layout
  title="本開発前に動くプロトタイプで確かめる｜ゼロスタート | Beekle"
  description="ゼロスタートは、本開発の前に検証用プロトタイプを作り、業務適合・要件・データ・利用者の反応を実物で確認するBeekleの開発入口です。"
>
  <JsonLd
    slot="head"
    type="service"
    data={{
      serviceName: 'ゼロスタート（Zero Start）',
      serviceDescription:
        '本開発の前に検証用プロトタイプを作り、業務適合・要件・データ・利用者の反応を実物で確認する開発の入口。',
      url: 'https://beekle.jp/prooffirst',
      serviceType: 'システム開発プロトタイプ作成',
    }}
  />
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: 'ゼロスタート', url: '/prooffirst' },
      ],
    }}
  />
  <Header />

  <main class="bg-neutral-100 pt-20">
    <section class="border-b border-neutral-300 bg-neutral-100 py-14 md:py-20">
      <div class="container mx-auto grid gap-10 px-8 lg:grid-cols-[0.9fr_0.85fr] lg:items-end lg:px-12">
        <div>
          <p class="border-l-8 border-primary-500 pl-5 text-sm font-bold text-primary-700">
            ゼロスタート
          </p>
          <h1 class="mt-6 max-w-4xl text-4xl font-bold leading-[1.08] text-accent-950 [word-break:keep-all] sm:text-5xl md:text-6xl">
            本開発の前に、
            <br />
            動くもので確かめる。
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-neutral-700 md:text-xl">
            相談内容を検証用プロトタイプに落とし込み、業務に合うか、次に投資する条件があるかを判断できる状態にします。
          </p>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
            <ButtonLink
              href="/contact?source=prooffirst-hero"
              data-cta-source="prooffirst-hero"
              data-cta-id="contact"
              variant="primary"
              size="lg"
            >
              実物で判断できるか相談する
            </ButtonLink>
            <a href="/case-studies" class="inline-flex min-h-[48px] items-center border-b border-accent-950 text-sm font-semibold text-accent-950 hover:border-primary-500 hover:text-primary-500">
              実案件の変化を見る
            </a>
          </div>
          <p class="mt-5 text-sm leading-relaxed text-neutral-600">
            NDA可。要件未確定でも可。見送り条件がある場合も、理由を残します。
          </p>
        </div>

        <aside class="border-y border-neutral-300 bg-white">
          <div class="border-b border-neutral-300 border-l-8 border-primary-500 px-5 py-4">
            <p class="text-sm font-bold text-primary-700">検証前ドラフト</p>
            <p class="mt-1 text-2xl font-bold leading-tight text-accent-950">
              投資条件の判断メモ
            </p>
          </div>
          <dl class="divide-y divide-neutral-300">
            {proofRows.map(([label, value]) => (
              <div class="grid gap-3 px-5 py-4 md:grid-cols-[112px_1fr]">
                <dt class="text-sm font-bold text-primary-700">{label}</dt>
                <dd class="text-base font-bold leading-relaxed text-accent-950">{value}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </section>

    <section class="bg-neutral-50 py-14 md:py-16">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
          <div>
            <p class="text-sm font-bold text-primary-500">向いている相談</p>
            <h2 class="mt-3 text-3xl font-bold leading-tight text-accent-950 md:text-4xl">
              見積もり前に、確かめる問いを決める。
            </h2>
          </div>
          <div class="border-t border-neutral-300">
            {fitItems.map((item) => (
              <div class="border-b border-neutral-300 py-5">
                <p class="text-lg font-bold leading-snug text-accent-950">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-neutral-100 py-14 md:py-16">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="max-w-3xl">
          <p class="text-sm font-bold text-primary-500">進め方</p>
          <h2 class="mt-3 text-3xl font-bold leading-tight text-accent-950 md:text-4xl">
            相談から、次の投資条件の整理まで
          </h2>
        </div>

        <div class="mt-8 border-t border-neutral-300">
          {processRows.map((row) => (
            <div class="grid gap-5 border-b border-neutral-300 py-6 lg:grid-cols-[80px_0.8fr_1fr_1fr_1fr]">
              <p class="font-Poppins text-2xl font-bold text-primary-500">{row.no}</p>
              <h3 class="text-xl font-bold leading-snug text-accent-950">{row.title}</h3>
              <p class="text-sm leading-relaxed text-neutral-700">
                <span class="font-bold text-primary-700">お客様: </span>{row.customer}
              </p>
              <p class="text-sm leading-relaxed text-neutral-700">
                <span class="font-bold text-primary-700">Beekle: </span>{row.beekle}
              </p>
              <p class="text-sm font-bold leading-relaxed text-accent-950">{row.decision}</p>
            </div>
          ))}
        </div>

        <div class="mt-10 border-l-8 border-primary-500 bg-white px-6 py-6">
          <p class="text-sm font-bold text-primary-700">実案件</p>
          <h3 class="mt-2 text-xl font-bold leading-snug text-accent-950">
            ヒアリング議事録から、その日のうちに動くデモまで
          </h3>
          <p class="mt-3 leading-relaxed text-neutral-700">
            構想段階で要件が言語化されていない状態から、議事録をもとにRFP（提案依頼書）を作り、その仕様で実装しました。1日で動作するデモを完成させ、画面を見ながら認識を合わせています。発注者からは「イメージとずれていない」と評価いただき、以降の打ち合わせを認識合わせではなく中身の検討に使えました。
          </p>
          <p class="mt-4 text-sm leading-relaxed text-neutral-700">
            他にも、LINE上でタップするだけのプロトタイプで操作感を確かめてから本開発へ進み、約2ヶ月でリリースした案件（実サービスとして公開中）や、2週間の試作で発注範囲と要件を確定した案件があります。
          </p>
          <a
            href="/case-studies"
            class="mt-5 inline-flex min-h-[44px] items-center text-sm font-bold text-primary-600 hover:text-primary-700"
          >
            他の事例を見る →
          </a>
        </div>
      </div>
    </section>

    <section class="bg-neutral-50 py-14 md:py-16">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
          <div>
            <p class="text-sm font-bold text-primary-500">FAQ</p>
            <h2 class="mt-3 text-3xl font-bold leading-tight text-accent-950 md:text-4xl">
              始める前に確認したいこと
            </h2>
          </div>
          <div class="border-t border-neutral-300">
            {faqItems.map((item) => (
              <details class="border-b border-neutral-300 py-5">
                <summary class="cursor-pointer list-none text-lg font-bold text-accent-950 [&::-webkit-details-marker]:hidden">
                  {item.question}
                </summary>
                <p class="mt-3 text-sm leading-relaxed text-neutral-700">{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-accent-950 py-16 md:py-20">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="max-w-3xl">
          <h2 class="text-3xl font-bold leading-tight text-white md:text-5xl">
            まず動くもので、次の投資条件を決めてください。
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-white/85">
            要件が未確定でも、検証すべき業務と見送り条件から整理できます。
          </p>
          <div class="mt-8">
            <ButtonLink
              href="/contact?source=prooffirst-final"
              data-cta-source="prooffirst-final"
              data-cta-id="contact"
              variant="white"
              size="lg"
            >
              実物で判断できるか相談する
            </ButtonLink>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
