---
import { Header } from '../components/header';
import JsonLd from '../components/seo/json-ld.astro';
import { ButtonLink } from '../components/ui/button';
import Layout from '../layouts/layout.astro';

const proofItems = [
  {
    label: '難航案件の立て直し',
    value: '3ヶ月停滞 → 3週間',
    text: '止まっていた開発を、要件・実装・インフラまで読み直して動く状態へ。',
  },
  {
    label: '発注前の認識合わせ',
    value: '議事録 → デモ1日',
    text: 'ヒアリング内容を、画面で確認できるプロトタイプまで落とし込み。',
  },
  {
    label: '新規事業の検証',
    value: '1週間で触れる形へ',
    text: '構想、画面、API、インフラを分断せず、判断できる状態まで前進。',
  },
];

const decisionMaterials = [
  {
    title: '確かめる業務',
    text: '要望リストではなく、誰のどの作業を軽くするかに絞ります。',
  },
  {
    title: '検証用プロトタイプ',
    text: '資料だけで合意せず、画面やデモで認識差を早く見つけます。',
  },
  {
    title: '投資条件と見送り条件',
    text: '次に投資する範囲、見送り理由、次に必要な条件を分けて残します。',
  },
];

const methodSteps = [
  {
    no: '01',
    title: '業務の問いを絞る',
    text: '現場の困りごと、意思決定者の目的、既存データの状態を分けます。',
  },
  {
    no: '02',
    title: '動くものにする',
    text: '画面、デモ、受入条件へ落とし、文章だけでは出ないズレを見ます。',
  },
  {
    no: '03',
    title: '要件へ戻す',
    text: 'フィードバックを口頭で終わらせず、優先順位と完成条件へ戻します。',
  },
  {
    no: '04',
    title: '次の投資判断へつなぐ',
    text: '本開発へ投資する、追加検証する、いったん見送る、を決められる材料にします。',
  },
];

const fitItems = [
  '要件が固まらず、見積もりや社内合意が進まない',
  'AI導入を任されたが、どの業務から始めるか決められない',
  'Excel、メール、担当者の記憶に業務が散らばっている',
  '他社で進まなくなった開発を立て直したい',
];

const cautionItems = [
  '24時間監視や大規模常駐体制が最初から必須',
  '作るものが完全に決まっており、単純な人月比較だけをしたい',
  '社内で触れるデータや決裁者をまったく出せない',
];

const faqItems = [
  {
    question: 'まだ要件が決まっていなくても相談できますか？',
    answer:
      'できます。むしろ要件が固まる前に、業務・利用者・受入条件を整理して、何を確かめるべきかを決めます。',
  },
  {
    question: '開発しない方がよい場合もありますか？',
    answer:
      'あります。データが足りない、対象業務が狭すぎる、投資判断の根拠が弱い場合は、先に見送り理由を出します。',
  },
  {
    question: '仕様変更の影響はどう追いますか？',
    answer:
      '要求、受入条件、実装タスク、確認結果を同じ流れで残します。裏側ではPM on Railsを使い、なぜその仕様になったか、変更時にどこへ影響するかを追えるようにしています。',
  },
  {
    question: 'PM on Railsとは何ですか？',
    answer:
      'Beekleが自社開発しているPM基盤です。要求、受入条件、実装タスク、確認結果をつなぎ、仕様変更やフィードバックがどの画面・タスク・確認観点に影響するかを追えるようにするために使います。名前を覚えてもらうためではなく、発注後に説明し直しが起きにくい進め方の土台です。',
  },
];
---

<Layout
  title="Beekleの進め方｜発注判断の材料まで作る | Beekle"
  description="Beekleの進め方。要件が曖昧な相談を、検証用プロトタイプ、受入条件、投資条件と見送り条件まで整理します。"
>
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: 'Beekleの進め方', url: '/strengths' },
      ],
    }}
  />
  <JsonLd
    slot="head"
    type="webPage"
    data={{
      pageType: 'AboutPage',
      name: 'Beekleの進め方｜発注判断の材料まで作る | Beekle',
      description:
        'Beekleの進め方。要件が曖昧な相談を、検証用プロトタイプ、受入条件、投資条件と見送り条件まで整理します。',
      url: 'https://beekle.jp/strengths',
    }}
  />
  <Header />

  <main class="bg-neutral-100 pt-20">
    <section class="border-b border-neutral-300 bg-neutral-100 py-14 md:py-20">
      <div class="container mx-auto grid gap-10 px-8 lg:grid-cols-[0.9fr_0.85fr] lg:items-end lg:px-12">
        <div>
          <p class="border-l-8 border-primary-500 pl-5 text-sm font-bold text-primary-700">
            Beekleの進め方
          </p>
          <h1 class="mt-6 max-w-4xl text-4xl font-bold leading-[1.08] text-accent-950 sm:text-5xl md:text-6xl">
            要件が曖昧でも、<br />
            発注判断の材料まで<br />
            作ります。
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-neutral-700">
            動くプロトタイプ、受入条件、概算レンジを揃え、開発前に社内で判断できる状態にします。
          </p>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
            <ButtonLink
              href="/contact?source=strengths-hero"
              data-cta-source="strengths-hero"
              data-cta-id="contact"
              variant="primary"
              size="lg"
            >
              実現可否を相談する
            </ButtonLink>
            <a href="/case-studies" class="inline-flex min-h-[48px] items-center border-b border-accent-950 text-sm font-semibold text-accent-950 hover:border-primary-500 hover:text-primary-500">
              実案件の変化を見る
            </a>
          </div>
          <p class="mt-5 text-sm leading-relaxed text-neutral-600">
            NDA可。要件未確定でも可。見送り条件がある場合も、開発前に理由を残します。
          </p>
          <div class="mt-6 border-y border-neutral-300 bg-white px-4 py-4 md:hidden">
            <p class="text-sm font-bold text-primary-500">実案件ログ</p>
            <p class="mt-2 text-base font-bold leading-relaxed text-accent-950">
              3ヶ月停滞 → 3週間 / 議事録 → デモ1日
            </p>
          </div>
        </div>

        <div class="case-log-table hidden border-t border-neutral-300 md:block">
          <p class="border-b border-neutral-300 py-3 text-sm font-bold text-primary-700">実案件ログ</p>
          {proofItems.map((item) => (
            <a href="/case-studies" class="grid gap-2 border-b border-neutral-300 py-4 transition hover:bg-neutral-50 md:grid-cols-[0.7fr_0.8fr] md:px-2">
              <p class="text-sm font-bold text-primary-700">{item.label}</p>
              <div>
                <p class="text-2xl font-bold leading-tight text-primary-500">{item.value}</p>
                <p class="mt-2 text-sm leading-relaxed text-neutral-700">{item.text}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-neutral-50 py-14 md:py-16">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
          <div>
            <p class="text-sm font-bold text-primary-500">発注前に残すもの</p>
            <h2 class="mt-3 text-3xl font-bold leading-tight text-accent-950 md:text-4xl">
              発注判断シート
            </h2>
            <p class="mt-4 text-base leading-relaxed text-neutral-700">
              サービス名や技術名を決める前に、社内で合意しやすい材料へ変換します。
            </p>
          </div>

          <div class="decision-sheet-table border-y border-neutral-300 bg-white">
            <div class="border-b border-neutral-300 border-l-8 border-primary-500 px-5 py-4">
              <p class="text-sm font-bold text-primary-700">BEEKLE / 発注判断</p>
              <p class="mt-1 text-xl font-bold leading-snug text-accent-950">
                投資条件と見送り条件を同じ紙面に置く
              </p>
            </div>
            {decisionMaterials.map((item, index) => (
              <div class="grid gap-3 border-b border-neutral-300 px-5 py-5 last:border-b-0 md:grid-cols-[112px_1fr]">
                <p class="font-Poppins text-sm font-bold text-primary-600">
                  {String(index + 1).padStart(2, '0')}
                </p>
                <div>
                  <h3 class="text-xl font-bold leading-snug text-accent-950">{item.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-neutral-700">{item.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-neutral-100 py-14 md:py-16">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
          <div>
            <p class="text-sm font-bold text-primary-500">Beekleの作り方</p>
            <h2 class="mt-3 text-3xl font-bold leading-tight text-accent-950 md:text-4xl">
              変更に強い理由
            </h2>
            <p class="mt-4 text-base leading-relaxed text-neutral-700">
              要件定義を先に完成させようとせず、短く動くものを出し、そこで見えたズレを要件へ戻します。
            </p>
            <p class="mt-6 border-l-4 border-primary-500 pl-5 text-sm leading-relaxed text-neutral-700">
              <a href="https://pmonrails.com" rel="noopener" class="font-bold text-primary-500 hover:text-primary-600">PM on Rails</a>で、要求・受入条件・実装タスク・確認結果をつなげています。名前を覚えてもらうためではなく、仕様が変わったときに影響を追うための基盤です。
            </p>
          </div>

          <div class="border-t border-neutral-300">
            {methodSteps.map((step) => (
              <div class="grid gap-4 border-b border-neutral-300 py-5 md:grid-cols-[72px_1fr]">
                <p class="font-Poppins text-2xl font-bold text-primary-500">{step.no}</p>
                <div>
                  <h3 class="text-xl font-bold leading-snug text-accent-950">{step.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-neutral-700">{step.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-neutral-50 py-14 md:py-16">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="max-w-3xl">
          <p class="text-sm font-bold text-primary-500">相談の相性</p>
          <h2 class="mt-3 text-3xl font-bold leading-tight text-accent-950 md:text-4xl">
            この進め方が向いている相談
          </h2>
          <p class="mt-4 text-base leading-relaxed text-neutral-700">
            何でも作る前提ではなく、判断材料が足りない段階の相談に向いています。
          </p>
        </div>

        <div class="mt-8 grid gap-8 border-y border-neutral-300 py-6 lg:grid-cols-2">
          <div>
            <h3 class="text-2xl font-bold text-accent-950">向いています</h3>
            <ul class="mt-5 space-y-3">
              {fitItems.map((item) => (
                <li class="border-l-2 border-secondary-500 pl-4 text-sm leading-relaxed text-neutral-700">
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h3 class="text-2xl font-bold text-accent-950">先に確認します</h3>
            <ul class="mt-5 space-y-3">
              {cautionItems.map((item) => (
                <li class="border-l-2 border-highlight-500 pl-4 text-sm leading-relaxed text-neutral-700">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-neutral-100 py-14 md:py-16">
      <div class="container mx-auto px-8 lg:px-12">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
          <div>
            <p class="text-sm font-bold text-primary-500">FAQ</p>
            <h2 class="mt-3 text-3xl font-bold leading-tight text-accent-950 md:text-4xl">
              よくあるご不安
            </h2>
          </div>
          <div class="border-t border-neutral-300">
            {faqItems.map((item) => (
              <details class="border-b border-neutral-300 py-5">
                <summary class="cursor-pointer list-none text-lg font-bold text-accent-950 [&::-webkit-details-marker]:hidden">
                  {item.question}
                </summary>
                <p class="mt-3 text-sm leading-relaxed text-neutral-700">{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-primary-500 py-16 md:py-20">
      <div class="container mx-auto px-8 text-center lg:px-12">
        <h2 class="text-3xl font-bold leading-tight text-white md:text-5xl">
          作る前に、ズレと進め方を確認しませんか
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-white/90">
          要件が固まりきっていない段階でも、業務・利用者・受入条件を整理し、社内判断に使える材料を作れます。
        </p>
        <div class="mt-8 flex flex-col items-center gap-4">
          <ButtonLink
            href="/contact?source=strengths-final"
            data-cta-source="strengths-final"
            data-cta-id="contact"
            variant="white"
            size="lg"
          >
            実現可否を相談する
          </ButtonLink>
          <a href="/case-studies" class="inline-flex min-h-[44px] items-center text-sm font-semibold text-white underline-offset-4 hover:underline">
            実案件の変化を見る
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
