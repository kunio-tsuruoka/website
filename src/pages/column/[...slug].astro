---
import { Renderer, marked } from 'marked';
import { Header } from '../../components/header';
import AuthorByline from '../../components/seo/author-byline.astro';
import JsonLd from '../../components/seo/json-ld.astro';
import { categoryReviewerMap, slugReviewerMap } from '../../data/authors';
import Layout from '../../layouts/layout.astro';
import { getCategoryCta } from '../../lib/column-cta-mapping';
import { columnRedirects } from '../../lib/column-redirects';
import { renderColumnVisuals } from '../../lib/column-visuals';
import {
  type MicroCMSEnv,
  getColumn,
  getPillarSlug,
  getRelatedColumns,
  isPillarArticle,
} from '../../lib/microcms';
import { upgradeRequirementsContent } from '../../lib/requirements-content-upgrades.js';
import { type TocItem, slugify } from '../../lib/toc';

// SSR: リクエスト時にMicroCMSから取得
export const prerender = false;
const { slug } = Astro.params;
const columnId = slug as string;

// SEOカニバリ統合: 旧スラッグから統合先へ301リダイレクト
if (columnId in columnRedirects) {
  return Astro.redirect(columnRedirects[columnId], 301);
}

// Cloudflare Pages SSR: ランタイム環境変数を取得
const runtime = (Astro.locals as { runtime?: { env?: MicroCMSEnv } }).runtime;
const env = runtime?.env;

// MicroCMSから記事を取得
const column = await getColumn(columnId, env);

const isKnowledge = column?.category?.id === 'knowledge';

if (!column) {
  return Astro.redirect('/404');
}

// 要件定義系の既存SEO記事はslug/title/description/categoryを維持したまま、
// 本文の思想と一次情報だけを現在のBeekle実務へ更新する。
// MicroCMS側へ同内容を移行した後も変換は冪等になるようにしている。
column.content = upgradeRequirementsContent(columnId, column.content || '');

// 目次データを収集しながらHTMLを生成するカスタムレンダラー
const toc: TocItem[] = [];
const renderer = new Renderer();

renderer.heading = ({ text, depth }) => {
  // h2, h3のみ目次に追加
  if (depth === 2 || depth === 3) {
    const id = slugify(text);
    toc.push({ id, text, level: depth });
    // FAQ見出し（Q1. Q2. など）を検出して専用クラスを付与
    const faqMatch = text.match(/^Q(\d+)\.\s*(.*)/);
    if (faqMatch && depth === 2) {
      const qNum = faqMatch[1];
      const qText = faqMatch[2];
      return `<div class="faq-item"><h${depth} id="${id}" class="faq-question"><span class="faq-badge">Q${qNum}</span><span class="faq-text">${qText}</span></h${depth}>`;
    }
    return `<h${depth} id="${id}">${text}</h${depth}>`;
  }
  return `<h${depth}>${text}</h${depth}>`;
};

// チェックボックス記法を自動変換
renderer.listitem = ({ text, task, checked }) => {
  // GFMタスクリスト（- [ ] / - [x]）
  if (task) {
    const className = checked ? 'checkbox checked' : 'checkbox unchecked';
    const cleanText = text.replace(/<input[^>]*>/, '').trim();
    return `<li class="${className}">${cleanText}</li>\n`;
  }

  // MicroCMS形式: テキストが [ ] や [x] で始まる場合も変換（•ビュレット付きも対応）
  const checkboxMatch = text.match(/^[•・]?\s*\[([xX\s]?)\]\s*/);
  if (checkboxMatch) {
    const isChecked = checkboxMatch[1].toLowerCase() === 'x';
    const className = isChecked ? 'checkbox checked' : 'checkbox unchecked';
    const cleanText = text.replace(/^[•・]?\s*\[[xX\s]?\]\s*/, '').trim();
    return `<li class="${className}">${cleanText}</li>\n`;
  }

  return `<li>${text}</li>\n`;
};

// Markedの設定
marked.setOptions({
  breaks: true,
  gfm: true,
});
marked.use({ renderer });

let htmlContent = marked(column.content || '') as string;

// HTML直書きの<h2>/<h3>からも目次データを収集する（リッチエディタHTML対応）。
// MicroCMSサニタイザは見出しに id="h..." を自動付与するため、属性付き見出しもマッチさせる。
// {{MARKER}} 置換前に走らせ、差し込みビジュアル内の見出しが目次に混ざらないようにする。
htmlContent = htmlContent.replace(
  /<h([23])([^>]*)>([\s\S]*?)<\/h\1>/g,
  (match, level, attrs, inner) => {
    const depth = Number(level);
    const text = inner.replace(/<[^>]*>/g, '').trim();
    if (!text) return match;
    const existingId = attrs.match(/\bid="([^"]+)"/)?.[1];
    const id = existingId ?? slugify(text);
    if (!toc.some((item) => item.id === id)) {
      toc.push({ id, text, level: depth });
    }
    return existingId ? match : `<h${depth} id="${id}"${attrs}>${inner}</h${depth}>`;
  }
);

// 記事内の {{MARKER}} ビジュアルプレースホルダーを差し込みHTMLに置換
// CONTACT_CTA / CONTACT_CTA_MID は記事固有 source で動的生成
htmlContent = renderColumnVisuals(htmlContent, { source: `column-${columnId}` });

// CTA pill 化: <p> 内が空白＋単独 <a href="/contact..."> のみのときだけ cv-cta-button クラスを付与する。
// CSS の :only-child は要素兄弟しか見ないため、テキストに挟まれた inline link も誤マッチしてしまう（FAQ 内の
// 「Beekleの<a href="/prooffirst">ゼロスタート</a>」のような表現がピル化される）。post-process で <p>↔<a>↔</p>
// の間に他テキストが無いケースに限定してクラスを付ける。
htmlContent = htmlContent.replace(
  /<p>\s*<a\s+href="(\/contact[^"]*)"([^>]*)>([\s\S]*?)<\/a>\s*<\/p>/g,
  (_match, href, attrs, inner) =>
    `<p><a href="${href}"${attrs} class="cv-cta-button">${inner}</a></p>`
);

// MicroCMS content can contain both markdown and raw HTML headings. At this point,
// any raw headings have been collected into toc above, while markdown headings were
// collected via the custom renderer.

// H2を基準に本文を自動セクション分割し、長文記事の可読性を上げる。
// FAQ wrapper（.faq-item）の途中でdivをまたがないよう、FAQ開始後は section wrapping を止める。
let sectionIndex = 0;
let seenFaq = false;
htmlContent = htmlContent.replace(/<h2\b[^>]*>[\s\S]*?<\/h2>/g, (heading) => {
  const text = heading.replace(/<[^>]+>/g, '').trim();
  if (/^Q\d+\./.test(text)) seenFaq = true;
  if (seenFaq) return heading;
  sectionIndex += 1;
  return `${sectionIndex === 1 ? '' : '</section>'}<section class="column-section">${heading}`;
});
if (sectionIndex > 0 && !seenFaq) htmlContent += '</section>';

// 外部リンクには rel 属性を付与（既存relは保持）
htmlContent = htmlContent.replace(
  /<a\s+([^>]*href=["']https?:\/\/[^>]+)>/gi,
  (match, attrs) => {
    if (/\brel=/.test(attrs)) return match;
    return `<a ${attrs} rel="noopener noreferrer">`;
  }
);

// CTA, FAQ, embedded widgets etc are rendered from the transformed HTML below.

// FAQデータを抽出（JSON-LD用）
const faqItems = [];
const faqRegex = /<h3[^>]*>\s*(Q\.?\s*\d+\.?\s*[^<]*)<\/h3>\s*<p[^>]*>([\s\S]*?)<\/p>/gi;
let faqMatch;
while ((faqMatch = faqRegex.exec(column.content || '')) !== null) {
  const question = htmlToPlainText(faqMatch[1]);
  const answer = htmlToPlainText(faqMatch[2]);
  if (question && answer) faqItems.push({ question, answer });
}

function htmlToPlainText(value: string) {
  return value
    .replace(/<br\s*\/?\s*>/gi, ' ')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}

const categoryId = column.category?.id;
const categoryTitle = column.category?.title ?? 'コラム';
const relatedColumns = categoryId ? await getRelatedColumns(columnId, categoryId, 8, env) : [];
const pillarSlug = categoryId ? getPillarSlug(categoryId) : undefined;
const categoryCta = getCategoryCta(categoryId);
const reviewer = slugReviewerMap[columnId] ?? (categoryId ? categoryReviewerMap[categoryId] : undefined);
const author = {
  name: '鶴岡邦夫',
  profile: '/company/member/kunio-tsuruoka',
};
const siteUrl = 'https://beekle.jp';
const sectionPath = isKnowledge ? 'knowledge' : 'column';
const articleUrl = `${siteUrl}/${sectionPath}/${columnId}`;
const categoryUrl = isKnowledge ? '/knowledge' : '/column';
const title = `${column.title} | Beekle`;
const description = column.description || `${column.title}について、Beekleが実務経験をもとに解説します。`;
const publishedTime = column.publishedAt;
const modifiedTime = column.revisedAt || column.updatedAt;
const isPillar = isPillarArticle(columnId);
---

<Layout
  title={title}
  description={description}
  canonical={articleUrl}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
>
  <JsonLd
    type="Article"
    data={{
      headline: column.title,
      description,
      datePublished: publishedTime,
      dateModified: modifiedTime,
      url: articleUrl,
      author,
      reviewer,
    }}
  />
  {faqItems.length > 0 && <JsonLd type="FAQPage" data={faqItems} />}
  <Header client:load />

  <main class="column-page">
    <div class="column-container">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">ホーム</a>
        <span>/</span>
        <a href={categoryUrl}>{isKnowledge ? 'ナレッジ' : 'コラム'}</a>
        <span>/</span>
        <span>{column.title}</span>
      </nav>

      <article class:list={['column-article', { 'pillar-article': isPillar }]}>
        <header class="article-header">
          <h1>{column.title}</h1>
          <AuthorByline
            publishedAt={column.publishedAt}
            updatedAt={column.updatedAt}
            revisedAt={column.revisedAt}
            reviewerId={reviewer?.id}
          />
        </header>

        {
          toc.length > 0 && (
            <nav class="toc" aria-label="目次">
              <div class="toc-title">目次</div>
              <ul>
                {toc.map((item) => (
                  <li class:list={[`toc-level-${item.level}`]}>
                    <a href={`#${item.id}`}>{item.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <div class="article-content" set:html={htmlContent} />

        <AuthorByline
          publishedAt={column.publishedAt}
          updatedAt={column.updatedAt}
          revisedAt={column.revisedAt}
          reviewerId={reviewer?.id}
          variant="full"
        />

        {
          pillarSlug && pillarSlug !== columnId && (
            <aside class="pillar-link">
              <a href={`/column/${pillarSlug}`}>
                <span class="pillar-link-label">このテーマの全体像を知る</span>
                <span class="pillar-link-title">
                  {categoryTitle} 完全ガイド｜発注側のプロジェクト管理
                </span>
              </a>
            </aside>
          )
        }

        {
          relatedColumns.length > 0 && (
            <section class="related-columns">
              <h2>関連記事</h2>
              <p>「{categoryTitle}」カテゴリの他の記事</p>
              <div class="related-grid">
                {relatedColumns.map((related) => (
                  <a
                    class="related-card"
                    href={`/${related.category?.id === 'knowledge' ? 'knowledge' : 'column'}/${related.id}`}
                  >
                    <span class="related-title">{related.title}</span>
                    <span class="related-date">
                      {new Date(related.publishedAt).toLocaleDateString('ja-JP')}
                    </span>
                    <span class="related-read">読む →</span>
                  </a>
                ))}
              </div>
              <a class="related-more" href={categoryUrl}>
                「{categoryTitle}」の記事をすべて見る
              </a>
            </section>
          )
        }
      </article>

      <a class="back-link" href={categoryUrl}>
        ← {isKnowledge ? 'ナレッジ一覧' : 'コラム一覧'}に戻る
      </a>
    </div>
  </main>

  {
    categoryCta && (
      <section class="column-category-cta">
        <div class="column-category-cta-inner">
          <p class="column-category-cta-eyebrow">{categoryCta.eyebrow}</p>
          <h2>{categoryCta.title}</h2>
          <p>{categoryCta.description}</p>
          <div class="column-category-cta-actions">
            <a
              class="column-category-cta-primary"
              href={`${categoryCta.primaryHref}${categoryCta.primaryHref.includes('?') ? '&' : '?'}source=column-${columnId}`}
            >
              {categoryCta.primaryLabel}
            </a>
            {categoryCta.secondaryHref && categoryCta.secondaryLabel && (
              <a class="column-category-cta-secondary" href={categoryCta.secondaryHref}>
                {categoryCta.secondaryLabel}
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }
</Layout>

<style>
  .column-page {
    min-height: 100vh;
    background: var(--color-surface, #fff);
    padding: 8rem 1.5rem 4rem;
  }

  .column-container {
    max-width: 1180px;
    margin: 0 auto;
  }

  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
    color: #64748b;
    font-size: 0.875rem;
    margin-bottom: 2rem;
  }

  .breadcrumb a {
    color: #475569;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .column-article {
    max-width: 860px;
    margin: 0 auto;
  }

  .article-header {
    margin-bottom: 2.25rem;
  }

  .article-header h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
    margin: 0 0 1.25rem;
    color: #0f172a;
  }

  .toc {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
    margin: 0 0 2.5rem;
  }

  .toc-title {
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.75rem;
  }

  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.45rem;
  }

  .toc li {
    margin: 0;
  }

  .toc-level-3 {
    padding-left: 1rem;
    font-size: 0.925rem;
  }

  .toc a {
    color: #334155;
    text-decoration: none;
  }

  .toc a:hover {
    color: #0f766e;
    text-decoration: underline;
  }

  :global(.article-content) {
    color: #1e293b;
    font-size: 1.05rem;
    line-height: 1.9;
  }

  :global(.article-content h2) {
    margin: 3.25rem 0 1.25rem;
    padding-top: 0.35rem;
    font-size: 1.75rem;
    line-height: 1.4;
    color: #0f172a;
  }

  :global(.article-content h3) {
    margin: 2.25rem 0 0.9rem;
    font-size: 1.35rem;
    line-height: 1.5;
    color: #0f172a;
  }

  :global(.article-content h4) {
    margin: 1.75rem 0 0.75rem;
    font-size: 1.15rem;
    color: #0f172a;
  }

  :global(.article-content p) {
    margin: 1rem 0;
  }

  :global(.article-content ul),
  :global(.article-content ol) {
    padding-left: 1.5rem;
    margin: 1rem 0;
  }

  :global(.article-content li) {
    margin: 0.45rem 0;
  }

  :global(.article-content a) {
    color: #0f766e;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  :global(.article-content pre) {
    overflow-x: auto;
    background: #0f172a;
    color: #e2e8f0;
    border-radius: 0.8rem;
    padding: 1.1rem 1.25rem;
    margin: 1.25rem 0;
  }

  :global(.article-content code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
    font-size: 0.92em;
  }

  :global(.article-content :not(pre) > code) {
    background: #f1f5f9;
    color: #0f172a;
    padding: 0.15em 0.35em;
    border-radius: 0.3rem;
  }

  :global(.article-content blockquote) {
    border-left: 4px solid #14b8a6;
    margin: 1.5rem 0;
    padding: 0.75rem 1.1rem;
    background: #f0fdfa;
    color: #334155;
  }

  :global(.article-content table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }

  :global(.article-content th),
  :global(.article-content td) {
    border: 1px solid #cbd5e1;
    padding: 0.75rem;
    vertical-align: top;
  }

  :global(.article-content th) {
    background: #f8fafc;
    color: #0f172a;
    text-align: left;
  }

  :global(.column-section) {
    margin: 0;
  }

  :global(.faq-item) {
    margin: 1.5rem 0;
    padding: 1.25rem;
    border: 1px solid #e2e8f0;
    border-radius: 0.8rem;
    background: #fff;
  }

  :global(.faq-question) {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
  }

  :global(.faq-badge) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.3rem;
    height: 2.3rem;
    border-radius: 999px;
    background: #0f766e;
    color: white;
    font-size: 0.82rem;
    font-weight: 700;
  }

  :global(.faq-text) {
    flex: 1;
  }

  :global(.cv-cta-button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.25rem;
    border-radius: 999px;
    background: #0f766e;
    color: #fff !important;
    text-decoration: none !important;
    font-weight: 700;
  }

  .pillar-link {
    margin: 3rem 0 0;
  }

  .pillar-link a {
    display: block;
    padding: 1.25rem 1.4rem;
    border-radius: 1rem;
    background: #f0fdfa;
    border: 1px solid #99f6e4;
    text-decoration: none;
  }

  .pillar-link-label {
    display: block;
    color: #0f766e;
    font-size: 0.82rem;
    font-weight: 700;
    margin-bottom: 0.3rem;
  }

  .pillar-link-title {
    color: #134e4a;
    font-weight: 700;
  }

  .related-columns {
    margin: 4rem 0 0;
    padding-top: 2.5rem;
    border-top: 1px solid #e2e8f0;
  }

  .related-columns h2 {
    margin: 0;
    font-size: 1.6rem;
    color: #0f172a;
  }

  .related-columns > p {
    margin: 0.35rem 0 1.25rem;
    color: #64748b;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1rem 1.1rem;
    border: 1px solid #e2e8f0;
    border-radius: 0.8rem;
    text-decoration: none;
    background: #fff;
  }

  .related-card:hover {
    border-color: #5eead4;
    box-shadow: 0 8px 24px rgba(15, 118, 110, 0.08);
  }

  .related-title {
    color: #0f172a;
    font-weight: 700;
    line-height: 1.55;
  }

  .related-date,
  .related-read {
    color: #64748b;
    font-size: 0.82rem;
  }

  .related-read {
    color: #0f766e;
    font-weight: 700;
  }

  .related-more {
    display: inline-block;
    margin-top: 1rem;
    color: #0f766e;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link {
    display: block;
    max-width: 860px;
    margin: 2rem auto 0;
    color: #475569;
    text-decoration: none;
  }

  .column-category-cta {
    padding: 1rem 1.5rem 5rem;
    background: #f8fafc;
  }

  .column-category-cta-inner {
    max-width: 860px;
    margin: 0 auto;
    padding: 2rem;
    border-radius: 1.25rem;
    background: #0f172a;
    color: white;
  }

  .column-category-cta-eyebrow {
    margin: 0 0 0.45rem;
    color: #5eead4;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .column-category-cta h2 {
    margin: 0;
    font-size: 1.8rem;
  }

  .column-category-cta p {
    color: #cbd5e1;
    line-height: 1.8;
  }

  .column-category-cta-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }

  .column-category-cta-primary,
  .column-category-cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.1rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
  }

  .column-category-cta-primary {
    background: #14b8a6;
    color: #042f2e;
  }

  .column-category-cta-secondary {
    border: 1px solid #475569;
    color: white;
  }

  @media (max-width: 720px) {
    .column-page {
      padding: 6.5rem 1rem 3rem;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }

    .column-category-cta-inner {
      padding: 1.4rem;
    }
  }
</style>
