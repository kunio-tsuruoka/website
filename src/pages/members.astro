---
import Layout from '@/layouts/layout.astro';
import { Header } from '../components/header';
import MemberCard from '../components/member-card';
import JsonLd from '../components/seo/json-ld.astro';
import { PageHero } from '../components/ui/page-hero';
import { authors } from '../data/authors';

const siteUrl = 'https://beekle.jp';
const membersJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: `${siteUrl}/members`,
  about: {
    '@type': 'Organization',
    name: '株式会社Beekle',
    url: siteUrl,
  },
  mainEntity: Object.values(authors).map((a) => ({
    '@type': 'Person',
    '@id': a.url,
    name: a.name,
    jobTitle: a.jobTitle,
    description: a.description,
    url: a.url,
    ...(a.sameAs && a.sameAs.length > 0 ? { sameAs: a.sameAs } : {}),
    ...(a.knowsAbout && a.knowsAbout.length > 0 ? { knowsAbout: a.knowsAbout } : {}),
    worksFor: { '@type': 'Organization', name: '株式会社Beekle', url: siteUrl },
  })),
};

interface Member {
  id: number;
  name: string;
  position: string;
  description: string;
  anchorId?: string;
}

const members: Member[] = [
  {
    id: 1,
    anchorId: 'tsuruoka',
    name: '鶴岡 邦夫',
    position: '代表取締役',
    description: [
      '株式会社Beekle 代表取締役。',
      'フリーランスエンジニアとしてさまざまなシステム開発を経験した後、株式会社Beekleを設立。',
      'バックエンド、フロントエンド、インフラまで幅広く開発に携わってきたほか、顧客ヒアリング、要件定義、プロダクトマネジメント、営業・提案、事業設計まで一貫して担当してきた。',
      '新規事業では、まだサービスの形が決まっていない段階から、リサーチ、課題整理、要件定義、デザイン、システム開発までを進める0→1のプロジェクトを多数経験。立ち上げ後の改善や運用、内製化支援など、1→100のフェーズにも携わっている。',
      '現在は生成AI・RAG・業務システムを中心に、企業のDX・AI活用支援を行う一方、自社でもAIを積極的に実務へ導入している。',
      'Cursor cloud agents、Claude CodeやCodexを使ったAI開発だけでなく、AIによるコードレビュー、Gherkinを活用した仕様・テスト管理、営業案件の分析、マーケティングデータ分析、経営・財務分析など、開発から会社経営まで幅広い領域でAIを実際に活用している。',
      'また、自社プロダクト「PM on Rails」の開発をはじめ、AI推薦システム、GraphRAGを利用したゲーム、音声・言語系アプリケーションなど、さまざまなAIプロダクトの企画・検証にも取り組んでいる。',
      '技術ありきではなく、「顧客が本当に解決したい問題は何か」を整理し、必要であれば既存サービスの活用も含めて、最も現実的な方法を設計することを大切にしている。',
      '現在は、AIを活用することで少人数でも高い生産性と品質を実現できる開発・経営の仕組みづくりと、日本発のプロダクトを世界へ展開することを目指している。',
    ].join('\n'),
  },
  {
    id: 2,
    name: '金子 大夢',
    position: '取締役副社長',
    description:
      '【経歴】幼少から父にサビキや投げ釣りに連れられ経験を積む。20歳を超えた頃からルアー釣りにハマり、アキアジ、海鱒とジャンルを増やす。最近ではオフショアへも足を伸ばしサクラマスなどのジギングにも力を入れている。行く行くはマグロなどの大物の釣りやジグの自作を行おうと考えている。近頃はスノーボードも嗜んでいる。直近の目標はフロントフリップ\n【専門】バックエンドとフロントエンド開発\n【趣味】釣り・日本酒　\n【社長のコメント】天才肌でとても地頭がよく、やったことない問題でも解決してしまいます。Beekleの貴重な人材です。',
  },
  {
    id: 3,
    anchorId: 'nakamura',
    name: '中村 有貴',
    position: '外部技術顧問',
    description:
      '【経歴】中小規模のSIerからキャリアをスタートし、20年エンジニア・プログラマーとして従事。現在は香港の日系企業に所属しながら、個人事業として複数の日本企業の開発に参画。若手エンジニアのメンター活動も行っています。\n【フロントエンド】Bootstrap, Bulma, Tailwind CSS, Sass, PostCSS, Vue.js, Nuxt.js, Gatsby.js, Node.js, React\n【バックエンド】Golang, TypeScript, PHP (Laravel/Symfony/Zend Framework), Ruby (Ruby on Rails), Java (Struts/Seaser2/Spring), MySQL/MariaDB, Redis/Memcache\n【インフラ】AWS, Netlify, Sakura/XServer/お名前.com, Vultr\n【開発ツール】PhpStorm, Postman, Visual Studio Code',
  },
  {
    id: 4,
    name: '佐藤 瑛隆',
    position: 'データサイエンティスト',
    description:
      '【経歴】京都大学理学研究科数学・数理解析専攻を修了。在学中に株式会社RUTILEAにてAIソリューション開発のチーフエンジニアを担当。新卒でアクセンチュア株式会社にデータサイエンティストとして入社し、統計モデル・機械学習を用いたSCM領域の業務課題解決・DX支援に従事。現在はフリーランスとしてデータ分析、企業向け研修、大学向け教材制作支援などを行っている。\n【スキル・資格】修士(理学)、数学(確率解析)、統計検定1級、データ分析、Python/Jupyter Notebook、教員免許(専修・中高・数学)　\n【社長のコメント】　弊社の数理的なことや、AI関連のことは彼に任せています。経歴から伺えると思いますが、とても優秀な人材で自分自身も刺激を受けます。とても会社に深く関わってくれていて感謝しています。',
  },
  {
    id: 5,
    name: '五十川 奈菜',
    position: 'デザイナー',
    description:
      '【職歴】デザイン&開発会社 営業、デザイン制作会社 デザイナー、フリーランス（Webデザイン・動画制作）、株式会社Beekle デザイナー\n【専門】UI/UXデザイン・プロダクト設計・フロントエンド \n【対応可能範囲】バックエンド開発　\n【得意なこと】情報整理、黙々と作業すること　\n【社長のコメント】デザインのみならず、要件の抜け漏れがないシステム設計や画面設計を得意としています。このおかげで弊社は、ビジネスに最適化されたシステムを作成することができています。彼女がビジネス要件から画面設計をしっかりしてくれるおかげでクオリティ高いシステムが作れます。彼女のいいところは、全体的になんでもできる上で専門性を持つところで全体が見えることです。ここが彼女のレベルが高いところです。',
  },
  {
    id: 6,
    name: '鈴木 一郎',
    position: '社長アシスタント / リサーチャー',
    description:
      '【現在の業務】Beekleでは社長アシスタントとして、社長の壁打ちや相談に付き合っています。また、新サービス開発時のリサーチも担当しています。週末はStudioshineの一員として、修斗やKROSS×OVERなど格闘技イベントのインターネット配信支援サービスにも参加。\n【経歴】ITコンサルティング会社でSalesforce導入支援、データ処理、社内人材育成（資格取得支援）、マーケティングなどに従事。NPO IT支援ネットワークの一員として、NPO・NGOにSalesforce、Google Workspace導入、SNS運用の支援も行う。大手BPO企業でリサーチャーとして情報収集業務も経験。\n【目標】海外大学院への入学を目指し、英語学習と受験に励んでいます。\n【趣味】ゲーム、旅行、スポーツ（野球とサッカーを観たりやったり）、英語学習',
  },
];
---

<Layout
  title="メンバー紹介 | Beekle"
  description="Beekleのチームメンバー紹介。デザイナー、エンジニア、マーケターなど多様なスキルを持つプロフェッショナルが在籍し、幅広い開発案件に対応します。"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(membersJsonLd)} />
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: 'メンバー紹介', url: '/members' },
      ],
    }}
  />
  <JsonLd
    slot="head"
    type="webPage"
    data={{
      pageType: 'CollectionPage',
      name: 'メンバー紹介 | Beekle',
      description: 'Beekleのチームメンバー紹介。デザイナー、エンジニア、マーケターなど多様なスキルを持つプロフェッショナルが在籍し、幅広い開発案件に対応します。',
      url: 'https://beekle.jp/members',
    }}
  />
  <Header />
  <main class="bg-neutral-100 pt-20">
    <PageHero
      title="メンバー紹介"
      subtitle="Beekleの開発チームをご紹介します。多様な専門知識と経験を持つ私たちが、お客様のビジネス成長を全力でサポートします。"
    />

    <!-- メンバー紹介セクション -->
    <section class="border-b border-neutral-300 bg-neutral-100 py-24 md:py-28">
      <div class="container mx-auto px-8">
        <h2 class="text-3xl font-bold text-center mb-16">メンバー紹介</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-12">
          {
            members.map((member, index) => (
              <MemberCard
                name={member.name}
                position={member.position}
                description={member.description}
                index={index}
                anchorId={member.anchorId}
                client:visible
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- お問い合わせセクション -->
    <section class="border-b border-neutral-300 bg-neutral-50 py-20 md:py-24">
      <div class="container mx-auto px-8 text-center">
        <h2 class="text-3xl font-bold text-gray-800 mb-6">
          お気軽にご相談ください
        </h2>
        <p class="text-lg text-gray-700 max-w-3xl mx-auto mb-10">
          システム開発のご相談や、チームについてのご質問など、お気軽にお問い合わせください。
        </p>
        <a
          href="/contact?source=members-final"
          data-cta-source="members-final"
          data-cta-id="contact"
          class="inline-flex min-h-[48px] items-center justify-center rounded-md bg-primary-500 px-8 py-3 font-bold text-white transition-colors hover:bg-primary-600"
        >
          お問い合わせ
        </a>
      </div>
    </section>
  </main>
</Layout>

<style></style>
