---
// 「資料置き場」ではなく、購買段階ごとに必要な判断材料へ案内するHub (tasks-v3 TASK-P1-02 / [B2B-1])。
// 発注準備キットは主役にしない（Hero・先頭カテゴリに置かない）。
import { Header } from '../components/header';
import JsonLd from '../components/seo/json-ld.astro';
import { PageHero } from '../components/ui/page-hero';
import Layout from '../layouts/layout.astro';

type Resource = {
  title: string;
  description: string;
  /** 直接DL: PDFパス／それ以外: リンク先 */
  fileName?: string;
  fileUrl?: string;
  landingUrl?: string;
  ctaLabel?: string;
  ctaId: string;
  external?: boolean;
};

type ResourceCategory = {
  heading: string;
  lead: string;
  resources: Resource[];
};

const categories: ResourceCategory[] = [
  {
    heading: '課題を整理する',
    lead: '何に困っていて、何を変えたいのか。発注の前に課題を言葉にするための材料です。',
    resources: [
      {
        title: '発注者向けコラム',
        description:
          '要件定義・見積もり・費用相場・AI開発まで、発注者の目線で判断材料を解説しています。',
        landingUrl: '/column',
        ctaLabel: 'コラムを見る',
        ctaId: 'column',
      },
      {
        title: '要件定義の完全ガイド',
        description:
          '要求と要件の違いから、進め方・テンプレートまで。発注前に読まれている定番記事です。',
        landingUrl: '/column/requirements-definition-complete-guide',
        ctaLabel: '記事を読む',
        ctaId: 'column-requirements-guide',
      },
      {
        title: '発注準備キット（無料ツール）',
        description:
          'RFP作成、スコープ整理、業務フロー可視化。自分で要求を整理したい方向けの無料ツール群です。',
        landingUrl: '/tools',
        ctaLabel: 'ツールを見る',
        ctaId: 'tools-index',
      },
    ],
  },
  {
    heading: '技術・選択肢を理解する',
    lead: 'AI・RAGで何ができて、何が難しいのか。技術の当たりをつけるための材料です。',
    resources: [
      {
        title: 'ブラウザで触れるAIデモ',
        description:
          'AIナレッジ相談（RAG）、領収書OCRなど、導入前に「実際の挙動」を5分で体感できます。',
        landingUrl: '/demos',
        ctaLabel: 'デモを試す',
        ctaId: 'demos-index',
      },
      {
        title: '生成AI導入の完全ガイド',
        description:
          '何から始めるか、セキュリティ、社内説得まで。生成AI導入を進める側の論点を一冊にまとめた記事です。',
        landingUrl: '/column/genai-introduction-complete-guide',
        ctaLabel: '記事を読む',
        ctaId: 'column-genai-guide',
      },
      {
        title: 'ナレッジグラフ・RAGは発注者に何の得があるか',
        description: 'RAGだけのAIが答えられない問いと、その解決を発注者目線で解説しています。',
        landingUrl: '/column/knowledge-graph-rag-business',
        ctaLabel: '記事を読む',
        ctaId: 'column-kg-rag',
      },
    ],
  },
  {
    heading: '開発方法を確認する',
    lead: 'Beekleがどう作るのか。発注前の不確実性をどう減らすのかを確認できます。',
    resources: [
      {
        title: 'ゼロスタート開発 サービスデック',
        description:
          '初期費用0円で検証用プロトタイプを作り、実物を確認してから判断する仕組みをまとめた資料です。',
        fileName: 'beekle-zero-start-sales-deck.pdf',
        fileUrl: '/downloads/beekle-zero-start-sales-deck.pdf',
        ctaId: 'pdf-zero-start-sales-deck',
      },
      {
        title: 'Beekleの開発方法',
        description:
          'なぜ速く作っても仕様が崩れにくいのか。要求から実装・テストまでを一つながりに管理する進め方の説明です。',
        landingUrl: '/strengths',
        ctaLabel: '開発方法を見る',
        ctaId: 'strengths',
      },
      {
        title: 'PM on Rails（自社開発のPM基盤）',
        description:
          '要求・要件からユーザーストーリー・受入条件・開発タスクまでを構造化し、AIエージェントによる実装につなげるプロジェクト管理基盤です。',
        landingUrl: 'https://pmonrails.com',
        ctaLabel: 'PM on Railsを見る',
        ctaId: 'pmonrails',
        external: true,
      },
    ],
  },
  {
    heading: '比較・稟議を進める',
    lead: '社内で発注判断を進めるための、実例・費用対効果・比較の材料です。',
    resources: [
      {
        title: '導入事例',
        description:
          '他社難航案件のリカバリー、新規事業の短期立ち上げ、AI・データ基盤構築など、実案件の課題と成果です。',
        landingUrl: '/case-studies',
        ctaLabel: '事例を見る',
        ctaId: 'case-studies',
      },
      {
        title: 'お客様の声（進め方への評価）',
        description:
          '要件定義・優先順位づけ・推進など、どの進め方を評価いただいたかで分類したお客様の声です。',
        landingUrl: '/testimonial',
        ctaLabel: '声を見る',
        ctaId: 'testimonial',
      },
      {
        title: '生成AI導入の費用対効果とROIの考え方',
        description: '経営層への説明・稟議に使える、投資判断の組み立て方を解説した記事です。',
        landingUrl: '/column/genai-roi-investment',
        ctaLabel: '記事を読む',
        ctaId: 'column-genai-roi',
      },
      {
        title: 'AI受託開発会社の選び方',
        description: '発注先を比較する7つのチェックポイント。複数社比較の物差しに使えます。',
        landingUrl: '/column/ai-development-vendor-selection',
        ctaLabel: '記事を読む',
        ctaId: 'column-vendor-selection',
      },
    ],
  },
  {
    heading: '提携資料',
    lead: '',
    resources: [
      {
        title: 'ワンテクワールドd-popsアライアンス',
        description:
          '弊社はワンテクワールドという開発アライアンスを組んで開発を行っています。その関連資料になります。',
        fileName: 'ワンテクワールドd-popsアライアンス.pdf',
        fileUrl: '/pdf/ワンテクワールドd-popsアライアンス.pdf',
        ctaId: 'pdf-onetech',
      },
    ],
  },
];

const pageDescription =
  'Beekleの資料・判断材料の一覧。課題整理、技術理解、開発方法の確認、比較・稟議と、検討の段階に合わせて必要な資料・記事・事例へ案内します。';
---

<Layout title="資料・判断材料 | Beekle" description={pageDescription} noindex={true}>
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: '資料・判断材料', url: '/materials' },
      ],
    }}
  />
  <JsonLd
    slot="head"
    type="webPage"
    data={{
      pageType: 'CollectionPage',
      name: '資料・判断材料 | Beekle',
      description: pageDescription,
      url: 'https://beekle.jp/materials',
    }}
  />
  <Header client:idle />
  <main class="pt-20">
    <PageHero
      title="資料・判断材料"
      subtitle="いま検討がどの段階かに合わせて、必要な材料へ案内します。課題の整理から、技術の理解、開発方法の確認、社内での比較・稟議まで。"
    />

    <section class="mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl py-16">
      {categories.map((category) => (
        <div class="mb-16">
          <h2 class="text-2xl font-bold text-gray-900 mb-2">{category.heading}</h2>
          {category.lead && <p class="text-gray-600 mb-8">{category.lead}</p>}
          <div class={`grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 ${category.lead ? '' : 'mt-8'}`}>
            {category.resources.map((resource) => (
              <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 flex flex-col">
                <div class="p-8 flex flex-col flex-1">
                  <div class="mb-4">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary-100 text-primary-700">
                      {category.heading}
                    </span>
                  </div>

                  <h3 class="text-xl font-bold text-gray-900 mb-3">
                    {resource.title}
                  </h3>

                  <p class="text-gray-600 mb-6 flex-1">
                    {resource.description}
                  </p>

                  {resource.landingUrl ? (
                    <a
                      href={resource.landingUrl}
                      {...(resource.external ? { rel: 'noopener' } : {})}
                      data-cta-source="materials"
                      data-cta-id={resource.ctaId}
                      class="inline-flex items-center justify-center w-full px-6 py-3 min-h-[44px] text-base font-medium text-white bg-primary-500 rounded-lg hover:bg-primary-600 transition-colors duration-200"
                    >
                      {resource.ctaLabel || '詳細を見る'}
                      <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                      </svg>
                    </a>
                  ) : (
                    <a
                      href={resource.fileUrl}
                      download={resource.fileName}
                      data-cta-source="materials"
                      data-cta-id={resource.ctaId}
                      class="inline-flex items-center justify-center w-full px-6 py-3 min-h-[44px] text-base font-medium text-white bg-primary-500 rounded-lg hover:bg-primary-600 transition-colors duration-200"
                    >
                      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                      ダウンロード
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}

      {/* CTA セクション */}
      <div class="mt-8 text-center pb-16">
        <h2 class="text-3xl font-bold text-gray-900">どの段階か分からなくても大丈夫です</h2>
        <p class="mt-4 text-xl text-gray-600">
          課題の整理段階から、業務課題ベースでご相談いただけます
        </p>
        <div class="mt-8">
          <a
            href="/contact?source=materials-final"
            data-cta-source="materials-final"
            data-cta-id="contact"
            class="inline-flex items-center justify-center px-8 py-4 text-lg font-medium text-white bg-primary-500 border border-transparent rounded-full hover:bg-primary-600"
          >
            業務課題を相談する
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
