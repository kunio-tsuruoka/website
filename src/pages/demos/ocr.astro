---
import { AiOcrDemo } from '@/features/ai-ocr-demo';
import { Header } from '../../components/header';
import JsonLd from '../../components/seo/json-ld.astro';
import DemoBusinessBridge from '../../components/ui/demo-business-bridge.astro';
import FloatingCTA from '../../components/ui/floating-cta.astro';
import { PageHero } from '../../components/ui/page-hero';
import Layout from '../../layouts/layout.astro';

const runtime = (Astro.locals as { runtime?: { env?: { TURNSTILE_SITE_KEY?: string } } }).runtime;
const sitekey = runtime?.env?.TURNSTILE_SITE_KEY ?? '0x4AAAAAADHmRrTyQk-jx5-X';
---

<Layout
  title="AI領収書OCR (デモ)｜画像から店舗名・金額・明細を自動抽出 | Beekle"
  description="領収書の画像をアップロードすると、AIが店舗名・日付・合計・明細を自動抽出します。経費精算の効率化を体感できるデモ。業務での精度検証はBeekleが支援します。"
>
  <Header />
  <main class="bg-neutral-100 pt-20">
    <PageHero
      title="AI領収書OCR (デモ)"
      subtitle="領収書の画像から店舗名・日付・金額・明細をAIが抽出します。経費精算や請求業務の自動化を試せるデモです。"
      badge="AI Demo"
    />

    <section class="py-12 md:py-16 bg-neutral-100">
      <div class="container mx-auto px-6 md:px-8 max-w-6xl">
        <AiOcrDemo client:load sitekey={sitekey} />

        <div class="mt-10 grid md:grid-cols-3 gap-4 text-sm">
          <div class="p-5 bg-white rounded-lg border border-gray-200">
            <p class="font-bold mb-2">用途</p>
            <p class="text-gray-600">経費精算の自動化、請求書処理、書類整理などの効率化を検討する際の感触確認に。</p>
          </div>
          <div class="p-5 bg-white rounded-lg border border-gray-200">
            <p class="font-bold mb-2">注意</p>
            <p class="text-gray-600">手書き・かすれた領収書では精度が落ちます。業務利用には精度検証と運用設計が必要です。</p>
          </div>
          <div class="p-5 bg-white rounded-lg border border-gray-200">
            <p class="font-bold mb-2">プライバシー</p>
            <p class="text-gray-600">画像はOCR処理のみに利用し、サーバには保存しません。AI応答には店舗名・金額のみ含まれます。</p>
          </div>
        </div>
      </div>
    </section>

    <DemoBusinessBridge
      useCases={[
        '請求書・発注書の入力自動化',
        '経費精算のレシート処理',
        '申込書・紙帳票のデータ化',
        '商品カタログの構造化とマスタ照合',
        '紙書類のアーカイブ検索化',
      ]}
      productionNeeds={[
        '確信度に応じた人のレビュー画面',
        '会計・基幹システムへの連携（API / CSV）',
        '取引先ごとの帳票フォーマット差への対応',
        '権限・監査ログ',
        '読み取りエラー時の例外運用',
      ]}
      serviceHref="/services/ocr-ai-development"
      serviceLabel="OCR・帳票読み取りAIを見る"
      source="demo-ocr-bridge"
      intent="ocr-ai-development"
    />

    <FloatingCTA source="tool-ai-ocr-demo" />
  </main>

  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer></script>
</Layout>

<JsonLd
  type="softwareApplication"
  data={{
    appName: 'AI領収書OCR',
    appDescription:
      '領収書の画像から店舗名・日付・合計・明細をAIが構造化データとして自動抽出する体験デモ。経費精算・帳票処理の自動化（OCR + LLM構造化）を試せます。',
    url: 'https://beekle.jp/demos/ocr',
    applicationCategory: 'FinanceApplication',
  }}
/>
<JsonLd
  type="breadcrumb"
  data={{
    items: [
      { name: 'ホーム', url: '/' },
      { name: 'AIデモ', url: '/demos' },
      { name: 'AI領収書OCR', url: '/demos/ocr' },
    ],
  }}
/>
