// ページネーション計算
// featured を先頭へ（同じグループ内の並びは元の順序を保つ）
const orderedCases = [...allCases].sort(
  (a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured))
);
const totalPages = Math.ceil(orderedCases.length / ITEMS_PER_PAGE);
const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
const cases = orderedCases.slice(startIndex, startIndex + ITEMS_PER_PAGE);
const hasNextPage = currentPage < totalPages;
const hasPrevPage = currentPage > 1;
