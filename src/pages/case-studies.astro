                      </h2>
                      <div class="mt-4 flex flex-wrap gap-4">
                        {case_study.featured && (
                          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-bold bg-primary-500 text-white">
                            注目の事例
                          </span>
                        )}
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100">
                          {case_study.industry}
                        </span>
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100">
                          {case_study.scale}
                        </span>
                        {case_study.period && (
                          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100">
                            開発期間：{case_study.period}
                          </span>
                        )}
                      </div>
                    </div>
                  </div>
                </div>

                {/* 課題と解決策 */}
                <div class="lg:col-span-6">
                  <div class="mb-8">
                    <h3 class="text-xl font-bold text-gray-900 mb-4">{case_study.challenge.title}</h3>
                    <p class="text-gray-600 mb-4">{case_study.challenge.description}</p>
                    <ul class="space-y-2">
                      {case_study.challenge.points.map((point) => (
                        <li class="flex items-start">
                          <span class="flex-shrink-0 h-6 w-6 text-primary-500">
                            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                          </span>
                          <span class="ml-2 text-gray-600">{point}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="lg:col-span-6">
                  <div class="mb-8">
                    <h3 class="text-xl font-bold text-gray-900 mb-4">{case_study.solution.title}</h3>
                    <p class="text-gray-600 mb-4">{case_study.solution.description}</p>
                    <ul class="space-y-2">
                      {case_study.solution.points.map((point) => (
                        <li class="flex items-start">
                          <span class="flex-shrink-0 h-6 w-6 text-primary-500">
                            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                          </span>
                          <span class="ml-2 text-gray-600">{point}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                {/* 結果 */}
                <div class="lg:col-span-12">
                  <div class="border-t pt-8">
                    <h3 class="text-xl font-bold text-gray-900 mb-4">結果</h3>
                    {case_study.outcome && (
                      <p class="text-gray-600 leading-relaxed mb-6 lg:max-w-4xl">
                        {case_study.outcome.description}
                      </p>
                    )}
                    <div
                      class:list={[
                        'grid grid-cols-1 gap-4',
                        case_study.results.length === 4
                          ? 'md:grid-cols-2 lg:grid-cols-4'
                          : 'md:grid-cols-3',
                      ]}
                    >
                      {case_study.results.map((result) => (
                        <div class="bg-gray-50 rounded-lg p-5">
                          <div class="text-sm text-gray-500">{result.label}</div>
                          <div class="mt-1 text-lg md:text-xl font-bold text-primary-600 leading-snug">
                            {result.value}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>

                {/* Beekleだからできたこと */}
                {case_study.strength && (
                  <div class="lg:col-span-12 mt-8">
                    <div class="rounded-2xl border border-primary-200 bg-primary-50/40 p-6 md:p-8">
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-navy-950 text-white">
                        Beekleだからできたこと
                      </span>
                      <h3 class="mt-4 text-xl font-bold text-gray-900 leading-snug">
                        {case_study.strength.title}
                      </h3>
                      <p class="mt-3 text-gray-700 font-medium leading-relaxed">
                        {case_study.strength.benefit}
                      </p>
                      <p class="mt-3 text-gray-600 leading-relaxed">
                        {case_study.strength.evidence}
                      </p>
                      <p class="mt-3 text-gray-600 leading-relaxed">
                        {case_study.strength.whyBeekle}
                      </p>
                      <p class="mt-4 text-sm text-gray-500">{case_study.strength.category}</p>
                    </div>
                  </div>
                )}

                {/* 発注判断の裏側（顧客ヒアリングで事実が取れた事例のみ） */}
                {'decision' in case_study && case_study.decision && (
                  <div class="lg:col-span-12 mt-8">
                    <div class="rounded-2xl border border-neutral-200 bg-white p-6 md:p-8 shadow-soft">
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-primary-500 text-white">
                        発注判断の裏側
                      </span>
                      <p class="mt-3 text-sm text-gray-500">
                        このお客様が、何と比較し、何を不安に感じ、なぜBeekleに決めたか。
                      </p>
                      <div class="mt-5 grid gap-5 md:grid-cols-3">
                        <div class="rounded-xl bg-gray-50 p-5">
                          <p class="text-sm font-bold text-primary-600 mb-2">比較した選択肢</p>
                          <p class="text-sm text-gray-600 leading-relaxed">
                            {case_study.decision.alternatives}
                          </p>
                        </div>
                        <div class="rounded-xl bg-gray-50 p-5">
                          <p class="text-sm font-bold text-primary-600 mb-2">不安だったこと</p>
                          <p class="text-sm text-gray-600 leading-relaxed">
                            {case_study.decision.concerns}
                          </p>
                        </div>
                        <div class="rounded-xl border border-primary-200 bg-primary-50/40 p-5">
                          <p class="text-sm font-bold text-primary-600 mb-2">Beekleを選んだ理由</p>
                          <p class="text-sm text-gray-700 leading-relaxed font-medium">
                            {case_study.decision.whyChosen}
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      {/* ページネーション */}
      {totalPages > 1 && (
        <div class="mt-16 flex flex-wrap justify-center items-center gap-2 sm:gap-4">
          {hasPrevPage ? (
            <a
              href={`/case-studies?page=${currentPage - 1}`}
              class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              前へ
            </a>
          ) : (
            <span class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-400 bg-gray-100 border border-gray-200 rounded-lg cursor-not-allowed">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              前へ
            </span>
          )}

          <div class="flex items-center gap-2">
            {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
              <a
                href={`/case-studies?page=${page}`}
                class={`inline-flex items-center justify-center w-10 h-10 text-sm font-medium rounded-lg ${
                  page === currentPage
                    ? 'text-white bg-primary-500'
                    : 'text-gray-700 bg-white border border-gray-300 hover:bg-gray-50'
                }`}
              >
                {page}
              </a>
            ))}
          </div>

          {hasNextPage ? (
            <a
              href={`/case-studies?page=${currentPage + 1}`}
              class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50"
            >
              次へ
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          ) : (
            <span class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-400 bg-gray-100 border border-gray-200 rounded-lg cursor-not-allowed">
              次へ
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          )}
        </div>
      )}

      <div class="mt-8 text-center text-sm text-gray-500">
        全{allCases.length}件中 {startIndex + 1}〜{Math.min(startIndex + ITEMS_PER_PAGE, allCases.length)}件を表示
      </div>

      {/* CTA セクション */}
      <div class="mt-24 text-center pb-16">
        <h2 class="text-3xl font-bold text-gray-900">お客様の事業成長をサポートします</h2>
        <p class="mt-4 text-xl text-gray-600">
          無料相談、または「初期費用0円で動くプロトタイプから判断する」仕組みをまとめた資料からどうぞ
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact?source=case-studies-final"
            data-cta-source="case-studies-final"
            data-cta-id="contact"
            class="inline-flex items-center justify-center px-8 py-4 text-lg font-medium text-white bg-primary-500 border border-transparent rounded-full hover:bg-primary-600"
          >
            業務課題を相談する
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="/downloads/beekle-zero-start-sales-deck.pdf"
            download="beekle-zero-start-sales-deck.pdf"
            data-cta-source="case-studies-final"
            data-cta-id="pdf-zero-start-sales-deck"
            class="inline-flex items-center justify-center px-8 py-4 text-lg font-medium text-primary-600 bg-white border-2 border-primary-500 rounded-full hover:bg-primary-50"
          >
            サービス資料をダウンロード
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </a>
        </div>
        <p class="mt-4 text-sm text-gray-500">PDF・約20ページ・無料／メールアドレスのみで受け取れます</p>
      </div>
    </section>
  </main>
</Layout>
