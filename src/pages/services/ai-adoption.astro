---
import { Header } from '@/components/header';
import JsonLd from '@/components/seo/json-ld.astro';
import { Section, SectionHeader } from '@/components/ui';
import Layout from '../../layouts/layout.astro';

const siteUrl = 'https://beekle.jp';
const pageUrl = `${siteUrl}/services/ai-adoption`;
const seoTitle = 'AI導入支援3プラン｜失敗を防ぐ業務選定・評価設計・導入伴走';
const seoDescription =
  'AI導入をPoCで終わらせないために、業務選定、評価基準、技術判断、本番運用まで整理します。AIを入れるべき業務か、いま着手すべきかを判断できる状態にします。';

const HOURLY_RATE = '10,000';

type Plan = {
  no: string;
  code: string;
  name: string;
  tagline: string;
  target: string;
  chooseWhen: string;
  skipWhen: string;
  scope: string;
  deliverable: string;
  meetings: string;
  hours: string;
  implementation: string;
  contract: string;
  price: string;
  priceUnit: string;
  featured: boolean;
};

const plans: Plan[] = [
  {
    no: '01',
    code: 'ADVISE',
    name: 'AI活用提案',
    tagline: '失敗しにくい業務を選び、社内説明できる提案書にする',
    target: 'AIを使いたいが、どの業務から手をつけるか社内で決まっていない',
    chooseWhen: '業務選定、概算、社内説明資料を先にそろえたい',
    skipWhen: 'すでに作る機能と本番要件が決まっている',
    scope: '業務ヒアリング、適用候補の洗い出しと優先順位づけ、提案書の作成',
    deliverable: 'AI活用提案書（対象業務・想定効果・概算費用・進め方）',
    meetings: 'ヒアリング2回＋報告1回／チャット相談は実施期間中のみ',
    hours: '10時間目安（数週間）',
    implementation: '含まない',
    contract: '準委任（スポット）',
    price: '100,000',
    priceUnit: '一式',
    featured: false,
  },
  {
    no: '02',
    code: 'GUIDE',
    name: 'AI実装アドバイス',
    tagline: '作るのは自社。評価設計と技術判断のズレを外から見る',
    target: '社内に開発リソースがあり自社で作るが、技術判断を検証できる人がいない',
    chooseWhen: '自社開発は進めたいが、評価方法や構成に第三者レビューがほしい',
    skipWhen: '実装まで外部に任せたい、または社内に開発担当がいない',
    scope: '技術選定レビュー、アーキテクチャレビュー、精度評価の設計、定例レビュー',
    deliverable: 'レビュー記録、技術方針メモ',
    meetings: '定例MTG 月2回（各60分）／チャット相談 無制限',
    hours: '月16時間（週4時間相当）',
    implementation: '含まない（手は動かしません）',
    contract: '準委任（月額）',
    price: '160,000',
    priceUnit: '月',
    featured: true,
  },
  {
    no: '03',
    code: 'ENABLE',
    name: 'AI導入伴走支援',
    tagline: 'PoCで止めず、実装・運用定着まで同じチームで進める',
    target: '導入を決めたが、社内だけでは本番運用まで到達できる体制がない',
    chooseWhen: 'PoC構築、本番実装、運用ルールまでまとめて進めたい',
    skipWhen: 'まずAI導入の可否だけを整理したい',
    scope: '要件整理、PoC構築、実装、社内展開、運用定着までの継続関与',
    deliverable: '動くシステム、導入計画、運用ルール',
    meetings: '定例MTG 週1回／チャット相談 無制限',
    hours: '月32時間〜（週8時間相当）',
    implementation: '含む',
    contract: '準委任（月額）',
    price: '320,000',
    priceUnit: '月〜',
    featured: false,
  },
];

const comparisonRows: { label: string; key: keyof Plan }[] = [
  { label: 'こんな方に', key: 'target' },
  { label: '選ぶ状態', key: 'chooseWhen' },
  { label: '選ばない状態', key: 'skipWhen' },
  { label: '判断材料・成果物', key: 'deliverable' },
  { label: 'やること', key: 'scope' },
  { label: '接触頻度', key: 'meetings' },
  { label: '想定時間', key: 'hours' },
  { label: '実装', key: 'implementation' },
  { label: '契約形態', key: 'contract' },
];

const painPoints = [
  {
    title: '相談したいのに、いきなり開発の見積もりが出てくる',
    description:
      '「AIで何ができるか」を整理したい段階なのに、相談するとシステム開発の提案と見積もりが返ってくる。判断材料がないまま発注の可否を迫られる。',
  },
  {
    title: '技術判断が合っているか、社内の誰も検証できない',
    description:
      '開発チームはある。ただ生成AIは初めてで、モデルの選び方も精度の測り方も手探り。進んでいる方向が正しいのか確かめる手段がない。',
  },
  {
    title: 'PoCまでは進んだが、本番運用に載せられない',
    description:
      '動くものはできた。しかし権限管理、ログ、コスト監視、現場への展開まで手が回らず、試作のまま止まっている。',
  },
  {
    title: '一式いくらの見積もりで、何にいくらかかるか分からない',
    description:
      '提示された金額の内訳が読めず、社内で稟議を通せない。範囲を減らしたときにいくら下がるのかも分からない。',
  },
];

const detailCards = [
  {
    title: 'AI活用提案',
    result: 'AIを入れるべき業務、見送るべき業務、概算と進め方が残ります。',
    boundary: '実装は含みません。提案書は他社発注や補助金申請にも使えます。',
  },
  {
    title: 'AI実装アドバイス',
    result: '評価データ、技術方針、レビュー記録が残り、社内開発の判断を補強できます。',
    boundary: 'Beekleは手を動かしません。実装が必要なら伴走支援へ切り替えます。',
  },
  {
    title: 'AI導入伴走支援',
    result: 'PoC、本番実装、運用ルールまで同じチームで進め、現場で使う状態を目指します。',
    boundary: 'まず可否だけを整理したい段階なら、AI活用提案から始めます。',
  },
];

const steps = [
  {
    no: '01',
    title: '無料相談・NDA確認',
    description:
      '公開できる範囲で、現状の業務、体制、すでに試したことを伺います。機密資料や顧客情報が必要な場合は、NDA締結後に確認します。',
  },
  {
    no: '02',
    title: '対象業務と評価基準を整理',
    description:
      'お客様からは業務フロー、利用者、使えるデータ、月間件数を共有いただきます。BeekleからはAI化候補、評価観点、見送りリスクを返します。',
  },
  {
    no: '03',
    title: '本番化条件とプラン提案',
    description:
      '本番化する、追加検証する、いまはやらないを分けます。本番化する場合だけ、対象範囲、成果物、想定時間、費用を添えて提案します。',
  },
  {
    no: '04',
    title: 'PoC・レビュー・本番化判断',
    description:
      'PoCや実装レビューでは、精度、権限、ログ、運用負荷、現場の確認手順を見ます。PoC後に進まない選択も判断結果として扱います。',
  },
  {
    no: '05',
    title: 'プラン変更・終了',
    description:
      '提案だけで他社実装へ進む、社内開発へ切り替える、月額支援を縮小する、といった変更ができます。最初のプランに固定されません。',
  },
];

const faqs = [
  {
    question: '提案だけ受け取って、実装は他社に依頼してもいいですか？',
    answer:
      'はい。AI活用提案（PLAN 01）でお渡しする提案書はお客様の資産です。他社への発注や補助金申請の資料として使っていただいて構いません。実装を当社に発注していただく必要はありません。',
  },
  {
    question: '料金はどのように決まっていますか？',
    answer:
      '各プランの料金は比較表にまとめています。時間単価は算定根拠として公開し、範囲が変わる場合は事前に相談してから調整します。',
  },
  {
    question: '想定時間より多く、または少なくかかった場合はどうなりますか？',
    answer:
      '記載の時間は目安です。作業量が想定と大きく変わりそうな場合は、その時点でご相談し、範囲か時間のどちらを調整するかを決めてから進めます。何も言わずに超過することはありません。',
  },
  {
    question: 'AI導入伴走支援と、生成AI受託開発の違いは何ですか？',
    answer:
      '作る対象が決まっているなら生成AI受託開発、何を作るか・どの業務から始めるかも含めて決めたい場合はAI導入伴走支援が向いています。迷う場合は初回相談で切り分けます。',
  },
  {
    question: 'NDAは相談前に締結できますか？',
    answer:
      '可能です。初回は公開できる範囲だけで相談いただき、詳細な業務資料や顧客情報が必要になった段階でNDA締結後に確認します。',
  },
  {
    question: '最低契約期間はありますか？',
    answer:
      '月額の2プラン（AI実装アドバイス・AI導入伴走支援）は最低3ヶ月です。AIは効果が見えるまでに一定の期間が必要なため、最初の3ヶ月だけお願いしています。4ヶ月目以降は月単位で解約でき、違約金はありません。AI活用提案はスポットのため、継続の縛りはありません。',
  },
  {
    question: '社内データや顧客情報を渡す必要がありますか？',
    answer:
      '初回相談では不要です。詳細検討に入る場合は、NDA締結後に必要な範囲だけ確認します。個人情報や機密情報を扱う場合は、利用するAI環境、ログ、権限、モデル学習への利用有無を先に整理します。',
  },
  {
    question: '成果物の権利や途中終了はどうなりますか？',
    answer:
      '提案書、レビュー記録、設計メモなどお渡しした成果物はお客様側の検討資料として使えます。月額プランは最低期間後、月単位で終了・縮小できます。',
  },
  {
    question: 'PoC後に本番化しない判断もできますか？',
    answer:
      'できます。精度、運用負荷、利用者不在、データ不足などから本番化しない方がよい場合は、見送り理由と次に確認すべき条件を残します。',
  },
  {
    question: '途中でプランを変更できますか？',
    answer:
      'できます。AI活用提案で方向を決めてから導入伴走支援に移る、自社開発に切り替えるタイミングで実装アドバイスに落とす、といった移行を想定しています。',
  },
  {
    question: 'どのプランが合うか分かりません。',
    answer:
      '無料相談で現状を伺い、こちらから提案します。判断材料が足りない段階であればAI活用提案から、作るものが見えているなら導入伴走支援から、というのが一般的な入り口です。',
  },
];
---

<Layout title={`${seoTitle} | Beekle`} description={seoDescription} canonical={pageUrl}>
  <JsonLd
    slot="head"
    type="service"
    data={{
      serviceName: 'AI導入支援（AI活用提案・AI実装アドバイス・AI導入伴走支援）',
      serviceDescription: seoDescription,
      url: pageUrl,
      serviceType: 'AI導入支援・コンサルティング',
      image: `${siteUrl}/og-image.png`,
    }}
  />
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: 'AI導入支援3プラン', url: '/services/ai-adoption' },
      ],
    }}
  />
  <JsonLd slot="head" type="faq" data={{ faqs }} />

  <Header />

  <main class="bg-neutral-100 pt-20">
    <!-- ============ HERO ============ -->
    <section class="relative overflow-hidden border-b border-neutral-300 bg-neutral-100 py-14 md:py-20">
      <div class="container mx-auto px-8 lg:px-12 relative">
        <div class="grid gap-10 lg:grid-cols-[0.82fr_0.72fr] lg:items-center">
        <div class="max-w-3xl">
          <span class="inline-block border-l-8 border-primary-500 pl-5 text-sm font-bold text-primary-700 mb-6">
              新規事業・DX・情シス担当者へ
          </span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-accent-950 leading-tight mb-6">
            AI導入の失敗を、<br class="hidden sm:block" />業務選定と評価で防ぐ。
          </h1>
          <p class="text-lg md:text-xl text-neutral-700 leading-relaxed mb-8">
            AIを入れる前提で進めず、どの業務から試すべきか、何をもって使えると判断するかを整理します。
            いま着手すべきでない場合は、その理由もお伝えします。
          </p>
          <p class="mb-8 border-y border-neutral-200 py-3 text-sm font-bold leading-relaxed text-accent-950">
            NDA後に詳細確認可 / 提案だけ受け取り他社実装可 / 今やらない判断も可
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="/contact?source=services-ai-adoption-hero&intent=genai-adoption"
              data-cta-source="services-ai-adoption-hero"
              data-cta-id="contact"
              class="inline-flex min-h-[52px] items-center justify-center rounded-md border border-primary-500 bg-primary-500 px-6 py-3 text-center text-base font-bold leading-snug text-white transition hover:border-primary-600 hover:bg-primary-600 sm:px-8"
            >
              AIを入れるべき業務か相談する
              <svg class="ml-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </div>
        </div>

        <aside class="border-y border-neutral-300 bg-white">
          <div class="grid grid-cols-[1fr_auto] gap-4 border-b border-neutral-300 border-l-8 border-primary-500 px-5 py-4">
            <div>
              <p class="text-sm font-bold text-primary-700">AI導入判断メモ</p>
              <p class="mt-1 text-2xl font-bold leading-tight text-accent-950">相談前ドラフト</p>
            </div>
            <p class="font-Poppins text-xs font-bold text-neutral-500">BEEKLE / AI</p>
          </div>
          <dl class="divide-y divide-neutral-300">
            {[
              ['誰向け', '新規事業 / DX / 情シス'],
              ['返すもの', '対象業務、評価基準、概算、進め方'],
              ['見送り条件', 'データ不足、利用者不在、運用体制不足'],
              ['判断', '今やらない判断も明記'],
            ].map(([label, value]) => (
              <div class="grid grid-cols-[112px_1fr]">
                <dt class="border-r border-neutral-200 bg-neutral-50 px-5 py-4 text-sm font-bold text-primary-700">
                  {label}
                </dt>
                <dd class="px-5 py-4 text-base font-bold leading-relaxed text-accent-950">
                  {value}
                </dd>
              </div>
            ))}
          </dl>
        </aside>
        </div>
      </div>
    </section>

    <!-- ============ PAIN POINTS ============ -->
    <Section variant="light" padding="lg">
      <SectionHeader
        title="AI導入は、判断を間違えやすい場面があります"
        subtitle="どこで止まりそうかによって、必要な支援の形は変わります"
        number="01"
        label="ISSUES"
      />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {painPoints.map((pain) => (
          <div class="rounded-lg bg-white p-6 md:p-8">
            <h3 class="text-lg md:text-xl font-bold text-navy-950 leading-snug mb-3">
              {pain.title}
            </h3>
            <p class="text-sm md:text-base text-neutral-700 leading-relaxed">{pain.description}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- ============ PLAN COMPARISON ============ -->
    <Section variant="white" padding="lg" id="plans">
      <SectionHeader
        title="3つのプラン"
        subtitle="何が判断できる状態になるか、どの成果物が残るかで選べます"
        number="02"
        label="PLANS"
      />

      <!-- モバイル: プランごとに縦積み -->
      <div class="md:hidden space-y-6">
        {plans.map((plan) => (
          <div
            class:list={[
              'rounded-lg border bg-white p-6',
              plan.featured ? 'border-primary-300' : 'border-neutral-200',
            ]}
          >
            <div class="flex items-baseline gap-3 mb-2">
              <span class="font-Poppins text-3xl font-bold text-primary-500">{plan.no}</span>
              <span class="text-xs font-semibold uppercase tracking-wide text-primary-500">
                {plan.code}
              </span>
            </div>
            <h3 class="text-xl font-bold text-navy-950 mb-2">{plan.name}</h3>
            <p class="text-sm text-neutral-700 leading-relaxed mb-4">{plan.tagline}</p>
            <p class="mb-5">
              <span class="font-Poppins text-3xl font-bold text-navy-950">
                &yen;{plan.price}
              </span>
              <span class="ml-1 text-sm font-medium text-neutral-600">/ {plan.priceUnit}（税別）</span>
            </p>
            <dl class="space-y-3 border-t border-neutral-200 pt-4">
              {comparisonRows.map((row) => (
                <div>
                  <dt class="text-xs font-bold text-primary-700">{row.label}</dt>
                  <dd class="text-sm text-neutral-700 leading-relaxed">{plan[row.key]}</dd>
                </div>
              ))}
            </dl>
            <a
              href={`/contact?source=services-ai-adoption-plan-${plan.no}&intent=genai-adoption`}
              data-cta-source={`services-ai-adoption-plan-${plan.no}`}
              data-cta-id="contact"
              class="mt-6 inline-flex w-full min-h-[52px] items-center justify-center rounded-md bg-primary-500 px-6 py-3 text-base font-bold text-white transition hover:bg-primary-600"
            >
              このプランを相談する
            </a>
          </div>
        ))}
      </div>

      <!-- PC: 比較表 -->
      <div class="hidden md:block max-w-6xl mx-auto">
        <table class="w-full border-separate border-spacing-x-3">
          <caption class="sr-only">AI導入支援3プランの比較表</caption>
          <thead>
            <tr>
              <th scope="col" class="w-40"><span class="sr-only">項目</span></th>
              {plans.map((plan) => (
                <th scope="col" class="align-bottom p-0">
                  <div
                    class:list={[
                      'rounded-t-lg border-x border-t bg-white px-6 pt-8 pb-6 text-left',
                      plan.featured ? 'border-primary-300' : 'border-neutral-200',
                    ]}
                  >
                    <div class="flex items-baseline gap-3 mb-2">
                      <span class="font-Poppins text-4xl font-bold text-primary-500">{plan.no}</span>
                      <span class="text-xs font-semibold uppercase tracking-wide text-primary-500">
                        {plan.code}
                      </span>
                    </div>
                    <p class="text-xl font-bold text-navy-950 mb-2">{plan.name}</p>
                    <p class="text-sm font-normal text-neutral-700 leading-relaxed mb-5">
                      {plan.tagline}
                    </p>
                    <p>
                      <span class="font-Poppins text-3xl font-bold text-navy-950">
                        &yen;{plan.price}
                      </span>
                      <span class="ml-1 text-sm font-medium text-neutral-600">
                        / {plan.priceUnit}（税別）
                      </span>
                    </p>
                  </div>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr>
                <th scope="row" class="py-4 pr-4 text-left align-top text-sm font-bold text-primary-700">
                  {row.label}
                </th>
                {plans.map((plan) => (
                  <td
                    class:list={[
                      'border-x border-b border-neutral-100 bg-white px-6 py-4 align-top text-sm leading-relaxed text-neutral-700',
                      plan.featured ? 'border-x-primary-300' : 'border-x-neutral-200',
                    ]}
                  >
                    {plan[row.key]}
                  </td>
                ))}
              </tr>
            ))}
            <tr>
              <td></td>
              {plans.map((plan) => (
                <td
                  class:list={[
                    'rounded-b-lg border-x border-b bg-white px-6 pt-2 pb-8',
                    plan.featured ? 'border-primary-300' : 'border-neutral-200',
                  ]}
                >
                  <a
                    href={`/contact?source=services-ai-adoption-plan-${plan.no}&intent=genai-adoption`}
                    data-cta-source={`services-ai-adoption-plan-${plan.no}`}
                    data-cta-id="contact"
                    class="inline-flex w-full min-h-[52px] items-center justify-center rounded-md bg-primary-500 px-6 py-3 text-base font-bold text-white transition hover:bg-primary-600 "
                  >
                    このプランを相談する
                  </a>
                </td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>

      <p class="mt-8 text-center text-sm text-neutral-600 leading-relaxed">
        表示価格はすべて税別です。3プランとも時間単価{HOURLY_RATE}円（税別）で算出しています。<br class="hidden md:block" />
        記載の時間は目安で、範囲が変わりそうな場合はその時点でご相談してから調整します。
      </p>
    </Section>

    <!-- ============ PLAN DETAILS ============ -->
    <Section variant="light" padding="sm">
      <SectionHeader
        title="発注前に見るべき差分だけまとめます"
        subtitle="詳しい手順より、何が残り、どこから先は対象外かを先に確認できます"
        number="03"
        label="DETAILS"
      />

      <div class="mx-auto grid max-w-5xl gap-5 md:grid-cols-3">
        {detailCards.map((detail) => (
          <article class="rounded-lg border border-neutral-200 bg-white p-6">
            <h3 class="text-xl font-bold leading-snug text-navy-950">{detail.title}</h3>
            <p class="mt-4 text-sm font-bold leading-relaxed text-primary-700">
              {detail.result}
            </p>
            <p class="mt-3 text-sm leading-relaxed text-neutral-700">{detail.boundary}</p>
          </article>
        ))}
      </div>
    </Section>

    <!-- ============ PROOF ============ -->
    <Section variant="white" padding="lg">
      <SectionHeader
        title="作れることと、判断できることを分けて示します"
        subtitle="公開デモで実装力を、事例で評価設計と本番判断の進め方を確認できます"
        number="04"
        label="PROOF"
      />
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-2 gap-6 mb-8">
          <a
            href="/demos/it-advisor"
            data-cta-source="services-ai-adoption-demos"
            data-cta-id="demo-it-advisor"
            class="group block rounded-lg border border-neutral-200 bg-white p-6 transition hover:border-primary-300 "
          >
            <span class="mb-3 inline-block rounded-md bg-primary-50 px-2 py-1 text-xs font-bold text-primary-700">
              社内資料検索
            </span>
            <h3 class="mb-2 text-xl font-bold text-navy-950 transition group-hover:text-primary-600">
              AIナレッジ相談
            </h3>
            <p class="text-sm leading-relaxed text-neutral-700">
              Beekleのコラム記事をもとに回答する相談員AI。社内資料を探して答える仕組みの精度を、その場で確かめられます。
            </p>
            <span class="mt-4 inline-flex items-center text-sm font-medium text-primary-600">
              試してみる →
            </span>
          </a>
          <a
            href="/demos/ocr"
            data-cta-source="services-ai-adoption-demos"
            data-cta-id="demo-ocr"
            class="group block rounded-lg border border-neutral-200 bg-white p-6 transition hover:border-primary-300 "
          >
            <span class="mb-3 inline-block rounded-md bg-secondary-50 px-2 py-1 text-xs font-bold text-secondary-600">
              書類読み取り
            </span>
            <h3 class="mb-2 text-xl font-bold text-navy-950 transition group-hover:text-primary-600">
              AI領収書OCR
            </h3>
            <p class="text-sm leading-relaxed text-neutral-700">
              画像から店舗名・日付・合計・明細を読み取ります。手入力をAIで置き換えたときの精度感を体感できます。
            </p>
            <span class="mt-4 inline-flex items-center text-sm font-medium text-primary-600">
              試してみる →
            </span>
          </a>
        </div>
        <div class="rounded-lg border border-neutral-200 bg-neutral-50 p-6 md:p-8">
          <h3 class="mb-3 text-lg md:text-xl font-bold text-navy-950">
            業務選定と評価設計まで見える判断材料
          </h3>
          <div class="grid gap-4 md:grid-cols-3">
            {[
              ['評価シート', '対象業務、想定効果、必要データ、失敗条件を分けて記録します。'],
              ['見送り判断例', 'データ不足、利用者不在、運用負荷過多など、見送り理由も残します。'],
              ['本番化レビュー', '精度、権限、ログ、コスト、現場の確認手順を見ます。'],
            ].map(([title, text]) => (
              <div class="border-l-4 border-primary-500 bg-white px-4 py-3">
                <p class="text-sm font-bold text-primary-700">{title}</p>
                <p class="mt-2 text-sm leading-relaxed text-neutral-700">{text}</p>
              </div>
            ))}
          </div>
          <p class="mb-5 mt-5 text-sm md:text-base leading-relaxed text-neutral-700">
            社内文書のAI検索、生成AI OCRによる売上データ化、上流工程を支援するAIエージェントなど、
            何をAIに任せ、どこに人の確認を残し、何を見て本番化を判断したのかを確認できます。
          </p>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a
              href="/case-studies?ref=services-ai-adoption"
              data-cta-source="services-ai-adoption-proof"
              data-cta-id="case-studies"
              class="inline-flex min-h-[52px] items-center justify-center rounded-md bg-primary-500 px-6 py-3 text-base font-bold text-white transition hover:bg-primary-600 "
            >
              導入事例を見る
            </a>
            <a
              href="/contact?source=services-ai-adoption-proof&intent=genai-adoption"
              data-cta-source="services-ai-adoption-proof"
              data-cta-id="contact"
              class="inline-flex min-h-[52px] items-center justify-center rounded-md border border-primary-300 px-6 py-3 text-base font-bold text-primary-700 transition hover:border-primary-500 hover:bg-primary-50"
            >
              自社の場合を相談する（無料・30分）
            </a>
          </div>
        </div>
      </div>
    </Section>

    <!-- ============ FLOW ============ -->
    <Section variant="light" padding="lg">
      <SectionHeader
        title="ご相談から開始までの流れ"
        subtitle="プランを決めるところから無料でご相談いただけます"
        number="05"
        label="FLOW"
      />
      <div class="max-w-4xl mx-auto space-y-5">
        {steps.map((step) => (
          <div class="flex flex-col gap-4 rounded-lg border border-neutral-200 bg-white p-6 sm:flex-row sm:items-start sm:gap-6 md:p-8">
            <span class="font-Poppins text-4xl font-bold text-primary-500 leading-none shrink-0">
              {step.no}
            </span>
            <div>
              <h3 class="text-lg md:text-xl font-bold text-navy-950 mb-2">{step.title}</h3>
              <p class="text-sm md:text-base text-neutral-700 leading-relaxed">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </Section>

    <!-- ============ FAQ ============ -->
    <Section variant="white" padding="lg">
      <SectionHeader
        title="よくあるご質問"
