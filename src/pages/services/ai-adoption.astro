                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <p class="mt-4 text-sm md:text-base text-neutral-700 leading-relaxed">{faq.answer}</p>
