---
import { Header } from '../components/header';
import JsonLd from '../components/seo/json-ld.astro';
import { PageHero } from '../components/ui/page-hero';
import Layout from '../layouts/layout.astro';
import { type MicroCMSEnv, getCategories, getColumns, getPillarSlug } from '../lib/microcms';

// Cloudflare Pages SSR: ランタイム環境変数を取得
const runtime = (Astro.locals as { runtime?: { env?: MicroCMSEnv } }).runtime;
const env = runtime?.env;

// SSR: リクエスト時にMicroCMSから取得
let categories: Awaited<ReturnType<typeof getCategories>> = [];
let allColumns: Awaited<ReturnType<typeof getColumns>> = [];
let apiError: string | null = null;

try {
  categories = await getCategories(env);
  const rawColumns = await getColumns(undefined, env);
  // knowledge カテゴリの記事はナレッジセクションに表示するため除外
  allColumns = rawColumns.filter((c) => c.category?.id !== 'knowledge');

  // 環境変数が設定されているのにデータが空の場合
  if (categories.length === 0 && allColumns.length === 0) {
    console.warn('MicroCMS returned empty data. Check API configuration.');
  }
} catch (error) {
  console.error('Failed to load MicroCMS data:', error);
  apiError = error instanceof Error ? error.message : 'Unknown error';
}

// カテゴリーごとに記事を収集
// knowledge カテゴリは専用の /knowledge ページで扱うため、この一覧には出さない
const columnCategories = categories
  .filter((category) => category.id !== 'knowledge')
  .map((category) => {
    const categoryColumns = allColumns.filter((column) => column.category?.id === category.id);

    const pillarSlug = getPillarSlug(category.id);
    // ピラー記事のタイトルを取得
    const pillarArticle = pillarSlug ? categoryColumns.find((c) => c.id === pillarSlug) : undefined;
    // ピラー記事は個別記事一覧から除外し、除外後に番号を振る
    const filteredColumns = pillarSlug
      ? categoryColumns.filter((c) => c.id !== pillarSlug)
      : categoryColumns;
    // セクションは最新6本のみ表示し、残りは専用カテゴリページ（/column/<id>）に誘導する
    const totalArticleCount = filteredColumns.length;
    const filteredArticles = filteredColumns.slice(0, 6).map((column, index) => ({
      number: String(index + 1).padStart(2, '0'),
      title: column.title,
      slug: column.id,
    }));

    return {
      id: category.id,
      title: category.title,
      description: category.description,
      icon: category.icon,
      order: category.order,
      pillarSlug,
      pillarTitle: pillarArticle?.title,
      articles: filteredArticles,
      totalArticleCount,
    };
  })
  .sort((a, b) => a.order - b.order);
---

<Layout
  title="コラムで学ぶシステム発注の知識 | Beekle"
  description="システム開発の発注・外注を成功させるためのノウハウをコラムでご紹介。要件定義、見積もりの見方、ベンダー選定など、発注側が知っておくべき知識を解説します。"
>
  <JsonLd
    slot="head"
    type="breadcrumb"
    data={{
      items: [
        { name: 'ホーム', url: '/' },
        { name: 'コラム', url: '/column' },
      ],
    }}
  />
  {allColumns.length > 0 && (
    <JsonLd
      slot="head"
      type="itemList"
      data={{
        name: 'Beekle コラム一覧',
        url: 'https://beekle.jp/column',
        itemType: 'Article',
        items: allColumns.map((column) => ({
          name: column.title,
          ...(column.description ? { description: column.description } : {}),
          url: `https://beekle.jp/column/${column.id}`,
        })),
      }}
    />
  )}
  <Header />
  <main class="bg-neutral-100 pt-20">
    {/* Hero Section */}
    <PageHero
      title="コラムで学ぶシステム発注の知識"
      subtitle="「開発って、正直よくわからない」という不安を解消。失敗しないための実践的な知識を、体系的にお届けします。"
      badge="Knowledge Base"
    >
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href="#categories"
          class="inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-white bg-primary-500 border border-primary-500 rounded-md hover:bg-primary-600 hover:border-primary-600 transition-colors"
        >
          記事を読む
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
        <a
          href="/prooffirst"
          class="inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-accent-950 bg-white border border-neutral-300 rounded-md hover:border-primary-500 hover:text-primary-600 transition-colors"
        >
          ゼロスタートを見る
        </a>
      </div>
    </PageHero>

    {/* API Error - ユーザーには汎用メッセージのみ表示 */}
    {apiError && (
      <section class="py-8">
        <div class="container mx-auto px-6 md:px-8">
          <div class="rounded-lg border border-neutral-200 bg-neutral-50 p-8 text-center">
            <p class="text-gray-600">現在コンテンツを読み込めません。しばらくしてから再度お試しください。</p>
          </div>
        </div>
      </section>
    )}

    {/* Column Categories */}
    <section id="categories" class="border-b border-neutral-300 bg-neutral-100 py-16 md:py-24">
      <div class="container mx-auto px-6 md:px-8">
        {columnCategories.map((category) => (
          <div id={category.id} class="mb-20 scroll-mt-24">
            {/* Category Header */}
            <div class="mb-12">
              <div class="flex items-center gap-4 mb-4">
                {/* Category Icon */}
                <div class="flex h-16 w-16 flex-shrink-0 items-center justify-center rounded-lg bg-accent-950 font-Poppins text-2xl font-bold text-white">
                  {String(columnCategories.indexOf(category) + 1).padStart(2, '0')}
                </div>

                <div class="flex-1">
                  <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">
                    {category.title}
                  </h2>
                  <p class="text-lg text-gray-600">
                    {category.description}
                  </p>
                </div>
              </div>
              <div class="border-t-2 border-primary-200"></div>
            </div>

            {/* Pillar Article Link */}
            {category.pillarSlug && (
              <a
                href={`/column/${category.pillarSlug}`}
                class="group mb-8 flex items-center gap-4 rounded-lg border border-primary-200 bg-white p-5 transition-colors hover:border-primary-400"
              >
                <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-md bg-primary-500">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                </div>
                <div class="flex-1">
                  <span class="inline-flex items-center px-2 py-0.5 bg-primary-500 text-white text-xs font-bold rounded-full mb-1">
                    完全ガイド
                  </span>
                  <p class="text-lg font-bold text-gray-900 group-hover:text-primary-500 transition-colors leading-tight">
                    {category.pillarTitle || 'まずはこの1本で全体像をつかむ'}
                  </p>
                </div>
                <svg class="w-5 h-5 text-primary-500 group-hover:translate-x-1 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            )}

            {/* Articles Grid */}
            {category.articles.length > 0 ? (
              <div class="grid md:grid-cols-2 gap-6">
                {category.articles.map((article) => (
                  <a
                    href={`/column/${article.slug}`}
                    class="group rounded-lg border border-neutral-200 bg-white p-6 transition-colors hover:border-primary-300 md:p-8"
                  >
                    <div class="flex items-start gap-6">
                      {/* Article Number */}
                      <div class="flex-shrink-0">
                        <div class="flex h-14 w-14 items-center justify-center rounded-md bg-neutral-100 text-lg font-bold text-primary-600">
                          {article.number}
                        </div>
                      </div>

                      {/* Article Content */}
                      <div class="flex-1 min-w-0">
                        <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary-500 transition-colors mb-4 leading-tight">
                          {article.title}
                        </h3>

                        {/* Read More */}
                        <div class="flex items-center text-primary-500 font-semibold text-sm group-hover:translate-x-1 transition-transform">
                          <span>記事を読む</span>
                          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                          </svg>
                        </div>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            ) : (
              <div class="rounded-lg border border-neutral-200 bg-neutral-50 py-12 text-center">
                <p class="text-gray-500">このカテゴリーの記事はまだありません</p>
              </div>
            )}

            {category.totalArticleCount > 0 && (
              <div class="mt-8 text-center">
                <a
                  href={`/column/${category.id}`}
                  class="inline-flex items-center text-primary-500 hover:text-primary-600 font-semibold transition-colors group py-3"
                >
                  <span>「{category.title}」の記事をすべて見る（全{category.totalArticleCount}本）</span>
                  <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    {/* Quick Navigation */}
    <section class="border-y border-neutral-300 bg-neutral-50 py-12">
      <div class="container mx-auto px-6 md:px-8">
        <h3 class="text-xl font-bold text-gray-900 mb-6 text-center">カテゴリーから探す</h3>
        <div class="flex flex-wrap justify-center gap-4">
          {columnCategories.map((category) => (
            <a
              href={`#${category.id}`}
              class="inline-flex items-center gap-2 rounded-md border border-neutral-300 bg-white px-6 py-3 font-medium text-primary-600 transition-colors hover:border-primary-400"
            >
              <span>{category.title}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* Templates & Checklists */}
    <section class="relative py-20 md:py-28 bg-accent-950 text-white overflow-hidden">

      <div class="container mx-auto px-6 md:px-8 relative">
        <div class="max-w-3xl mx-auto text-center mb-16">
          <span class="mb-6 inline-flex items-center rounded-md border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium">
            Templates & Checklists
          </span>
          <h2 class="text-3xl md:text-4xl font-bold mb-4">型・テンプレート・チェックリスト</h2>
          <p class="text-lg text-white/80 leading-relaxed">
            実務でそのまま使えるドキュメントの型や、開発の抜け漏れを防ぐチェックリストを準備中です。
            公開まで今しばらくお待ちください。
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          <a
            href="/docs/user-stories-sample.md"
            download="user-stories-sample.md"
            class="group relative block rounded-lg border border-white/20 bg-white/10 p-8 transition-colors hover:bg-white/15"
          >
            <div class="flex items-start justify-between mb-6">
              <span class="px-3 py-1 text-xs font-semibold rounded-full bg-highlight-500 text-accent-950 border border-highlight-500">
                公開中
              </span>
              <svg class="w-6 h-6 text-white/80 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>

            <h3 class="text-2xl font-semibold mb-3 group-hover:text-white">ユーザーストーリー仕様書サンプル</h3>
            <p class="text-sm text-white/80 leading-relaxed mb-6">
              受発注管理システムを題材に、EARS記法でユースケースを記述したMarkdownのサンプル仕様書。
              そのまま自社プロジェクトに書き換えて開発会社との合意形成に使えます。
            </p>

            <span class="inline-flex items-center text-sm font-semibold text-white group-hover:translate-x-1 transition-transform">
              ダウンロード（.md）
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </span>

            <div class="absolute inset-0 rounded-lg border border-white/0 transition-colors group-hover:border-white/40"></div>
          </a>

          <a
            href="/downloads/beekle-zero-start-sales-deck.pdf"
            download="beekle-zero-start-sales-deck.pdf"
            data-cta-source="column-list-kit"
            data-cta-id="pdf-zero-start-sales-deck"
            class="group relative block rounded-lg border border-white/20 bg-white/10 p-8 transition-colors hover:bg-white/15"
          >
            <div class="flex items-start justify-between mb-6">
              <span class="px-3 py-1 text-xs font-semibold rounded-full bg-highlight-500 text-accent-950 border border-highlight-500">
                公開中
              </span>
              <svg class="w-6 h-6 text-white/80 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>

            <h3 class="text-2xl font-semibold mb-3 group-hover:text-white">ゼロスタート開発 サービス資料</h3>
            <p class="text-sm text-white/80 leading-relaxed mb-6">
              動くプロトタイプで発注前に確かめる進め方、対象になる企業、費用と契約の考え方をまとめた資料です。
              発注前の社内検討にそのまま使えます。
            </p>

            <span class="inline-flex items-center text-sm font-semibold text-white group-hover:translate-x-1 transition-transform">
              資料を無料ダウンロード
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </span>

            <div class="absolute inset-0 rounded-lg border border-white/0 transition-colors group-hover:border-white/40"></div>
          </a>

          <a
            href="/checklists/dev-process"
            class="group relative block rounded-lg border border-white/20 bg-white/10 p-8 transition-colors hover:bg-white/15"
          >
            <div class="flex items-start justify-between mb-6">
              <span class="px-3 py-1 text-xs font-semibold rounded-full bg-highlight-500 text-accent-950 border border-highlight-500">
                公開中
              </span>
              <svg class="w-6 h-6 text-white/80 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
            </div>

            <h3 class="text-2xl font-semibold mb-3 group-hover:text-white">開発プロセスチェックリスト</h3>
            <p class="text-sm text-white/80 leading-relaxed mb-6">
              対話の記録から振り返りまで、システム開発を成功させるための8フェーズのチェックリスト。
              各フェーズの「やること」「判断ポイント」「成果物」を確認しながらプロジェクトを進められます。
            </p>

            <span class="inline-flex items-center text-sm font-semibold text-white group-hover:translate-x-1 transition-transform">
              チェックリストを見る
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </span>

            <div class="absolute inset-0 rounded-lg border border-white/0 transition-colors group-hover:border-white/40"></div>
          </a>
        </div>
      </div>
    </section>

    {/* CTA Section - Zero Start */}
    <section class="relative overflow-hidden bg-navy-950 py-20 md:py-28">

      <div class="container mx-auto px-6 md:px-8 relative">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">
            知識を得たら、次は<br class="md:hidden" />
            <span class="text-highlight-100">実際に体験しませんか？</span>
          </h2>

          <p class="text-xl text-white/90 mb-10 leading-relaxed">
            コラムで学んだ「失敗しない開発」を、ゼロスタートで実践。<br />
            動くプロトタイプで、発注前に作るべきかを確かめられます。
          </p>

          <div class="mb-10 rounded-lg border border-white/20 bg-white/10 p-8">
            <div class="grid md:grid-cols-3 gap-6 text-white">
              <div>
                <div class="text-4xl font-bold mb-2">0円</div>
                <div class="text-white/80">初期費用</div>
              </div>
              <div>
                <div class="text-4xl font-bold mb-2">1-2週間</div>
                <div class="text-white/80">プロトタイプ完成（目安）</div>
              </div>
              <div>
                <div class="text-4xl font-bold mb-2">動くデモ</div>
                <div class="text-white/80">で判断できる</div>
              </div>
            </div>
            <p class="text-xs text-white/60 mt-4">※ プロトタイプ完成までの目安です。規模・要件により変動し、本番開発の確定納期とは異なります。</p>
          </div>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/prooffirst"
              class="inline-flex items-center justify-center rounded-md bg-white px-8 py-4 text-lg font-semibold text-accent-950 transition-colors hover:bg-neutral-100"
            >
              ゼロスタートについて詳しく見る
              <svg class="w-6 h-6 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a
              href="/contact?source=column-list-final"
              data-cta-source="column-list-final"
              data-cta-id="contact"
              class="inline-flex items-center justify-center rounded-md border border-white bg-transparent px-8 py-4 text-lg font-semibold text-white transition-colors hover:bg-white hover:text-accent-950"
            >
              無料相談を予約する
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .scroll-mt-24 {
    scroll-margin-top: 6rem;
  }
</style>
