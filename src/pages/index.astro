---
import ContactForm from '@/components/contact-form';
import { HeroSection } from '@/components/hero-section';
import { ProcessFAQ } from '@/components/process-faq-section';
import { ProcessHero } from '@/components/process-hero';
import { ProcessSteps } from '@/components/process-steps';
import { ButtonLink } from '@/components/ui/button';
import { Header } from '../components/header';
import JsonLd from '../components/seo/json-ld.astro';
import { ServiceCard } from '../components/service-card';
import { services } from '../data/service';

const TOP_SERVICE_IDS = ['ai-development', 'web-mobile-development', 'cdp-development'];
const topServices = services.filter((s) => TOP_SERVICE_IDS.includes(s.id));
import Layout from '../layouts/layout.astro';
import { type MicroCMSEnv, getColumns } from '../lib/microcms';

const runtime = (Astro.locals as { runtime?: { env?: MicroCMSEnv } }).runtime;
const env = runtime?.env;

const FEATURED_COLUMN_IDS = [
  'requirements-definition-complete-guide',
  'requirements-vs-requests',
  'web-system-cost-by-scale',
  'ai-development-cost-guide',
  'project-management-complete-guide',
  'ai-era-development-flow',
];

type ColumnCard = {
  id: string;
  title: string;
  description?: string;
  categoryTitle?: string;
};
let featuredColumns: ColumnCard[] = [];
try {
  const all = await getColumns(undefined, env);
  const map = new Map(all.map((c) => [c.id, c]));
  const toCard = (c: (typeof all)[number]): ColumnCard => ({
    id: c.id,
    title: c.title,
    description: c.description,
    categoryTitle: c.category?.title,
  });
  featuredColumns = FEATURED_COLUMN_IDS.map((id) => map.get(id))
    .filter((c): c is NonNullable<typeof c> => Boolean(c))
    .map(toCard);
} catch (e) {
  console.error('Failed to load columns:', e);
}
---

<Layout
  title="動くプロトタイプから始めるシステム開発｜初期費用0円のゼロスタート | Beekle株式会社"
  description="Beekle株式会社は、AI・Webアプリ・モバイルアプリ開発を手がけるシステム開発会社です。初期費用0円のゼロスタートで、動くプロトタイプを見てから判断できる新しい開発体験を提供します。"
>
  <JsonLd slot="head" type="website" />
  <Header client:idle />
  <main class="">
    {/* メインビジュアル */}
    <HeroSection client:load />

    {/* LP概要 */}
    <section class="relative overflow-hidden bg-white py-20 md:py-24">
      <div class="absolute -top-10 right-8 w-28 h-56 decoration-bar-purple opacity-10"></div>
      <div class="absolute bottom-10 left-4 w-32 h-64 decoration-bar-purple opacity-10"></div>

      <div class="container mx-auto px-8 lg:px-12 relative">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div>
            <span class="number-label">01</span>
            <span class="section-label ml-4">WHY BEEKLE</span>
            <h2 class="mt-4 text-4xl font-bold leading-tight text-navy-950 lg:text-5xl">
              開発前の<span class="text-primary-500">判断材料</span>を、
              <br class="hidden lg:block" />
              先につくります。
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-neutral-700">
              見積書と仕様書だけでは、完成後の使いやすさや効果は判断しきれません。
              Beekleは業務の流れを短く整理し、コア機能を先に触れる形にします。
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-3">
            <div class="card-base p-6">
              <p class="text-sm font-bold text-primary-500">Strength 01</p>
              <h3 class="mt-3 text-xl font-bold leading-snug text-navy-950">
                業務理解から入る
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-neutral-600">
                現場の手順、判断、例外処理を見て、何を作るべきかを絞ります。
              </p>
            </div>
            <div class="card-base p-6">
              <p class="text-sm font-bold text-primary-500">Strength 02</p>
              <h3 class="mt-3 text-xl font-bold leading-snug text-navy-950">
                早く触れる形にする
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-neutral-600">
                コア機能をプロトタイプ化し、画面・操作・回答品質を実物で確認します。
              </p>
            </div>
            <div class="card-base p-6">
              <p class="text-sm font-bold text-primary-500">Strength 03</p>
              <h3 class="mt-3 text-xl font-bold leading-snug text-navy-950">
                導入後まで設計する
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-neutral-600">
                本番化、運用、改善まで見越して、使われ続けるシステムにします。
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* 相談内容の整理 */}
    <section class="relative overflow-hidden bg-neutral-50 py-20 md:py-24">
      <div class="absolute top-16 left-8 w-24 h-48 decoration-bar-purple opacity-10"></div>
      <div class="container mx-auto px-8 lg:px-12 relative">
        <div class="text-center mb-12">
          <span class="number-label">02</span>
          <span class="section-label ml-4">WHAT WE SOLVE</span>
          <h2 class="mt-4 text-4xl font-bold text-navy-950 lg:text-5xl">
            相談が多いのは、この3つです。
          </h2>
          <p class="mx-auto mt-4 max-w-3xl text-lg leading-relaxed text-neutral-600">
            どれも最初から大きな開発に入るより、業務の一部を動く形にしてから判断した方が失敗を減らせます。
          </p>
        </div>

        <div class="grid gap-6 lg:grid-cols-3">
          <a href="/services/ai-development" class="group block">
            <div class="card-base card-hover h-full p-8">
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-primary-50 text-xl font-bold text-primary-500">
                AI
              </span>
              <h3 class="mt-5 text-2xl font-bold leading-snug text-navy-950">
                AIで業務を速くしたい
              </h3>
              <p class="mt-4 leading-relaxed text-neutral-600">
                問い合わせ対応、文書検索、レポート作成など、AIが効く業務を見極めて検証します。
              </p>
              <p class="mt-5 font-semibold text-primary-500 group-hover:text-primary-600">
                AI開発を見る
              </p>
            </div>
          </a>
          <a href="/services/web-mobile-development" class="group block">
            <div class="card-base card-hover h-full p-8">
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-primary-50 text-xl font-bold text-primary-500">
                App
              </span>
              <h3 class="mt-5 text-2xl font-bold leading-snug text-navy-950">
                社内業務をアプリ化したい
              </h3>
              <p class="mt-4 leading-relaxed text-neutral-600">
                Excel、メール、手作業に散らばった業務を、入力から確認まで使いやすく整えます。
              </p>
              <p class="mt-5 font-semibold text-primary-500 group-hover:text-primary-600">
                Web・モバイル開発を見る
              </p>
            </div>
          </a>
          <a href="/services/cdp-development" class="group block">
            <div class="card-base card-hover h-full p-8">
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-primary-50 text-xl font-bold text-primary-500">
                Data
              </span>
              <h3 class="mt-5 text-2xl font-bold leading-snug text-navy-950">
                データを活用したい
              </h3>
              <p class="mt-4 leading-relaxed text-neutral-600">
                顧客情報や行動データを整理し、施策・分析・営業判断に使える状態へ近づけます。
              </p>
              <p class="mt-5 font-semibold text-primary-500 group-hover:text-primary-600">
                顧客データ基盤を見る
              </p>
            </div>
          </a>
        </div>
      </div>
    </section>

    {/* サービス一覧 - Pop Style */}
    <section id="services" class="relative py-32 overflow-hidden bg-white">
      {/* Pop decorations */}
      <div class="absolute top-20 left-0 w-40 h-80 decoration-bar-purple opacity-10 animate-float"></div>
      <div class="absolute bottom-10 right-10 w-32 h-64 decoration-bar-purple opacity-10 animate-float-delay"></div>

      <div class="container mx-auto px-8 lg:px-12 relative">
        <div class="text-center mb-16">
          {/* Number Label */}
          <span class="number-label">03</span>
          <span class="section-label ml-4">SERVICES</span>

          <h2 class="text-4xl lg:text-5xl font-bold text-navy-950 mb-6 mt-4">
            Beekleが<span class="text-primary-500">作れるもの</span>
          </h2>
          <p class="text-xl text-neutral-600 max-w-3xl mx-auto">
            AI・Webアプリ・モバイルアプリ・顧客データ基盤まで。最初に業務課題を絞り、必要な機能から動く形にします。
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {topServices.map((service, index) => (
            <div
              class="h-full transform transition-all duration-500 hover:-translate-y-2"
              style={{ transitionDelay: `${index * 100}ms` }}
            >
              <ServiceCard
                client:visible
                id={service.id}
                title={service.title}
                description={service.description}
              />
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* 開発の流れ - Pop Style */}
    <section id="process" class="relative bg-neutral-50 py-32 overflow-hidden">
      {/* Pop decorations */}
      <div class="absolute -top-10 right-20 w-36 h-72 decoration-bar-purple opacity-10"></div>
      <div class="absolute bottom-40 left-10 w-28 h-56 decoration-bar-purple opacity-10"></div>
      <div class="relative">
        {/* Number Label */}
        <div class="container mx-auto px-8 lg:px-12 mb-8">
          <div class="text-center">
            <span class="number-label">04</span>
            <span class="section-label ml-4">PROCESS</span>
          </div>
        </div>

        <ProcessHero client:visible />
        <div class="container mx-auto">
          <ProcessSteps client:visible />
        </div>

        {/* CTA for Zero Start - Pop Style */}
        <div class="container mx-auto px-8 lg:px-12 mt-16">
          <div class="max-w-4xl mx-auto">
            <div class="bg-primary-500 rounded-[40px] p-10 shadow-medium text-center relative overflow-hidden">
              {/* Inner decorations */}
              <div class="absolute -top-10 -right-10 w-32 h-32 bg-white/10 rounded-full"></div>
              <div class="absolute -bottom-5 -left-5 w-24 h-24 bg-white/10 rounded-full"></div>

              <h3 class="text-3xl font-bold text-white mb-4 relative">
                まずは、ゼロスタートから
              </h3>
              <p class="text-lg text-white/90 mb-8 leading-relaxed relative">
                初期費用0円で、実際に動くものを体験できます。<br />
                お気軽にお問い合わせください。
              </p>
              <div class="flex flex-col sm:flex-row gap-4 justify-center relative">
                <a
                  href="/contact?source=home-zerostart"
                  data-cta-source="home-zerostart"
                  data-cta-id="contact"
                  class="page-cta inline-flex items-center justify-center px-10 py-5 text-xl font-semibold text-primary-500 bg-white rounded-full hover:bg-gray-50 transition-all shadow-soft hover:shadow-medium hover:scale-105 transform"
                >
                  ゼロスタートを始める
                  <svg class="w-6 h-6 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
                <a
                  href="/prooffirst"
                  class="inline-flex items-center justify-center px-10 py-5 text-xl font-semibold text-white bg-transparent border-2 border-white rounded-full hover:bg-white hover:text-primary-500 transition-all"
                >
                  詳しく見る
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>


    {/* COLUMNS - 発注前に読むコラム */}
    <section class="py-32 bg-neutral-50 relative overflow-hidden">
      <div class="absolute top-20 left-0 w-32 h-64 decoration-bar-purple opacity-10"></div>
      <div class="absolute bottom-20 right-0 w-40 h-80 decoration-bar-purple opacity-10"></div>

      <div class="container mx-auto px-8 lg:px-12 relative">
        <div class="text-center mb-16">
          <span class="number-label">05</span>
          <span class="section-label ml-4">COLUMNS</span>
          <h2 class="text-4xl lg:text-5xl font-bold text-navy-950 mb-4 mt-4">
            発注前に読む<span class="text-primary-500">コラム</span>
          </h2>
          <p class="text-xl text-neutral-600">
            見積もり・要件定義・費用相場・AI開発まで、発注者目線で解説しています
          </p>
        </div>

        {featuredColumns.length > 0 && (
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
            {featuredColumns.map((c) => (
              <a href={`/column/${c.id}`} class="group">
                <div class="card-base card-hover card-lift p-6 h-full flex flex-col">
                  {c.categoryTitle && (
                    <span class="inline-block text-xs font-bold text-primary-500 mb-3">
                      {c.categoryTitle}
                    </span>
                  )}
                  <h3 class="text-lg font-bold text-navy-950 group-hover:text-primary-500 transition-colors mb-3 leading-snug">
                    {c.title}
                  </h3>
                  {c.description && (
                    <p class="text-sm text-neutral-600 leading-relaxed flex-grow line-clamp-3">
                      {c.description}
                    </p>
                  )}
                  <span class="mt-4 inline-flex items-center text-sm font-semibold text-primary-500 group-hover:text-primary-600 transition-colors">
                    記事を読む
                    <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        )}

        <div class="text-center mt-12">
          <ButtonLink href="/column" variant="outlinePrimary" size="lg">
            すべてのコラムを見る
          </ButtonLink>
        </div>
      </div>
    </section>

    {/* よくある質問 */}
    <section id="faq" class="py-32 bg-neutral-50">
      <div class="container mx-auto px-8 lg:px-12 mb-8">
        <div class="text-center">
          <span class="number-label">06</span>
          <span class="section-label ml-4">FAQ</span>
        </div>
      </div>
      <ProcessFAQ client:visible />
    </section>

    {/* お問い合わせフォーム - Pop Style */}
    <section class="py-32 bg-white relative overflow-hidden">
      {/* Pop decorations */}
      <div class="absolute top-10 right-20 w-36 h-72 decoration-bar-purple opacity-10 animate-float"></div>
      <div class="absolute bottom-20 left-10 w-28 h-56 decoration-bar-purple opacity-10 animate-float-delay"></div>

      <div class="container mx-auto px-8 lg:px-12 relative">
        <div class="text-center mb-12">
          {/* Number Label */}
          <span class="number-label">07</span>
          <span class="section-label ml-4">CONTACT</span>

          <h2 class="text-4xl lg:text-5xl font-bold text-navy-950 mb-4 mt-4">
            お気軽に<span class="text-primary-500">ご相談</span>ください
          </h2>
          <p class="text-xl text-neutral-600">まずは無料相談から始めましょう</p>
        </div>
        <div class="max-w-2xl mx-auto">
          <div class="card-base p-8">
            <ContactForm client:visible={{ rootMargin: '600px' }} />
          </div>
        </div>
      </div>
    </section>

    {/* CTA Section - Pop Style */}
    <section class="relative py-32 overflow-hidden">
      <div class="absolute inset-0 bg-accent-950" />

      {/* Pop decorations */}
      <div class="absolute -top-20 -left-10 w-48 h-96 decoration-bar-purple opacity-20 animate-float"></div>
      <div class="absolute top-20 right-10 w-40 h-80 decoration-bar-purple opacity-20 animate-float-delay"></div>

      <div class="absolute inset-0 bg-grid-pattern-light opacity-5" />

      <div class="container mx-auto px-8 lg:px-12 relative">
        <div class="text-center">
          <h2 class="text-4xl lg:text-5xl font-bold text-white mb-6">
            まず「動くもの」で確かめてから決めてください。
          </h2>
          <p class="text-xl text-white/90 mb-10 max-w-2xl mx-auto">
            初期費用0円・最短数日で、あなたの業務に合うか実物で判断できます。
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/contact?source=home-final-cta"
              data-cta-source="home-final-cta"
              data-cta-id="contact"
              class="page-cta inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-accent-950 bg-white rounded-full hover:bg-gray-100 transition-all shadow-soft hover:shadow-medium"
            >
              無料相談を予約する
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a
              href="/case-studies"
              class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-transparent border-2 border-white rounded-full hover:bg-white hover:text-accent-950 transition-all"
            >
              導入事例を見る
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(-25deg) }
    50% { transform: translateY(-20px) rotate(-25deg) }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-float-delay {
    animation: float 8s ease-in-out infinite;
    animation-delay: 1s;
  }

  .animate-float-slow {
    animation: float 10s ease-in-out infinite;
    animation-delay: 2s;
  }

  .bg-grid-pattern {
    background-image: linear-gradient(rgba(0, 0, 0, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.03) 1px, transparent 1px);
    background-size: 20px 20px;
  }

  .bg-grid-pattern-light {
    background-image: linear-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
    background-size: 20px 20px;
  }

  /* Pop decoration bars */
  .decoration-bar-purple {
    background: linear-gradient(135deg, #3D4DB7, #a0b0ff);
    border-radius: 9999px;
    transform: rotate(-25deg);
  }

</style>
