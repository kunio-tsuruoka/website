---
import ContactForm from '@/components/contact-form';
import { HeroSection } from '@/components/hero-section';
import { ProcessFAQ } from '@/components/process-faq-section';
import { ProcessHero } from '@/components/process-hero';
import { ProcessSteps } from '@/components/process-steps';
import { ButtonLink } from '@/components/ui/button';
import { Header } from '../components/header';
import JsonLd from '../components/seo/json-ld.astro';
import { companyPositioning } from '../data/company';
import { featuredConsultationSituations } from '../data/consultation-situations';
import Layout from '../layouts/layout.astro';
import { type MicroCMSEnv, getColumns } from '../lib/microcms';

type HomeEnv = MicroCMSEnv & { TURNSTILE_SITE_KEY?: string };
const runtime = (Astro.locals as { runtime?: { env?: HomeEnv } }).runtime;
const env = runtime?.env;
const sitekey = env?.TURNSTILE_SITE_KEY ?? '0x4AAAAAADHmRrTyQk-jx5-X';

const FEATURED_COLUMN_IDS = [
  'requirements-definition-complete-guide',
  'web-system-cost-by-scale',
  'ai-development-cost-guide',
];

type ColumnCard = {
  id: string;
  title: string;
  description?: string;
  categoryTitle?: string;
};

const caseLogs = [
  {
    situation: '難航案件の立て直し',
    result: '3ヶ月停滞 → 3週間',
    material: '要件、実装、インフラを読み直し、再開できる単位へ整理',
  },
  {
    situation: '発注前の認識合わせ',
    result: '議事録 → デモ1日',
    material: 'ヒアリング内容を画面で確認できる検証用プロトタイプへ',
  },
  {
    situation: '新規事業の検証',
    result: '1週間で触れる形へ',
    material: '構想、画面、API、インフラを分断せず判断可能な状態へ',
  },
];

const decisionSheetRows = [
  {
    label: '判断の根拠',
    text: '利用者、対象業務、既存データ、月間工数、制約条件を分けます。',
  },
  {
    label: '検証する問い',
    text: '何を作るかではなく、何が分かれば社内で判断できるかに絞ります。',
  },
  {
    label: '返す資料',
    text: '検証用プロトタイプ、受入条件、概算レンジ、次に確認するリスクを残します。',
  },
];

let featuredColumns: ColumnCard[] = [];
try {
  const all = await getColumns(undefined, env);
  const map = new Map(all.map((c) => [c.id, c]));
  const toCard = (c: (typeof all)[number]): ColumnCard => ({
    id: c.id,
    title: c.title,
    description: c.description,
    categoryTitle: c.category?.title,
  });
  featuredColumns = FEATURED_COLUMN_IDS.map((id) => map.get(id))
    .filter((c): c is NonNullable<typeof c> => Boolean(c))
    .map(toCard);
} catch (e) {
  console.error('Failed to load columns:', e);
}
---

<Layout
  title="要件が曖昧でも、発注判断の材料まで作る | Beekle株式会社"
  description={`Beekle株式会社は、${companyPositioning.short}${companyPositioning.long}${companyPositioning.zeroStart}`}
>
  <JsonLd slot="head" type="website" />
  <Header />
  <main class="">
    {/* メインビジュアル */}
    <HeroSection />

    {/* 実案件による証明 */}
    <section class="relative overflow-hidden bg-neutral-50 py-14 md:py-16">
      <div class="container mx-auto px-8 lg:px-12 relative">
        <div class="grid gap-8 border-b border-neutral-200 pb-8 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
          <div>
            <span class="section-label">実案件の変化</span>
            <h2 class="mt-3 text-3xl font-bold leading-tight text-navy-950 md:text-4xl">
              先に、実案件ログを見てください。
            </h2>
            <p class="mt-4 text-base leading-relaxed text-neutral-600">
              工程説明よりも、発注判断に使える変化を先に出します。
            </p>
            <a href="/case-studies" class="mt-5 inline-flex min-h-[44px] items-center border-b border-primary-500 text-sm font-bold text-primary-500 hover:text-primary-600">
              実案件をすべて見る
            </a>
          </div>
          <div class="case-log-table border-t border-neutral-300">
            {caseLogs.map((item) => (
              <a href="/case-studies" class="grid gap-3 border-b border-neutral-300 py-5 transition hover:bg-neutral-50 md:grid-cols-[0.72fr_0.68fr_1fr] md:px-2">
                <p class="text-sm font-bold text-primary-700">{item.situation}</p>
                <p class="font-Poppins text-3xl font-bold leading-tight text-primary-600">{item.result}</p>
                <p class="text-sm leading-relaxed text-neutral-700">{item.material}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* LP概要 */}
    <section class="relative overflow-hidden bg-neutral-50 py-14 md:py-16">
      <div class="container mx-auto px-8 lg:px-12 relative">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <div>
            <span class="number-label">01</span>
            <span class="section-label ml-4">Beekleの判断支援</span>
            <h2 class="mt-4 text-4xl font-bold leading-tight text-navy-950 lg:text-5xl">
              業務課題を、
              <br class="hidden lg:block" />
              <span class="text-primary-500">発注判断に使える実物</span>へ。
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-neutral-700">
              「何を作るべきか」が曖昧なまま見積もりや開発に入ると、作った後に認識のズレが出ます。
              Beekleは、業務の困りごとを聞き、検証すべき範囲を絞り、動くものを見ながら社内で説明できる判断材料へ変えます。
            </p>
            <p class="mt-4 text-lg leading-relaxed text-neutral-700">
              口頭の合意やチャットの断片で進めず、受入条件、確認結果、次に見るべきリスクまで残します。社内説明や見積もり比較に使える材料へ変えるためです。
            </p>
            <p class="mt-6 text-xl font-bold leading-relaxed text-navy-950">
              まず決めるのは、作る範囲ではなく、確かめるべき問いです。
            </p>
          </div>

          <div class="decision-sheet-table border-y border-neutral-300 bg-white">
            <div class="grid gap-2 border-b border-neutral-300 border-l-8 border-primary-500 px-5 py-4 md:grid-cols-[0.6fr_1fr]">
              <p class="text-sm font-bold text-primary-700">発注判断シート</p>
              <p class="text-sm font-bold text-accent-950">
                判断の根拠、検証する問い、返す資料を社内説明と見積もり比較に使える形へ戻します。
              </p>
            </div>
            <div class="divide-y divide-neutral-300">
              {decisionSheetRows.map((row, index) => (
                <div class="grid gap-3 px-5 py-5 md:grid-cols-[112px_1fr]">
                  <p class="font-Poppins text-sm font-bold text-primary-600">
                    {String(index + 1).padStart(2, '0')}
                  </p>
                  <div>
                    <h3 class="text-xl font-bold leading-snug text-navy-950">{row.label}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-neutral-700">{row.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* 相談内容の整理 */}
    <section class="relative overflow-hidden bg-neutral-100 py-16 md:py-20">
      <div class="container mx-auto px-8 lg:px-12 relative">
        <div class="text-center mb-12">
          <span class="number-label">02</span>
          <span class="section-label ml-4">相談が始まる場面</span>
          <h2 class="mt-4 text-4xl font-bold text-navy-950 lg:text-5xl">
            発注前に止まりやすい場面から選べます。
          </h2>
          <p class="mx-auto mt-4 max-w-3xl text-lg leading-relaxed text-neutral-600">
            技術カテゴリではなく、いま社内で起きている困りごとから見てください。各入口で、何を確かめれば社内説明に使えるかまで整理します。
          </p>
        </div>

        <div class="grid gap-5 lg:grid-cols-3">
          {featuredConsultationSituations.map((situation, index) => (
            <a href={situation.href} class="group block">
              <div class="card-base card-hover h-full p-7">
                <p class="text-sm font-bold text-primary-500">
                  発注前の詰まり {String(index + 1).padStart(2, '0')}
                </p>
                <h3 class="mt-3 text-2xl font-bold leading-snug text-navy-950">
                  {situation.cardTitle}
                </h3>
                <p class="mt-4 leading-relaxed text-neutral-600">{situation.description}</p>
                <div class="mt-5 grid gap-2 border-t border-neutral-200 pt-4">
                  {situation.rtbItems.slice(0, 2).map((item) => (
                    <p class="text-sm leading-relaxed text-neutral-700">
                      <span class="font-bold text-primary-700">{item.label}</span>: {item.value}
                    </p>
                  ))}
                </div>
                <p class="mt-5 text-sm font-semibold text-primary-500 group-hover:text-primary-600">
                  場面別に判断材料を見る
                </p>
              </div>
            </a>
          ))}
        </div>

        <div class="mt-10 text-center">
          <a
            href="/situations"
            class="inline-flex min-h-[52px] items-center justify-center border border-primary-500 px-8 py-4 text-base font-semibold text-primary-500 transition-colors hover:bg-primary-500 hover:text-white"
          >
            相談が始まる場面をすべて見る
          </a>
        </div>
      </div>
    </section>

    {/* 開発の流れ */}
    <section id="process" class="relative bg-neutral-50 py-20 md:py-24 overflow-hidden">
      <div class="relative">
        {/* Number Label */}
        <div class="container mx-auto px-8 lg:px-12 mb-8">
          <div class="text-center">
            <span class="number-label">03</span>
            <span class="section-label ml-4">進め方</span>
          </div>
        </div>

        <ProcessHero client:visible />
        <div class="container mx-auto">
          <ProcessSteps client:visible />
        </div>

        {/* CTA for Zero Start */}
        <div class="container mx-auto px-8 lg:px-12 mt-16">
          <div class="max-w-4xl mx-auto">
            <div class="relative overflow-hidden border-y border-neutral-300 border-l-8 border-primary-500 bg-white p-8 md:p-10">
              <h3 class="text-3xl font-bold text-accent-950 mb-4 relative">
                実物で確かめてから、次の投資条件を決めてください
              </h3>
              <p class="text-lg text-neutral-700 mb-8 leading-relaxed relative">
                検証用プロトタイプで、業務に合うか・次に投資すべきかを判断できます。
              </p>
              <div class="flex flex-col sm:flex-row gap-4 relative">
                <a
                  href="/contact?source=home-zerostart"
                  data-cta-source="home-zerostart"
                  data-cta-id="contact"
                  class="page-cta inline-flex min-h-[52px] items-center justify-center rounded-md bg-primary-500 px-8 py-4 text-base font-semibold text-white transition-colors hover:bg-primary-600"
                >
                  実現可否を相談する
                  <svg class="w-6 h-6 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
                <a
                  href="/prooffirst"
                  class="inline-flex min-h-[52px] items-center justify-center border-b border-accent-950 text-base font-semibold text-accent-950 hover:border-primary-500 hover:text-primary-500"
                >
                  初期費用0円の条件を見る
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>


    {/* 発注前に読む判断材料 */}
    <section class="py-16 md:py-20 bg-neutral-50 relative overflow-hidden">
      <div class="container mx-auto px-8 lg:px-12 relative">
        <div class="text-center mb-10">
          <span class="number-label">04</span>
          <span class="section-label ml-4">発注前の判断材料</span>
          <h2 class="text-4xl lg:text-5xl font-bold text-navy-950 mb-4 mt-4">
            発注前に読む<span class="text-primary-500">コラム</span>
          </h2>
          <p class="text-lg text-neutral-600">
            相談前に確認されやすい、費用・要件定義・AI開発の判断材料をまとめています
          </p>
        </div>

        {featuredColumns.length > 0 && (
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
            {featuredColumns.map((c) => (
              <a href={`/column/${c.id}`} class="group">
                <div class="card-base card-hover p-6 h-full flex flex-col">
                  {c.categoryTitle && (
                    <span class="inline-block text-xs font-bold text-primary-500 mb-3">
                      {c.categoryTitle}
                    </span>
                  )}
                  <h3 class="text-lg font-bold text-navy-950 group-hover:text-primary-500 transition-colors mb-3 leading-snug">
                    {c.title}
                  </h3>
                  {c.description && (
                    <p class="text-sm text-neutral-600 leading-relaxed flex-grow line-clamp-3">
                      {c.description}
                    </p>
                  )}
                  <span class="mt-4 inline-flex items-center text-sm font-semibold text-primary-500 group-hover:text-primary-600 transition-colors">
                    記事を読む
                    <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        )}

        <div class="text-center mt-12">
          <ButtonLink href="/column" variant="outlinePrimary" size="lg">
            すべてのコラムを見る
          </ButtonLink>
        </div>
      </div>
    </section>

    {/* よくある質問 */}
    <section id="faq" class="py-16 md:py-20 bg-neutral-100">
      <div class="container mx-auto px-8 lg:px-12 mb-8">
        <div class="text-center">
          <span class="number-label">05</span>
          <span class="section-label ml-4">よくあるご不安</span>
        </div>
      </div>
      <ProcessFAQ client:visible />
    </section>

    {/* お問い合わせフォーム */}
    <section class="py-16 md:py-20 bg-neutral-50 relative overflow-hidden">
      <div class="container mx-auto px-8 lg:px-12 relative">
        <div class="text-center mb-12">
          {/* Number Label */}
          <span class="number-label">06</span>
          <span class="section-label ml-4">相談前の安心材料</span>

          <h2 class="text-4xl lg:text-5xl font-bold text-navy-950 mb-4 mt-4">
            業務課題を<span class="text-primary-500">相談</span>する
          </h2>
          <p class="text-lg text-neutral-600">
            NDA可・要件未確定でも可。通常1〜2営業日以内に、概算レンジと進め方の候補を返信します。
          </p>
          <div class="mt-6 grid gap-3 sm:grid-cols-3">
            {['NDA締結可', '要件未確定でも可', '見送り条件も整理'].map((item) => (
              <div class="border-l-4 border-primary-500 bg-white px-4 py-3 text-sm font-bold text-primary-700">
                {item}
              </div>
            ))}
          </div>
        </div>
        <div class="max-w-2xl mx-auto">
          <ContactForm client:visible={{ rootMargin: '600px' }} sitekey={sitekey} />
        </div>
      </div>
    </section>

    {/* CTA Section */}
    <section class="relative py-20 md:py-24 overflow-hidden">
      <div class="absolute inset-0 bg-accent-950" />

      <div class="container mx-auto px-8 lg:px-12 relative">
        <div class="text-center">
          <h2 class="text-4xl lg:text-5xl font-bold text-white mb-6">
            まず「動くもの」で確かめてから、次の投資条件を決めてください。
          </h2>
          <p class="text-xl text-white/90 mb-10 max-w-2xl mx-auto">
            NDA可。要件未確定でも構いません。合わない場合は、開発を勧めず見送り理由をお伝えします。
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/contact?source=home-final-cta"
              data-cta-source="home-final-cta"
              data-cta-id="contact"
              class="page-cta inline-flex min-h-[52px] items-center justify-center rounded-md bg-white px-8 py-4 text-lg font-semibold text-accent-950 transition-colors hover:bg-neutral-100"
            >
              実現可否を相談する
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a
              href="/case-studies"
              class="inline-flex min-h-[52px] items-center justify-center text-base font-semibold text-white underline-offset-4 hover:underline"
            >
              導入事例を見る
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer></script>
</Layout>

<style></style>
