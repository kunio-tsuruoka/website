---
import { AskAiButton } from '@/components/ask-ai-button';

interface Props {
  serviceId: string;
  placement: 'overview' | 'solutions' | 'cases';
}

const { serviceId, placement } = Astro.props;

const content = {
  overview: {
    eyebrow: 'まずは相談から',
    title: '自社の業務で使えるか、整理してみませんか？',
    description:
      'まだ要件が固まっていなくても問題ありません。課題を伺い、試す価値がある業務から整理します。',
    label: '自社で使えるか相談する',
  },
  solutions: {
    eyebrow: '具体的な進め方を確認',
    title: 'どこから着手すべきか、初回相談で切り分けます',
    description:
      '初回相談は無料です。業務、データ、既存システムを確認し、小さく検証できる範囲をご提案します。',
    label: '初回相談を予約する',
  },
  cases: {
    eyebrow: '似た課題がある方へ',
    title: '自社の場合はどうなるか、相談してみませんか',
    description: '業務内容と現在のデータを伺い、最初に検証すべき範囲をご案内します。',
    label: '自社の場合を無料で相談する',
  },
} as const;

// 事例直後のCTAは、サービスごとに「何を相談できるか」を具体的に言い切る（改善指示書 8）
const SERVICE_CTA: Record<string, { title: string; label: string }> = {
  'ai-development': {
    title: 'どの業務をAIに任せられるか、相談してみませんか',
    label: '自社でAIに任せられる業務を相談する',
  },
  'rag-system-development': {
    title: '社内資料で、根拠付きAI検索ができるか確かめてみませんか',
    label: '社内資料で、根拠付きAI検索ができるか相談する',
  },
  'internal-document-ai-search': {
    title: '自社の文書で「探す時間」をどこまで減らせるか、相談してみませんか',
    label: '自社文書で何が探せるようになるか相談する',
  },
  'ai-chatbot-development': {
    title: '自社の問い合わせを、どこまでAIに任せられるでしょうか',
    label: '自社問い合わせの何割をAIに任せられるか相談する',
  },
  'ocr-ai-development': {
    title: '自社の帳票で、どこまで手入力を減らせるでしょうか',
    label: '自社帳票でどこまで手入力を減らせるか相談する',
  },
  'ai-agent-development': {
    title: 'どこまでをAIに任せ、どこから人が承認するか相談してみませんか',
    label: '任せる範囲と承認の設計を相談する',
  },
  'requirements-definition-support': {
    title: '自社の要件定義を、実装につながる形にできますか',
    label: '要件定義の進め方を相談する',
  },
};

const base = content[placement];
const override = placement === 'cases' ? SERVICE_CTA[serviceId] : undefined;
const cta = { ...base, ...override };
const source = `services-${serviceId}-${placement}`;
const AI_SERVICE_INTENTS: Record<string, string> = {
  'ai-agent-development': 'ai-agent-development',
  'ai-chatbot-development': 'ai-chatbot-development',
  'ai-development': 'genai-adoption',
  'internal-document-ai-search': 'document-ai-search',
  'ocr-ai-development': 'ocr-ai-development',
  'rag-system-development': 'rag-system-development',
};
const contactIntent = AI_SERVICE_INTENTS[serviceId] ?? 'consult';
---

<aside class="bg-neutral-50 px-6 py-4 lg:px-12">
  <div class="relative mx-auto flex max-w-6xl flex-col gap-5 overflow-hidden rounded-lg border border-primary-200 bg-white p-5 md:flex-row md:items-center md:justify-between md:p-6">
    <div class="relative max-w-3xl">
      <p class="text-xs font-bold tracking-wide text-primary-500">{cta.eyebrow}</p>
      <h2 class="mt-2 text-xl font-bold leading-snug text-accent-950 md:text-2xl">{cta.title}</h2>
      <p class="mt-2 text-sm leading-relaxed text-neutral-700 md:text-base">{cta.description}</p>
    </div>
    <div class="relative flex w-full shrink-0 flex-col items-stretch gap-2 md:w-auto md:items-end">
      <a
        href={`/contact?source=${source}&intent=${contactIntent}`}
        data-cta-source={source}
        data-cta-id={`contact-${contactIntent}`}
        class="inline-flex min-h-[52px] items-center justify-center rounded-md bg-primary-500 px-6 py-3 text-center text-sm font-bold leading-snug text-white transition-colors hover:bg-primary-600 md:text-base"
      >
        {cta.label}
        <svg class="ml-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
      <AskAiButton
        client:visible
        source={source}
        variant="link"
        pageTitle={cta.title}
        pageSummary={cta.description}
      />
    </div>
  </div>
</aside>
