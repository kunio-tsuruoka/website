---
// AI受託開発の「発注の流れ」セクション（AI系サービスLP共通）
// 不確実性の高いAI開発を、小さく検証してから実導入へ進める進め方を見せる。
interface Step {
  label: string;
  title: string;
  description: string;
}

const steps: Step[] = [
  {
    label: 'STEP 1',
    title: 'ヒアリングでユースケースを確定する',
    description:
      '現場の作業、判断基準、例外処理、使っているデータを聞き出します。「AIで何か」ではなく、どの業務をどう変えるかまで絞り込みます。',
  },
  {
    label: 'STEP 2',
    title: '知識構造・権限・評価基準を設計する',
    description:
      'RAGなら文書同士の関係や根拠提示、エージェントなら任せる範囲・承認・ログを設計します。評価データと合格基準も先に決めます。',
  },
  {
    label: 'STEP 3',
    title: '設計したユースケースをPoCで検証する',
    description:
      'いきなり大きく作らず、決めたユースケースだけを動く形にします。現場で使えるか、削減時間・精度・確認工数・運用負荷を見ながら検証します。',
  },
  {
    label: 'STEP 4',
    title: '効果が見込めれば実導入',
    description:
      'PoCで効果が確認できたら本番化し、現場で使われる状態まで伴走します。期待した効果が見込めなければ、ここで撤退も判断できます。PoC止まりや過剰投資を避けられるのが、この進め方の狙いです。',
  },
];

const eyebrow = '発注の流れ';
const title = '相談から本番運用まで、どう進めるか';
const lead =
  'AI開発は、作る前にどれだけ業務を理解し、ユースケースと評価基準を固められるかで決まります。Beekleはヒアリングから入り、設計した範囲だけを小さく検証して本番化します。';
const outcome = '技術検証で終わらせず、業務で使える設計に落とす。ここがBeekleの強みです。';
---

<section class="relative overflow-hidden bg-neutral-100 py-16 md:py-20">
  <div class="container relative mx-auto px-6 lg:px-12">
    <div class="mx-auto max-w-4xl">
      <div class="max-w-3xl">
        <p class="text-sm font-bold tracking-wide text-primary-500">{eyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold leading-tight text-accent-950 md:text-4xl">
          {title}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-neutral-700 md:text-lg">{lead}</p>
      </div>

      <ol class="mt-10 space-y-4">
        {steps.map((step, index) => (
          <li class="relative flex gap-5">
            <div class="flex flex-col items-center">
              <span class:list={[
                'flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-base font-bold text-white',
                index === steps.length - 1 ? 'bg-primary-600' : 'bg-primary-500',
              ]}>
                {index + 1}
              </span>
              {index < steps.length - 1 && (
                <span class="mt-1 w-px flex-1 bg-primary-200" aria-hidden="true"></span>
              )}
            </div>
            <article class="mb-1 flex-1 rounded-lg border border-primary-100 bg-white p-5 transition-colors hover:border-primary-300 md:p-6">
              <p class="font-Poppins text-xs font-bold tracking-wide text-primary-600">{step.label}</p>
              <h3 class="mt-1 text-xl font-bold leading-snug text-accent-950">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-700 md:text-base">{step.description}</p>
            </article>
          </li>
        ))}
      </ol>

      <div class="mt-6 flex items-start gap-3 rounded-lg bg-accent-950 p-4 text-white md:px-5">
        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-secondary-400 text-sm font-bold text-accent-950">
          ✓
        </span>
        <p class="text-sm font-bold leading-relaxed md:text-base">{outcome}</p>
      </div>
    </div>
  </div>
</section>
