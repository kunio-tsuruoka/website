---
interface Props {
  serviceId: string;
}

type PackageConfig = {
  promise: string;
  process: string[];
  deliverables: string[];
  boundary: string;
};

const { serviceId } = Astro.props;

const configs: Record<string, PackageConfig> = {
  'web-mobile-development': {
    promise:
      '要件が固まっていない段階から入り、動くものを確認しながら仕様を固め、実装・テスト・公開・運用まで一つのチームで進めます。',
    process: [
      '業務・課題ヒアリング',
      '要求・スコープ整理',
      'プロトタイプ確認',
      '受入条件・設計',
      '実装・テスト',
      '公開・運用改善',
    ],
    deliverables: [
      '要求・ユーザーストーリー・受入条件',
      '画面・動くプロトタイプ',
      'ソースコードと実稼働システム',
      'テスト結果・リリース判断材料',
      'インフラ・運用手順・改善バックログ',
    ],
    boundary:
      '機能数・連携先・非機能要件によって期間と費用は変わります。最初に固定し切らず、優先順位と受入条件を合意して段階的に進めます。',
  },
  'cdp-development': {
