---
import { AskAiButton } from '@/components/ask-ai-button';
import type { ServiceDetail } from '@/types/service';

type Metric = { label: string; value: string };
type Illustration = { src: string; alt: string; stages: readonly string[] };

interface Props {
  service: ServiceDetail;
  config?: {
    eyebrow: string;
    headline?: string;
    heroLead: string;
    primaryOutcome: string;
    visualTitle: string;
    visualSubtitle: string;
    visualItems: readonly string[];
    illustration?: Illustration;
    metrics: readonly Metric[];
    contactIntent?: string;
    contactLabel?: string;
    showZeroStartLink?: boolean;
  };
}

const { service, config } = Astro.props;
const benefits = service.benefits.slice(0, 3);
const contactIntent = config?.contactIntent ?? 'consult';
const contactLabel = config?.contactLabel ?? '発注前に相談する';
const heroVisualItems = config?.visualItems ?? config?.illustration?.stages ?? benefits;
---

<!-- ライト基調ヒーロー（2026-07-07 ユーザー指定）。
     ワーキングメモリ配慮: 左=バッジ/見出し/リード/CTAの4要素、右=ビジュアル1点のみ。
     旧: 紺背景+右パネル11要素（チップ・メトリクス・紺ボックス）は情報過多のため撤去 -->
<section class="relative overflow-hidden border-b border-neutral-300 bg-neutral-100 pt-14 pb-12 md:pt-24 md:pb-20">
  <div class="container relative mx-auto px-6 lg:px-12">
    <div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div>
        <span
          class="inline-flex items-center gap-2 border-l-8 border-primary-500 bg-white px-4 py-2 text-sm font-semibold text-primary-700"
        >
          {config?.eyebrow ?? 'Beekle のサービス'}
        </span>
        <h1
          class="mt-6 max-w-4xl text-balance text-3xl font-bold leading-tight text-navy-950 [word-break:keep-all] md:text-5xl lg:text-5xl"
        >
          {config?.headline ?? service.title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-neutral-600 md:text-xl">
          {config?.heroLead ?? service.description}
        </p>
        {
          config?.primaryOutcome && (
            <p class="mt-5 max-w-2xl border-l-4 border-primary-500 pl-4 text-base font-semibold leading-relaxed text-navy-950">
              {config.primaryOutcome}
            </p>
          )
        }
        {
          config?.metrics && (
            <div class="mt-6 grid max-w-2xl gap-3 sm:grid-cols-3">
              {config.metrics.map((metric) => (
                <div class="rounded-md border border-neutral-200 bg-neutral-50 px-4 py-3">
                  <p class="text-xs font-bold text-neutral-500">{metric.label}</p>
                  <p class="mt-1 text-base font-bold leading-snug text-navy-950">
                    {metric.value}
                  </p>
                </div>
              ))}
            </div>
          )
        }
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={`/contact?source=services-${service.id}-hero&intent=${contactIntent}`}
            data-cta-source={`services-${service.id}-hero`}
            data-cta-id="contact"
            class="inline-flex min-h-[52px] w-full items-center justify-center rounded-md bg-primary-500 px-6 py-3 text-center text-base font-bold leading-snug text-white transition hover:bg-primary-600 sm:w-auto sm:px-8"
          >
            {contactLabel}
            <svg class="ml-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
          {
            config?.showZeroStartLink !== false && (
              <a
                href="/prooffirst"
                class="inline-flex min-h-[44px] w-full items-center justify-center text-center text-sm font-bold leading-snug text-primary-700 transition hover:text-primary-600 sm:w-auto"
              >
                簡易デモとPoCの違いを見る
              </a>
            )
          }
          <AskAiButton
            client:visible
            source={`services-${service.id}-hero`}
            variant="link"
            pageTitle={config?.headline ?? service.title}
            pageSummary={config?.heroLead ?? service.description}
            serviceName={service.title}
          />
        </div>
      </div>

      <aside class="border-y border-neutral-300 bg-white">
        <div class="border-b border-neutral-300 border-l-8 border-primary-500 px-5 py-4">
          <p class="text-sm font-bold text-primary-700">
            {config?.visualTitle ?? '判断メモ'}
          </p>
          <p class="mt-1 text-2xl font-bold leading-tight text-navy-950">
            {config?.visualSubtitle ?? 'お客さま側の変化'}
          </p>
        </div>
        <div class="divide-y divide-neutral-300">
          {heroVisualItems.map((item, index) => (
            <div class="grid gap-3 px-5 py-4 md:grid-cols-[72px_1fr]">
              <p class="font-Poppins text-sm font-bold text-primary-600">
                {String(index + 1).padStart(2, '0')}
              </p>
              <p class="text-base font-bold leading-relaxed text-navy-950">{item}</p>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </div>
</section>
