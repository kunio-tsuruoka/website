---
interface Props {
  serviceId: string;
}

type ProcessItem = {
  label: string;
  title: string;
  description: string;
};

type DeliveryPackage = {
  promise: string;
  process: string;
  deliverables: string[];
  note?: string;
};

const { serviceId } = Astro.props;

const themes: Record<
  string,
  {
    label: string;
    title: string;
    center: string;
    inputs: string[];
    outputs: string[];
    caption: string;
    closing: { title: string; description: string };
    process?: ProcessItem[];
    deliveryPackage?: DeliveryPackage;
  }
> = {
  'ai-development': {
    label: 'AI IMPLEMENTATION PACKAGE',
    title: 'ヒアリングから、実装・テスト・導入までを一つにつなぐ',
    center: 'PM on Rails',
    inputs: ['業務ヒアリング', '現行資料', '判断基準', '例外・権限'],
    outputs: ['実装できる要件', '動くAI・業務システム', 'テスト結果', '運用ルール'],
    caption:
      '「AIコンサル」で提案書を渡して終わりにはしません。ヒアリング内容をPM on Railsで要求・ユーザーストーリー・受入条件・開発タスクへ構造化し、そのままAIエージェントで実装・テストし、現場導入まで進めます。',
    deliveryPackage: {
      promise:
        '対象業務を一つに絞り、AIを使う範囲・人が確認する範囲を決め、実際に現場で使える状態まで持っていきます。',
      process:
        '業務ヒアリング → 要件構造化 → 成功基準・受入条件 → プロトタイプ → AI実装・テスト → 導入・定着',
      deliverables: [
        'AI活用候補と優先順位',
        'As-Is / To-Be業務フロー',
        '要求・ユーザーストーリー・受入条件',
        '動くAI機能・業務システム',
        '評価データセット・テスト結果',
        '権限・人の確認条件・実行ログ設計',
        '操作・運用ルールと改善バックログ',
      ],
      note: '成果物は案件の対象業務に合わせて調整します。最初から全社導入を狙わず、効果を測れる一業務から始めます。',
    },
    process: [
      {
        label: '聞く',
        title: '業務ヒアリング',
        description: '現場の流れ・例外・判断・困りごとを整理する',
      },
      {
        label: '構造化',
        title: 'PM on Railsで要件化',
        description: '要求をユーザーストーリーと開発タスクへつなぐ',
      },
      {
        label: '基準化',
        title: '受入条件を決める',
        description: '何をもって「使える」とするかを先に定義する',
      },
      {
        label: '作る',
        title: 'AIで実装',
        description: '仕様をAIエージェントへつなぎ、動く形にする',
      },
      {
        label: '確かめる',
        title: 'テスト・実データ検証',
        description: '精度・削減時間・確認工数・例外を測る',
      },
      {
        label: '使う',
        title: '導入・定着',
        description: '権限・ログ・人の確認・運用ルールまで整える',
      },
    ],
    closing: {
      title: 'なぜ、コンサルで止まらず導入まで進められるのか',
      description:
        'ヒアリング結果を人が読むだけの議事録や提案書で終わらせず、PM on Rails上で要求→ユーザーストーリー→受入条件→開発タスクへ接続します。実装後のテスト結果や変更も同じ流れへ戻せるため、「コンサル会社が整理して、別の開発会社へ説明し直す」という分断がありません。業務理解から実装・検証・導入まで、同じ文脈のまま進められます。',
    },
  },
  'rag-system-development': {
    label: 'RAG / ONTOLOGY DESIGN',
    title: '文書を入れる前に、答えるべき問いを決める',
    center: 'オントロジー設計',
    inputs: ['業務質問', '社内用語', '文書関係', '評価基準'],
    outputs: ['根拠つき回答', '本番判断できる材料'],
    caption: 'ベクトル検索だけに頼らず、質問・用語・文書の関係と評価基準から設計します。',
    closing: {
      title: 'なぜ、投入する前に問いを決めるのか',
      description:
        '同じ文書群でも、何を聞かれるかによって必要な分割単位もメタデータも変わります。先に実際の業務質問を集めてから設計するので、入れてみたが目的の答えに届かない、という作り直しが起きません。評価用の質問セットもこの段階で揃うため、精度が上がったかどうかを毎回同じ物差しで確認できます。',
    },
  },
  'internal-document-ai-search': {
    label: 'RAG / ONTOLOGY DESIGN',
    title: '文書を入れる前に、答えるべき問いを決める',
    center: 'オントロジー設計',
    inputs: ['業務質問', '社内用語', '文書関係', '評価基準'],
    outputs: ['根拠つき回答', '本番判断できる材料'],
    caption: 'ベクトル検索だけに頼らず、質問・用語・文書の関係と評価基準から設計します。',
    closing: {
      title: 'なぜ、投入する前に問いを決めるのか',
      description:
        '同じ文書群でも、何を聞かれるかによって必要な分割単位もメタデータも変わります。先に実際の業務質問を集めてから設計するので、入れてみたが目的の答えに届かない、という作り直しが起きません。',
    },
  },
  'ai-agent-development': {
    label: 'AI AGENT DESIGN',
    title: '任せる範囲と、止め方を先に決める',
    center: 'エージェント設計',
    inputs: ['ユースケース', '権限', '承認', '例外処理'],
    outputs: ['安全な自動実行', '監査できるログ'],
    caption: 'できることを増やす前に、禁止操作・人へ戻す条件・ログを設計します。',
    closing: {
      title: 'なぜ、できることより先に止め方を決めるのか',
      description:
        '自律的に動くAIは、便利さと事故のリスクが同じ設計から生まれます。実行してよい操作、承認が要る操作、失敗したときの戻し方を先に決めるので、任せる範囲を段階的に広げても、取り返しのつかない操作が起きません。',
    },
  },
  'ai-chatbot-development': {
    label: 'ANSWER SCOPE DESIGN',
    title: 'AIが答える範囲と、人へ戻す条件を先に決める',
    center: '回答範囲の設計',
    inputs: ['よくある質問', '回答の根拠', '戻す条件', '会話ログ'],
    outputs: ['一次対応の自動化', '人が対応すべき問い合わせ'],
    caption: '答えられる質問と答えてはいけない質問を切り分けてから、会話と引き継ぎを設計します。',
    closing: {
      title: 'なぜ、答える範囲を先に決めるのか',
      description:
        '広く答えさせるほど、根拠のない回答が混ざって信用を落とします。根拠を持って答えられる範囲だけをAIに任せ、それ以外は会話の要約とともに人へ渡す設計にするので、利用者が最初から人を呼ぶ状態に戻りません。答えられなかった質問はログに残し、対応できる範囲を運用しながら広げます。',
    },
  },
  'ocr-ai-development': {
    label: 'REVIEW FLOW DESIGN',
    title: '読み取った後、どこを人が見るかを先に決める',
    center: '確認導線の設計',
    inputs: ['帳票の種類', '必要項目', '確信度の基準', '連携先'],
    outputs: ['例外だけの確認作業', 'そのまま渡せるデータ'],
    caption: '読み取り精度だけでなく、確信度の低い項目をどう人へ戻すかまで設計します。',
    closing: {
      title: 'なぜ、精度より確認導線を先に決めるのか',
      description:
        '読み取り精度を100%にすることはできません。だからこそ、どの項目がどれだけ確からしければ通してよいか、迷ったものを誰がどの画面で直すかを先に決めます。全件確認を前提にしない運用になるので、精度が完璧でなくても入力作業そのものが減ります。',
    },
  },
};

const defaultTheme = {
  label: 'AI USE CASE DESIGN',
  title: 'AIで効く業務を、要件と評価基準で見極める',
  center: 'ユースケース設計',
  inputs: ['業務フロー', '判断基準', '例外処理', '評価基準'],
  outputs: ['動く試作品', '社内説明できる材料'],
  caption: 'モデル選定より先に、どの業務をどう変え、何をもって使えると判断するかを確定します。',
  closing: {
    title: 'なぜ、作る前に決めるのか',
    description:
      'AI開発が止まるのは、モデルの選び間違いだけが理由ではありません。どの業務のどの手間を減らすか、何をもって使えると判断するかを先に決めておくと、動いたけれど本番に進めない、という止まり方を避けられます。決めた基準は、そのまま社内説明の材料になります。',
  },
};

const defaultProcess: ProcessItem[] = [
  {
    label: '聞く',
    title: '徹底ヒアリング',
    description: '背景・業務・例外を聞き出す',
  },
  {
    label: '絞る',
    title: 'ユースケース確定',
    description: '効果が出る範囲に絞る',
  },
  {
    label: '描く',
    title: '設計図に落とす',
    description: '構造・権限・評価基準を決める',
  },
];

const theme = themes[serviceId] ?? defaultTheme;
const process = 'process' in theme && theme.process ? theme.process : defaultProcess;
const deliveryPackage = 'deliveryPackage' in theme ? theme.deliveryPackage : undefined;
const processGridClass = process.length >= 6 ? 'md:grid-cols-3 lg:grid-cols-6' : 'md:grid-cols-3';
---

<section class="relative overflow-hidden bg-accent-950 py-16 md:py-20">
  <div class="container relative mx-auto px-6 lg:px-12">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-center">
        <div>
          <span class="inline-flex rounded-md border border-white/15 bg-white/10 px-4 py-2 text-sm font-bold text-white">
            どういう仕組みで実現するか
          </span>
          <p class="mt-5 text-sm font-bold tracking-wide text-primary-200">{theme.label}</p>
          <h2 class="mt-3 text-3xl font-bold leading-tight text-white md:text-4xl">
            {theme.title}
          </h2>
          <p class="mt-4 text-base leading-relaxed text-white/80">
            {theme.caption}
          </p>
        </div>

        <div class="rounded-lg border border-white/20 bg-white p-4 md:p-6">
          <div class="grid gap-4 md:grid-cols-[1fr_auto_1fr] md:items-center">
            <div>
              <p class="mb-2 text-xs font-bold tracking-wide text-neutral-500">INPUT</p>
              <div class="grid grid-cols-2 gap-2">
                {theme.inputs.map((item) => (
                  <div class="rounded-md border border-neutral-200 bg-neutral-50 px-3 py-3 text-center text-sm font-bold text-navy-950">
                    {item}
                  </div>
                ))}
              </div>
            </div>

            <div class="flex flex-col items-center justify-center">
              <p class="mb-2 text-xs font-bold tracking-wide text-neutral-500">CONNECT</p>
              <div class="flex items-center justify-center gap-2">
                <span
                  class="hidden shrink-0 text-3xl leading-none text-primary-300 md:block"
                  aria-hidden="true"
                >
                  →
                </span>
                <div class="flex h-32 w-32 shrink-0 items-center justify-center rounded-full bg-primary-500 px-3 text-center text-base font-bold leading-snug text-white">
                  {theme.center}
                </div>
                <span
                  class="hidden shrink-0 text-3xl leading-none text-primary-300 md:block"
                  aria-hidden="true"
                >
                  →
                </span>
              </div>
            </div>

            <div>
              <p class="mb-2 text-xs font-bold tracking-wide text-neutral-500">DELIVERABLES</p>
              <div class="grid gap-2">
                {theme.outputs.map((item) => (
                  <div class="flex min-h-14 items-center gap-3 rounded-lg border border-primary-100 bg-primary-50 px-4 py-3 text-sm font-bold text-navy-950">
                    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-secondary-500 text-accent-950">
                      ✓
                    </span>
                    <span>{item}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      {deliveryPackage && (
        <div class="mt-8 rounded-lg border border-white/15 bg-white/10 p-5 md:p-7">
          <div class="max-w-3xl">
            <p class="text-sm font-bold tracking-wide text-primary-200">約束 × 工程 × 成果物</p>
            <h3 class="mt-2 text-2xl font-bold text-white md:text-3xl">
              「何をしてくれる会社か」を、最初から明確にします
            </h3>
          </div>
          <div class="mt-6 grid gap-4 lg:grid-cols-3">
            <article class="rounded-lg border border-white/10 bg-white p-5">
              <p class="text-xs font-bold tracking-wide text-primary-500">PROMISE / 約束</p>
              <p class="mt-3 text-sm font-semibold leading-relaxed text-navy-950 md:text-base">
                {deliveryPackage.promise}
              </p>
            </article>
            <article class="rounded-lg border border-white/10 bg-white p-5">
              <p class="text-xs font-bold tracking-wide text-primary-500">PROCESS / 工程</p>
              <p class="mt-3 text-sm font-semibold leading-relaxed text-navy-950 md:text-base">
                {deliveryPackage.process}
              </p>
            </article>
            <article class="rounded-lg border border-white/10 bg-white p-5">
              <p class="text-xs font-bold tracking-wide text-primary-500">DELIVERABLES / 成果物</p>
              <ul class="mt-3 space-y-2">
                {deliveryPackage.deliverables.map((item) => (
                  <li class="flex gap-2 text-sm leading-relaxed text-neutral-700">
                    <span class="mt-0.5 font-bold text-secondary-500">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>
          </div>
          {deliveryPackage.note && (
            <p class="mt-4 text-sm leading-relaxed text-white/70">{deliveryPackage.note}</p>
          )}
        </div>
      )}

      <div class:list={['mt-8 grid gap-3', processGridClass]}>
        {process.map((item, index) => (
          <article class="rounded-lg border border-white/15 bg-white/10 p-5 text-white">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white font-Poppins text-sm font-bold text-primary-500">
                {index + 1}
              </span>
              <p class="text-sm font-bold text-primary-200">{item.label}</p>
            </div>
            <h3 class="mt-4 text-xl font-bold">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/75">{item.description}</p>
          </article>
        ))}
      </div>

      <div class="mt-6 rounded-lg border border-white/15 bg-white/10 p-5 text-white md:p-6">
        <h3 class="text-xl font-bold">{theme.closing.title}</h3>
        <p class="mt-3 text-sm leading-relaxed text-white/78 md:text-base">
          {theme.closing.description}
        </p>
      </div>
    </div>
  </div>
</section>
