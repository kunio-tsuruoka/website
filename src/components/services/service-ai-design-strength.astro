---
interface Props {
  serviceId: string;
}

const { serviceId } = Astro.props;

const themes: Record<
  string,
  {
    label: string;
    title: string;
    center: string;
    inputs: string[];
    outputs: string[];
    caption: string;
    closing: { title: string; description: string };
  }
> = {
  'rag-system-development': {
    label: 'RAG / ONTOLOGY DESIGN',
    title: '文書を入れる前に、答えるべき問いを決める',
    center: 'オントロジー設計',
    inputs: ['業務質問', '社内用語', '文書関係', '評価基準'],
    outputs: ['根拠つき回答', '本番判断できる材料'],
    caption: 'ベクトル検索だけに頼らず、質問・用語・文書の関係と評価基準から設計します。',
    closing: {
      title: 'なぜ、投入する前に問いを決めるのか',
      description:
        '同じ文書群でも、何を聞かれるかによって必要な分割単位もメタデータも変わります。先に実際の業務質問を集めてから設計するので、入れてみたが目的の答えに届かない、という作り直しが起きません。評価用の質問セットもこの段階で揃うため、精度が上がったかどうかを毎回同じ物差しで確認できます。',
    },
  },
  'internal-document-ai-search': {
    label: 'RAG / ONTOLOGY DESIGN',
    title: '文書を入れる前に、答えるべき問いを決める',
    center: 'オントロジー設計',
    inputs: ['業務質問', '社内用語', '文書関係', '評価基準'],
    outputs: ['根拠つき回答', '本番判断できる材料'],
    caption: 'ベクトル検索だけに頼らず、質問・用語・文書の関係と評価基準から設計します。',
    closing: {
      title: 'なぜ、投入する前に問いを決めるのか',
      description:
        '同じ文書群でも、何を聞かれるかによって必要な分割単位もメタデータも変わります。先に実際の業務質問を集めてから設計するので、入れてみたが目的の答えに届かない、という作り直しが起きません。',
    },
  },
  'ai-agent-development': {
    label: 'AI AGENT DESIGN',
    title: '任せる範囲と、止め方を先に決める',
    center: 'エージェント設計',
    inputs: ['ユースケース', '権限', '承認', '例外処理'],
    outputs: ['安全な自動実行', '監査できるログ'],
    caption: 'できることを増やす前に、禁止操作・人へ戻す条件・ログを設計します。',
    closing: {
      title: 'なぜ、できることより先に止め方を決めるのか',
      description:
        '自律的に動くAIは、便利さと事故のリスクが同じ設計から生まれます。実行してよい操作、承認が要る操作、失敗したときの戻し方を先に決めるので、任せる範囲を段階的に広げても、取り返しのつかない操作が起きません。',
    },
  },
  'ai-chatbot-development': {
    label: 'ANSWER SCOPE DESIGN',
    title: 'AIが答える範囲と、人へ戻す条件を先に決める',
    center: '回答範囲の設計',
    inputs: ['よくある質問', '回答の根拠', '戻す条件', '会話ログ'],
    outputs: ['一次対応の自動化', '人が対応すべき問い合わせ'],
    caption: '答えられる質問と答えてはいけない質問を切り分けてから、会話と引き継ぎを設計します。',
    closing: {
      title: 'なぜ、答える範囲を先に決めるのか',
      description:
        '広く答えさせるほど、根拠のない回答が混ざって信用を落とします。根拠を持って答えられる範囲だけをAIに任せ、それ以外は会話の要約とともに人へ渡す設計にするので、利用者が最初から人を呼ぶ状態に戻りません。答えられなかった質問はログに残し、対応できる範囲を運用しながら広げます。',
    },
  },
  'ocr-ai-development': {
    label: 'REVIEW FLOW DESIGN',
    title: '読み取った後、どこを人が見るかを先に決める',
    center: '確認導線の設計',
    inputs: ['帳票の種類', '必要項目', '確信度の基準', '連携先'],
    outputs: ['例外だけの確認作業', 'そのまま渡せるデータ'],
    caption: '読み取り精度だけでなく、確信度の低い項目をどう人へ戻すかまで設計します。',
    closing: {
      title: 'なぜ、精度より確認導線を先に決めるのか',
      description:
        '読み取り精度を100%にすることはできません。だからこそ、どの項目がどれだけ確からしければ通してよいか、迷ったものを誰がどの画面で直すかを先に決めます。全件確認を前提にしない運用になるので、精度が完璧でなくても入力作業そのものが減ります。',
    },
  },
};

const defaultTheme = {
  label: 'AI USE CASE DESIGN',
  title: 'AIで効く業務を、要件と評価基準で見極める',
  center: 'ユースケース設計',
  inputs: ['業務フロー', '判断基準', '例外処理', '評価基準'],
  outputs: ['動く試作品', '社内説明できる材料'],
  caption: 'モデル選定より先に、どの業務をどう変え、何をもって使えると判断するかを確定します。',
  closing: {
    title: 'なぜ、作る前に決めるのか',
    description:
      'AI開発が止まるのは、モデルの選び間違いだけが理由ではありません。どの業務のどの手間を減らすか、何をもって使えると判断するかを先に決めておくと、動いたけれど本番に進めない、という止まり方を避けられます。決めた基準は、そのまま社内説明の材料になります。',
  },
};

const theme = themes[serviceId] ?? defaultTheme;

const process = [
  {
    label: '聞く',
    title: '徹底ヒアリング',
    description: '背景・業務・例外を聞き出す',
  },
  {
    label: '絞る',
    title: 'ユースケース確定',
    description: '効果が出る範囲に絞る',
  },
  {
    label: '描く',
    title: '設計図に落とす',
    description: '構造・権限・評価基準を決める',
  },
];
---

<section class="relative overflow-hidden bg-accent-950 py-16 md:py-20">
  <div
    class="absolute -right-20 top-10 h-72 w-72 rounded-full bg-primary-500/20 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute -left-20 bottom-8 h-64 w-64 rounded-full bg-secondary-500/15 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="container relative mx-auto px-6 lg:px-12">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-center">
        <div>
          <span class="inline-flex rounded-full bg-white/10 px-4 py-2 text-sm font-bold text-white">
            どういう仕組みで実現するか
          </span>
          <p class="mt-5 text-sm font-bold tracking-wide text-primary-200">{theme.label}</p>
          <h2 class="mt-3 text-3xl font-bold leading-tight text-white md:text-4xl">
            {theme.title}
          </h2>
          <p class="mt-4 text-base leading-relaxed text-white/80">
            {theme.caption}
          </p>
        </div>

        <div class="rounded-3xl bg-white p-4 shadow-strong md:p-6">
          <div class="grid gap-4 md:grid-cols-[1fr_auto_1fr] md:items-center">
            <div class="grid grid-cols-2 gap-2">
              {theme.inputs.map((item) => (
                <div class="rounded-2xl bg-neutral-50 px-3 py-3 text-center text-sm font-bold text-navy-950">
                  {item}
                </div>
              ))}
            </div>

            <div class="flex items-center justify-center">
              <div class="relative flex h-32 w-32 items-center justify-center rounded-full bg-primary-500 text-center text-base font-bold leading-snug text-white shadow-medium">
                {theme.center}
                <span class="absolute -left-3 top-1/2 hidden -translate-y-1/2 text-3xl text-primary-300 md:block">
                  →
                </span>
                <span class="absolute -right-3 top-1/2 hidden -translate-y-1/2 text-3xl text-primary-300 md:block">
                  →
                </span>
              </div>
            </div>

            <div class="grid gap-2">
              {theme.outputs.map((item) => (
                <div class="flex min-h-14 items-center gap-3 rounded-2xl bg-primary-50 px-4 py-3 text-sm font-bold text-navy-950">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-secondary-500 text-accent-950">
                    ✓
                  </span>
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="mt-8 grid gap-3 md:grid-cols-3">
        {process.map((item, index) => (
          <article class="rounded-3xl bg-white/10 p-5 text-white">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white font-Poppins text-sm font-bold text-primary-500">
                {index + 1}
              </span>
              <p class="text-sm font-bold text-primary-200">{item.label}</p>
            </div>
            <h3 class="mt-4 text-xl font-bold">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/75">{item.description}</p>
          </article>
        ))}
      </div>

      <div class="mt-6 rounded-3xl border border-white/15 bg-white/10 p-5 text-white md:p-6">
        <h3 class="text-xl font-bold">{theme.closing.title}</h3>
        <p class="mt-3 text-sm leading-relaxed text-white/78 md:text-base">
          {theme.closing.description}
        </p>
      </div>
    </div>
  </div>
</section>
