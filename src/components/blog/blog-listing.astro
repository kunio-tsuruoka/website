---
import type { Blog, BlogTag } from '../../lib/microcms';

type PageItem = number | 'ellipsis';

interface Props {
  blogs: Blog[];
  apiError?: boolean;
  currentPage: number;
  totalPages: number;
  totalCount: number;
  pageSize: number;
}

const { blogs, apiError = false, currentPage, totalPages, totalCount, pageSize } = Astro.props;

const hasPrevPage = currentPage > 1;
const hasNextPage = currentPage < totalPages;
const startNumber = totalCount === 0 ? 0 : (currentPage - 1) * pageSize + 1;
const endNumber = Math.min(currentPage * pageSize, totalCount);
const pageItems = visiblePageItems(currentPage, totalPages);

function pageHref(page: number): string {
  return page <= 1 ? '/blog' : `/blog/page/${page}`;
}

function visiblePageItems(current: number, total: number): PageItem[] {
  if (total <= 7) return Array.from({ length: total }, (_, index) => index + 1);

  const pages = new Set([1, total, current - 1, current, current + 1]);
  if (current <= 4) {
    pages.add(2);
    pages.add(3);
    pages.add(4);
    pages.add(5);
  }
  if (current >= total - 3) {
    pages.add(total - 1);
    pages.add(total - 2);
    pages.add(total - 3);
    pages.add(total - 4);
  }

  const sorted = [...pages].filter((page) => page >= 1 && page <= total).sort((a, b) => a - b);
  const items: PageItem[] = [];
  sorted.forEach((page, index) => {
    const previous = sorted[index - 1];
    if (previous && page - previous > 1) items.push('ellipsis');
    items.push(page);
  });
  return items;
}

function formatJaDate(...values: (string | undefined)[]): string {
  for (const value of values) {
    if (!value) continue;
    const date = new Date(value);
    if (!Number.isNaN(date.getTime())) return date.toLocaleDateString('ja-JP');
  }
  return '';
}

function stripContent(value?: string): string {
  if (!value) return '';
  return value
    .replace(/<[^>]*>/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[#*_`>]+/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

function getBlogBody(blog: Blog): string {
  return blog.content || blog.body || '';
}

function getExcerpt(blog: Blog): string {
  const text = blog.description || stripContent(getBlogBody(blog));
  return text.length > 120 ? `${text.slice(0, 120)}...` : text;
}

function getImageUrl(blog: Blog): string | undefined {
  return blog.eyecatch?.url || blog.thumbnail?.url || blog.cover?.url || blog.image?.url;
}

function normalizeTags(tags: Blog['tags']): string[] {
  if (!tags) return [];
  if (typeof tags === 'string') {
    return tags
      .split(/[,、]/)
      .map((tag) => tag.trim())
      .filter(Boolean);
  }
  return tags
    .map((tag: BlogTag) => (typeof tag === 'string' ? tag : tag.title || tag.name || tag.id || ''))
    .map((tag) => tag.trim())
    .filter(Boolean);
}
---

<div class="container mx-auto max-w-4xl px-6 md:px-8">
  {
    apiError && (
      <div class="mb-8 rounded-xl bg-gray-50 p-8 text-center">
        <p class="text-gray-600">現在ブログを読み込めません。しばらくしてから再度お試しください。</p>
      </div>
    )
  }

  {
    blogs.length > 0 ? (
      <>
        <div class="divide-y divide-gray-200">
          {blogs.map((blog) => {
            const imageUrl = getImageUrl(blog);
            const tags = normalizeTags(blog.tags).slice(0, 4);
            return (
              <a
                href={`/blog/${blog.id}`}
                class="group grid gap-6 py-8 first:pt-0 last:pb-0 md:grid-cols-[220px_1fr] md:items-start"
              >
                <div class="aspect-[16/9] overflow-hidden rounded-lg bg-gray-100 md:aspect-[4/3]">
                  {imageUrl ? (
                    <img
                      src={imageUrl}
                      alt=""
                      loading="lazy"
                      class="h-full w-full object-cover"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-neutral-100">
                      <span class="font-Poppins text-sm font-bold tracking-wide text-primary-500">BLOG</span>
                    </div>
                  )}
                </div>
                <div>
                  <time class="text-sm text-gray-500">
                    {formatJaDate(blog.publishedAt, blog.updatedAt)}
                  </time>
                  <h2 class="mt-2 text-2xl font-bold leading-tight text-gray-900 transition-colors group-hover:text-primary-500">
                    {blog.title}
                  </h2>
                  {getExcerpt(blog) && (
                    <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-gray-600">
                      {getExcerpt(blog)}
                    </p>
                  )}
                  {tags.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-2">
                      {tags.map((tag) => (
                        <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                  <div class="mt-5 inline-flex items-center text-sm font-semibold text-primary-500 transition-transform group-hover:translate-x-1">
                    <span>読む</span>
                    <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                </div>
              </a>
            );
          })}
        </div>

        {totalPages > 1 && (
          <nav class="mt-14 flex flex-wrap items-center justify-center gap-2" aria-label="ブログ一覧ページ">
            {hasPrevPage ? (
              <a
                href={pageHref(currentPage - 1)}
                class="inline-flex min-h-10 items-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50"
              >
                <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                前へ
              </a>
            ) : (
              <span class="inline-flex min-h-10 items-center rounded-lg border border-gray-200 bg-gray-100 px-4 py-2 text-sm font-medium text-gray-400">
                <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                前へ
              </span>
            )}

            <div class="flex flex-wrap items-center justify-center gap-2">
              {pageItems.map((item) =>
                item === 'ellipsis' ? (
                  <span class="flex h-10 w-10 items-center justify-center text-sm text-gray-400">...</span>
                ) : (
                  <a
                    href={pageHref(item)}
                    aria-current={item === currentPage ? 'page' : undefined}
                    class:list={[
                      'flex h-10 w-10 items-center justify-center rounded-lg text-sm font-medium transition-colors',
                      item === currentPage
                        ? 'bg-primary-500 text-white'
                        : 'border border-gray-300 bg-white text-gray-700 hover:bg-gray-50',
                    ]}
                  >
                    {item}
                  </a>
                )
              )}
            </div>

            {hasNextPage ? (
              <a
                href={pageHref(currentPage + 1)}
                class="inline-flex min-h-10 items-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50"
              >
                次へ
                <svg class="ml-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            ) : (
              <span class="inline-flex min-h-10 items-center rounded-lg border border-gray-200 bg-gray-100 px-4 py-2 text-sm font-medium text-gray-400">
                次へ
                <svg class="ml-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            )}
          </nav>
        )}

        <p class="mt-8 text-center text-sm text-gray-500">
          全{totalCount}件中 {startNumber}〜{endNumber}件を表示
        </p>
      </>
    ) : (
      !apiError && (
        <div class="rounded-xl bg-gray-50 p-12 text-center">
          <p class="text-gray-500">ブログ記事はまだありません。</p>
        </div>
      )
    )
  }
</div>
