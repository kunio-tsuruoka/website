---
import { buildSocialShareLinks } from '../../lib/social-share.mjs';

interface Props {
  title: string;
  url: string;
  placement?: 'header' | 'footer';
}

const { title, url, placement = 'header' } = Astro.props;
const links = buildSocialShareLinks({ title, url });
const heading =
  placement === 'footer' ? 'この記事が役に立ったら共有してください' : 'この記事を共有';
---

<section
  class:list={[
    'blog-social-share',
    placement === 'footer'
      ? 'mt-12 rounded-lg border border-neutral-200 bg-neutral-100 p-5 md:p-6'
      : 'mt-6 border-t border-neutral-200 pt-5',
  ]}
  data-blog-share
  data-share-placement={placement}
  aria-label="記事の共有"
>
  <p class="text-sm font-bold text-gray-700">{heading}</p>
  <div class="mt-3 flex flex-wrap gap-2">
    <a
      href={links.x}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-[44px] items-center gap-2 rounded-full border border-neutral-300 bg-white px-4 text-sm font-semibold text-gray-800 transition-colors hover:border-gray-500 hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
      data-share-platform="x"
      aria-label="Xでこの記事を共有"
    >
      <span aria-hidden="true" class="text-base font-bold">𝕏</span>
      <span>X</span>
    </a>
    <a
      href={links.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-[44px] items-center gap-2 rounded-full border border-neutral-300 bg-white px-4 text-sm font-semibold text-gray-800 transition-colors hover:border-gray-500 hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
      data-share-platform="linkedin"
      aria-label="LinkedInでこの記事を共有"
    >
      <span
        aria-hidden="true"
        class="inline-flex h-5 w-5 items-center justify-center rounded-sm bg-gray-800 text-[11px] font-bold leading-none text-white"
      >
        in
      </span>
      <span>LinkedIn</span>
    </a>
    <a
      href={links.facebook}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-[44px] items-center gap-2 rounded-full border border-neutral-300 bg-white px-4 text-sm font-semibold text-gray-800 transition-colors hover:border-gray-500 hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
      data-share-platform="facebook"
      aria-label="Facebookでこの記事を共有"
    >
      <span
        aria-hidden="true"
        class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-gray-800 text-xs font-bold leading-none text-white"
      >
        f
      </span>
      <span>Facebook</span>
    </a>
    <button
      type="button"
      class="inline-flex min-h-[44px] items-center gap-2 rounded-full border border-neutral-300 bg-white px-4 text-sm font-semibold text-gray-800 transition-colors hover:border-gray-500 hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
      data-share-copy
      data-share-url={url}
      aria-label="この記事のURLをコピー"
    >
      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
      </svg>
      <span data-share-copy-label>URLをコピー</span>
    </button>
  </div>
  <p class="sr-only" data-share-status aria-live="polite"></p>
</section>

<script>
  type GtagWindow = Window & {
    gtag?: (...args: unknown[]) => void;
  };

  async function copyText(value: string): Promise<void> {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(value);
      return;
    }

    const textarea = document.createElement('textarea');
    textarea.value = value;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();

    const copied = document.execCommand('copy');
    textarea.remove();
    if (!copied) throw new Error('URL copy failed');
  }

  function trackShare(platform: string, placement: string): void {
    (window as GtagWindow).gtag?.('event', 'share', {
      method: platform,
      content_type: 'blog',
      item_id: window.location.pathname,
      placement,
    });
  }

  function initBlogShareButtons(): void {
    document.querySelectorAll<HTMLElement>('[data-blog-share]').forEach((root) => {
      if (root.dataset.shareReady === 'true') return;
      root.dataset.shareReady = 'true';

      const placement = root.dataset.sharePlacement ?? 'unknown';
      root.querySelectorAll<HTMLAnchorElement>('[data-share-platform]').forEach((link) => {
        link.addEventListener('click', () => {
          trackShare(link.dataset.sharePlatform ?? 'unknown', placement);
        });
      });

      const copyButton = root.querySelector<HTMLButtonElement>('[data-share-copy]');
      const label = root.querySelector<HTMLElement>('[data-share-copy-label]');
      const status = root.querySelector<HTMLElement>('[data-share-status]');
      if (!copyButton || !label || !status) return;

      copyButton.addEventListener('click', async () => {
        const shareUrl = copyButton.dataset.shareUrl;
        if (!shareUrl) return;

        try {
          await copyText(shareUrl);
          label.textContent = 'コピーしました';
          status.textContent = '記事のURLをコピーしました。';
          trackShare('copy', placement);
        } catch {
          label.textContent = 'コピーできませんでした';
          status.textContent = '記事のURLをコピーできませんでした。';
        }

        window.setTimeout(() => {
          label.textContent = 'URLをコピー';
          status.textContent = '';
        }, 2400);
      });
    });
  }

  initBlogShareButtons();
  document.addEventListener('astro:page-load', initBlogShareButtons);
</script>
