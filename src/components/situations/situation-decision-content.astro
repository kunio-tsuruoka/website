---
import ServiceCaseStudies from '@/components/services/service-case-studies.astro';
import type { ConsultationSituation } from '@/data/consultation-situations';
import type { SituationLpContent } from '@/data/situation-lp-content';
import type { ServiceDetail } from '@/types/service';

interface Props {
  content: SituationLpContent;
  caseStudies: ServiceDetail['caseStudies'];
  proof: ConsultationSituation['proof'];
  rtbItems: ConsultationSituation['rtbItems'];
}

const { content, caseStudies, proof, rtbItems } = Astro.props;
---

<section class="border-y border-neutral-300 bg-white py-14 md:py-20">
  <div class="container mx-auto px-8 lg:px-12">
    <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
      <div>
        <p class="section-label">02 CAPABILITIES</p>
        <h2 class="mt-3 text-3xl font-bold leading-tight text-navy-950 md:text-4xl">
          具体的にできること
        </h2>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-neutral-700">
          {content.capabilitiesLead}
        </p>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {content.capabilities.map((capability, index) => (
          <article class="border-t-4 border-primary-500 bg-neutral-50 p-6">
            <p class="font-Poppins text-sm font-bold text-primary-600">
              {String(index + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-3 text-xl font-bold leading-snug text-navy-950">
              {capability.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-700 md:text-base">
              {capability.description}
            </p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<ServiceCaseStudies
  caseStudies={caseStudies}
  number="03"
  title="似た相談の実例"
  subtitle="課題、実装、成果、Beekleだからできたことまで確認できます"
/>

<section class="border-y border-neutral-300 bg-neutral-50 py-14 md:py-20">
  <div class="container mx-auto px-8 lg:px-12">
    <div class="border-b border-neutral-300 pb-7">
      <p class="section-label">04 WHY BEEKLE</p>
      <h2 class="mt-3 text-3xl font-bold leading-tight text-navy-950 md:text-4xl">
        この場面でBeekleが強い理由
      </h2>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-neutral-700">
        {content.strengthsLead}
      </p>
    </div>

    <div class="mt-8 grid gap-5 lg:grid-cols-3">
      {content.strengths.map((strength, index) => (
        <article class="h-full border-l-4 border-primary-500 bg-white p-6">
          <p class="font-Poppins text-sm font-bold text-primary-600">
            {String(index + 1).padStart(2, '0')}
          </p>
          <h3 class="mt-3 text-xl font-bold leading-snug text-navy-950">{strength.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-neutral-700 md:text-base">
            {strength.description}
          </p>
        </article>
      ))}
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
      <article class="border-y border-neutral-300 bg-white p-6 md:p-8">
        <p class="text-sm font-bold text-primary-700">{proof.label}</p>
        <h3 class="mt-3 text-2xl font-bold leading-snug text-navy-950">{proof.title}</h3>
        <p class="mt-4 leading-relaxed text-neutral-700">{proof.description}</p>
        <ul class="mt-5 space-y-3">
          {proof.points.map((point) => (
            <li class="border-t border-neutral-200 pt-3 text-sm font-bold leading-relaxed text-accent-950">
              {point}
            </li>
          ))}
        </ul>
      </article>

      <div class="border-y border-neutral-300 bg-white">
        {rtbItems.map((item) => (
          <div class="border-b border-neutral-300 px-5 py-5 last:border-b-0">
            <p class="text-sm font-bold text-primary-700">{item.label}</p>
            <h3 class="mt-2 text-xl font-bold leading-snug text-accent-950">{item.value}</h3>
            <p class="mt-2 text-sm leading-relaxed text-neutral-700">{item.description}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {content.deepDiveLinks.map((link) => (
        <a href={link.href} class="group block border border-neutral-300 bg-white p-5 transition-colors hover:border-primary-400">
          <p class="text-lg font-bold text-navy-950 group-hover:text-primary-600">{link.label}</p>
          <p class="mt-2 text-sm leading-relaxed text-neutral-700">{link.description}</p>
          <p class="mt-4 text-sm font-bold text-primary-600">詳しく見る</p>
        </a>
      ))}
    </div>
  </div>
</section>
